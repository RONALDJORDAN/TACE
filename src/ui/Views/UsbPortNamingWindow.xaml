<Window x:Class="TACEUI.Views.UsbPortNamingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nomear Portas USB" Height="430" Width="560"
        Background="#0B0B13" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" ResizeMode="NoResize" WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="NOMEAR PORTAS USB" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="O nome fica salvo para a porta fisica. Se trocar o tablet de porta, o nome continua acompanhando a porta."
                       Foreground="#85859E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,14"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#0A0A0F" BorderBrush="#202035" BorderThickness="1" CornerRadius="8" Padding="10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PORTA FISICA" Foreground="#8570E6" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="NOME (EX.: MESA 1)" Foreground="#8570E6" FontSize="10" FontWeight="Bold"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ListPortas">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141425" BorderBrush="#25253D" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PortaExibicao}" Foreground="#C9A7FF" FontFamily="Consolas" FontSize="12" FontWeight="Bold" ToolTip="{Binding Porta}"/>
                                            <TextBlock Text="{Binding Detalhe}" Foreground="#6A6A8E" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detalhe}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#0A0A0F" Foreground="#FFB703" BorderBrush="#2A2A40"
                                                 FontSize="12" Padding="8,5" MaxLength="32"
                                                 ToolTip="Ex.: Mesa 1, Balcao, Caixa 2. Deixe vazio para remover o nome."/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Deixe o campo vazio para remover o nome da porta." Foreground="#5A5A72" FontSize="10" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Background="#0A0A0F" Foreground="#E3E0F2" FontWeight="Bold"
                        BorderThickness="1" BorderBrush="#2A2A40" Padding="18,7" Cursor="Hand" Click="BtnCancelar_Click"/>
                <Button Content="Salvar Nomes" Background="#4EDEA3" Foreground="#0B0B13" FontWeight="Bold"
                        BorderThickness="0" Padding="18,7" Cursor="Hand" Margin="8,0,0,0" Click="BtnSalvar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
