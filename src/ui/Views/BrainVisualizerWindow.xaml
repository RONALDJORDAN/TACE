<Window x:Class="TACEUI.Views.BrainVisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mapa 3D de Estratégias — BotLearn"
        WindowState="Maximized" WindowStyle="None"
        AllowsTransparency="False" Background="#0B0B13"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        MouseWheel="Window_MouseWheel">

    <Window.Resources>
        <!-- ESTILO FILTRO ALL (TODOS) -->
        <Style x:Key="CyberFilterAllStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#10101C"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A2E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1F6FEB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F6FEB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#58A6FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#58A6FF" BlurRadius="10" Opacity="0.6" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO FILTRO VISION 7 (V7) -->
        <Style x:Key="CyberFilterV7Style" TargetType="RadioButton">
            <Setter Property="Background" Value="#10101C"/>
            <Setter Property="Foreground" Value="#3FB950"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F2A1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3FB950"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F2A1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3FB950"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3FB950" BlurRadius="10" Opacity="0.7" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO FILTRO TABMULTI M7 -->
        <Style x:Key="CyberFilterM7Style" TargetType="RadioButton">
            <Setter Property="Background" Value="#10101C"/>
            <Setter Property="Foreground" Value="#D29922"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A210F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D29922"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D2A0A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D29922"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#D29922" BlurRadius="10" Opacity="0.7" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO FILTRO NOKIA T20 -->
        <Style x:Key="CyberFilterT20Style" TargetType="RadioButton">
            <Setter Property="Background" Value="#10101C"/>
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D1B2A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#58A6FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F6FEB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#58A6FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO FILTRO GERAL -->
        <Style x:Key="CyberFilterGeneralStyle" TargetType="RadioButton">

            <Setter Property="Background" Value="#10101C"/>
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D1B2A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#58A6FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F6FEB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#58A6FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#58A6FF" BlurRadius="10" Opacity="0.7" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO CHECKBOX TAGS CYBER -->
        <Style x:Key="CyberTagCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- BOTÃO MINI TAG CYBER -->
        <Style x:Key="MiniTagBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1F6FEB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="False">
        <!-- Canvas Interativo de Desenho e Navegação (Pan & Zoom) -->
        <Canvas x:Name="BrainCanvas" Background="Transparent" ClipToBounds="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                MouseLeftButtonDown="BrainCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="BrainCanvas_MouseLeftButtonUp"
                MouseMove="BrainCanvas_MouseMove">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CanvasScale" ScaleX="1.0" ScaleY="1.0"/>
                    <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>

        <!-- Header Flutuante Unificado Cyber Space (Sem Sobreposição) -->
        <StackPanel x:Name="TopHeaderPanel" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" MouseLeftButtonDown="TopHeaderPanel_MouseLeftButtonDown">
            <Border Padding="18,10" Background="#0D0D18" CornerRadius="12" BorderBrush="#1F6FEB" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect Color="#1F6FEB" BlurRadius="20" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Título e Subtítulo -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="BOTLEARN — MAPA 3D DE ESTRATÉGIAS" Foreground="#FFFFFF" FontWeight="Black" FontSize="14"/>
                        <TextBlock Text="Alvos, seletores e scores do motor adaptativo" Foreground="#58A6FF" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Divisor Vertical -->
                    <Rectangle Width="1" Height="26" Fill="#23233A" Margin="0,0,16,0"/>

                    <!-- HUD de Estatísticas Integrado -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Background="#0B0B13" CornerRadius="8" Padding="10,5" Margin="0,0,6,0" BorderBrush="#26303D" BorderThickness="1"
                                ToolTip="Alvos carregados no mapa, incluindo seeds e dados persistidos">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ALVOS:" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtTotalNodes" Text="0" Foreground="#E6EDF3" FontWeight="Black" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0B0B13" CornerRadius="8" Padding="10,5" Margin="0,0,6,0" BorderBrush="#26303D" BorderThickness="1"
                                ToolTip="Seletores carregados para os alvos visíveis">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SELETORES:" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtTotalStrategies" Text="0" Foreground="#3FB950" FontWeight="Black" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0B0B13" CornerRadius="8" Padding="10,5" Margin="0,0,6,0" BorderBrush="#26303D" BorderThickness="1"
                                ToolTip="Acertos e falhas registrados nas estratégias visíveis">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="EXECUÇÕES:" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtTotalRules" Text="0" Foreground="#C9D1D9" FontWeight="Black" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0B0B13" CornerRadius="8" Padding="10,5" Margin="0,0,6,0" BorderBrush="#26303D" BorderThickness="1"
                                ToolTip="Soma dos scores dos seletores visíveis">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SCORE TOTAL:" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtTotalParameters" Text="0" Foreground="#D29922" FontWeight="Black" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0B0B13" CornerRadius="8" Padding="10,5" Margin="0,0,6,0" BorderBrush="#26303D" BorderThickness="1"
                                ToolTip="Dispositivos Android conectados via USB e monitorados em tempo real">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DISPOSITIVOS:" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtActiveDevices" Text="0" Foreground="#3FB950" FontWeight="Black" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0B0B13" CornerRadius="8" Padding="10,5" BorderBrush="#26303D" BorderThickness="1"
                                ToolTip="Acertos divididos pelas execuções registradas; — quando não há registros">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PRECISÃO:" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtGlobalAccuracy" Text="—" Foreground="#58A6FF" FontWeight="Black" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Filtros por Perfil de Hardware -->
            <Border Margin="0,8,0,0" HorizontalAlignment="Center" Background="#0D0D18" CornerRadius="8" Padding="4" BorderBrush="#23233A" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="BtnFilterAll" Content="TODOS" Style="{StaticResource CyberFilterAllStyle}"
                                 IsChecked="True" Click="Filter_Click" Tag="ALL" ToolTip="Exibir todas as estratégias e nós"/>
                    <RadioButton x:Name="BtnFilterV7" Content="VISION 7 (V7)" Style="{StaticResource CyberFilterV7Style}"
                                 Click="Filter_Click" Tag="V7" ToolTip="Filtrar alvos do Positivo Tab Vision 7"/>
                    <RadioButton x:Name="BtnFilterM7" Content="TABMULTI M7" Style="{StaticResource CyberFilterM7Style}"
                                 Click="Filter_Click" Tag="M7" ToolTip="Filtrar alvos do Multilaser TabMulti M7"/>
                    <RadioButton x:Name="BtnFilterT20" Content="NOKIA T20" Style="{StaticResource CyberFilterT20Style}"
                                 Click="Filter_Click" Tag="T20" ToolTip="Filtrar alvos do Nokia T20"/>
                    <RadioButton x:Name="BtnFilterGeneral" Content="GERAL" Style="{StaticResource CyberFilterGeneralStyle}"
                                 Click="Filter_Click" Tag="F1" ToolTip="Filtrar alvos do motor padrão Multilaser"/>
                </StackPanel>
            </Border>

            <!-- Barra de Filtro de Tags 3D Interativa + Busca viva -->
            <Border Margin="0,8,0,0" HorizontalAlignment="Center" Background="#0D0D18" CornerRadius="10" BorderBrush="#23233A" BorderThickness="1" Padding="12,5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FILTRO DE ITENS:" Foreground="#8B98A7" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox x:Name="ChkTagCore" Content="Motor" IsChecked="True" Click="TagFilter_Click" Style="{StaticResource CyberTagCheckStyle}" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkTagTargets" Content="Alvos" IsChecked="True" Click="TagFilter_Click" Style="{StaticResource CyberTagCheckStyle}" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkTagCognitive" Content="Componentes" IsChecked="True" Click="TagFilter_Click" Style="{StaticResource CyberTagCheckStyle}" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkTagStrategies" Content="Seletores" IsChecked="False" Click="TagFilter_Click" Style="{StaticResource CyberTagCheckStyle}" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkTagMicro" Content="Conexões" IsChecked="False" Click="TagFilter_Click" Style="{StaticResource CyberTagCheckStyle}" Margin="0,0,12,0"/>
                    <Rectangle Width="1" Height="14" Fill="#23233A" Margin="0,0,10,0"/>
                    <Button x:Name="BtnToggleAllTags" Content="TUDO ON/OFF" Click="BtnToggleAllTags_Click" Style="{StaticResource MiniTagBtnStyle}"/>
                    <Rectangle Width="1" Height="14" Fill="#23233A" Margin="10,0,10,0"/>
                    <Grid Width="170" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#23233A" FontSize="11" VerticalAlignment="Center" Padding="6,3" TextChanged="SearchBox_TextChanged" ToolTip="Buscar por alvo ou seletor (ex: v7_, email, Entrar)"/>
                        <TextBlock x:Name="SearchWatermark" Text="Buscar alvo ou seletor..." Foreground="#6E7681" FontSize="10" VerticalAlignment="Center" Margin="7,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Legenda de Cores de Conexão (Canto Inferior Esquerdo) -->
        <Border x:Name="LegendPanel" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="30,0,0,30" Padding="15" Background="#0D0D18" CornerRadius="10" BorderBrush="#23233A" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="LEGENDA DE SCORE" Foreground="#8B98A7" FontWeight="Bold" FontSize="10" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="10" Height="10" Fill="#3FB950" Margin="0,0,8,0"/>
                    <TextBlock Text="Alta confiança (score &gt; 50)" Foreground="#E6EDF3" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="10" Height="10" Fill="#D29922" Margin="0,0,8,0"/>
                    <TextBlock Text="Em observação (score 1 a 50)" Foreground="#E6EDF3" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="10" Height="10" Fill="#8B98A7" Margin="0,0,8,0"/>
                    <TextBlock Text="Neutro (score 0)" Foreground="#E6EDF3" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#F85149" Margin="0,0,8,0"/>
                    <TextBlock Text="Score negativo" Foreground="#E6EDF3" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Dicas Visuais de Navegação de Rodapé (Centro Inferior) -->
        <Border x:Name="FooterTipsPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,25" Padding="16,7" Background="#0D0D18" CornerRadius="20" BorderBrush="#1F6FEB" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Scroll: Zoom | Arraste: Rotacionar mapa 3D (360°) | Clique: Inspecionar | H: Ocultar UI | ESC: Fechar" Foreground="#8B98A7" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Controles de NAVEGAÇÃO / ZOOM (Canto Inferior Direito) -->
        <Border x:Name="ZoomControlsPanel" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,30,30" Padding="8" Background="#0D0D18" CornerRadius="10" BorderBrush="#23233A" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Content="+" Width="32" Height="32" Background="#23233A" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnZoomIn_Click" ToolTip="Aumentar Zoom"/>
                <Button Content="-" Width="32" Height="32" Background="#23233A" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnZoomOut_Click" Margin="6,0,0,0" ToolTip="Reduzir Zoom"/>
                <Button Content="RESET" Height="32" Padding="10,0" Background="#1F6FEB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnResetZoom_Click" Margin="6,0,0,0" ToolTip="Resetar Posição e Zoom"/>
                <Button Content="HUD" Height="32" Padding="10,0" Background="#23233A" Foreground="#58A6FF" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnToggleUI_Click" Margin="6,0,0,0" ToolTip="Ocultar / Mostrar interface (Atalho: H)"/>
            </StackPanel>
        </Border>

        <!-- Botão Flutuante para Restaurar a UI quando Oculta -->
        <Button x:Name="BtnFloatingShowUI" Content="MOSTRAR INTERFACE (H)" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="30,30,0,0" Padding="14,8"
                Background="#0D0D18" Foreground="#58A6FF" FontWeight="Bold" FontSize="11" BorderBrush="#1F6FEB" BorderThickness="1.5" Cursor="Hand" Click="BtnToggleUI_Click" Visibility="Collapsed">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
            <Button.Effect>
                <DropShadowEffect Color="#1F6FEB" BlurRadius="15" Opacity="0.6"/>
            </Button.Effect>
        </Button>

        <!-- Card Holográfico Lateral de Inspeção de Nó (Detalhes) -->
        <Border x:Name="NodeInspectorPanel" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,90,30,0" Width="340"
                Background="#0D0D18" CornerRadius="14" BorderBrush="#1F6FEB" BorderThickness="1.5" Padding="18" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="25" Opacity="0.8"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid>
                        <TextBlock Text="INSPEÇÃO DO MAPA" Foreground="#58A6FF" FontWeight="Black" FontSize="11"/>
                        <Button Content="X" HorizontalAlignment="Right" Background="Transparent" Foreground="#8B98A7" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnCloseInspector_Click"/>
                    </Grid>
                    <TextBlock x:Name="InspectorTitle" Text="Nome do Nó" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" Margin="0,6,0,2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="InspectorSubtitle" Text="Categoria / Módulo" Foreground="#3FB950" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Card Query com Botão Copiar -->
                        <Border Background="#0D1117" CornerRadius="8" Padding="10" Margin="0,0,0,12" BorderBrush="#23233A" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="QUERY DO SELETOR:" Foreground="#8B98A7" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <Button x:Name="BtnCopyQuery" Content="COPIAR" Click="BtnCopyQuery_Click"
                                            Background="#23233A" Foreground="#58A6FF" FontSize="9" FontWeight="Bold"
                                            BorderThickness="0" Padding="6,2" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Copiar seletor para a área de transferência"/>
                                </Grid>
                                <TextBox x:Name="InspectorQueryText" Text="query..." Foreground="#58A6FF" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Métricas de Desempenho -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0B0B13" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SCORE" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="InspectorScoreText" Text="—" Foreground="#3FB950" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#0B0B13" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="PRECISÃO" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="InspectorAccuracyText" Text="—" Foreground="#58A6FF" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Acertos vs Falhas -->
                        <Border Background="#0B0B13" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Acertos (hits):" Foreground="#3FB950" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="InspectorHitsText" Text="0" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Falhas (misses):" Foreground="#F85149" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="InspectorMissesText" Text="0" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Histórico recente -->
                        <Border Background="#0B0B13" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="HISTÓRICO RECENTE (10 EXECUÇÕES):" Foreground="#8B98A7" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="InspectorHistoryDots">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Botão Fechar Janela (Canto Superior Direito) -->
        <Button Content="X" Width="40" Height="40"
                VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,30,30,0"
                Background="#23233A" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"
                BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
