<UserControl x:Class="BotRpaUI.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0B14"
             FontFamily="Segoe UI">
    
    <UserControl.Resources>
        <!-- Estilos para os Botões Especiais Cyber-Industrial -->
        <Style x:Key="MonitorActionButton" TargetType="Button">
            <Setter Property="Background" Value="#11111E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1.5" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C1C30"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{Binding BorderBrush.Color, RelativeSource={RelativeSource TemplatedParent}}" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#080810"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="F1Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#4EDEA3"/>
            <Setter Property="BorderBrush" Value="#4EDEA3"/>
        </Style>
        <Style x:Key="F2Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#FFD666"/>
            <Setter Property="BorderBrush" Value="#FFD666"/>
        </Style>
        <Style x:Key="F3Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#D2BBFF"/>
            <Setter Property="BorderBrush" Value="#D2BBFF"/>
        </Style>
        <Style x:Key="F4Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#5EB1FF"/>
            <Setter Property="BorderBrush" Value="#5EB1FF"/>
        </Style>
        <Style x:Key="F5Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#FF4D4D"/>
            <Setter Property="BorderBrush" Value="#FF4D4D"/>
        </Style>
        <Style x:Key="F6Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#FFB3AD"/>
            <Setter Property="BorderBrush" Value="#FFB3AD"/>
        </Style>
        <Style x:Key="F7Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#FFA500"/>
            <Setter Property="BorderBrush" Value="#FFA500"/>
        </Style>
        <Style x:Key="F8Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
        </Style>
        <Style x:Key="StopStyle" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#FF4D4D"/>
            <Setter Property="BorderBrush" Value="#FF4D4D"/>
        </Style>

        <!-- Barra de Progresso Arredondada e Futurista -->
        <Style x:Key="RoundedProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#17172A"/>
            <Setter Property="Foreground" Value="#4EDEA3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <SolidColorBrush Color="#4EDEA3"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Botão fantasma com bordas arredondadas (ações de cabeçalho, ex: Limpar Logs) -->
        <Style x:Key="RoundedGhostButton" TargetType="Button">
            <Setter Property="Background" Value="#11111E"/>
            <Setter Property="Foreground" Value="#E3E0F2"/>
            <Setter Property="BorderBrush" Value="#513BA6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C1836"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8570E6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A0A12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PAINEL ESQUERDO: Controles e Dispositivos -->
            <Border Grid.Column="0" Background="#121220" CornerRadius="12" Padding="14" Margin="0,0,12,0" BorderBrush="#222236" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <!-- Título da Seção -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📱" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Aparelhos Conectados" Foreground="#E2DDFE" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1D1A38" CornerRadius="8" Padding="7,2" BorderBrush="#41307A" BorderThickness="1">
                                <TextBlock Text="ADB LIVE" Foreground="#00E5FF" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        
                        <!-- Lista de Aparelhos Conectados -->
                        <ListView x:Name="ListDevices" Height="140" Background="#0A0A12" Foreground="#E3E0F2" BorderBrush="#202034" BorderThickness="1" Margin="0,0,0,12" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <ListView.View>
                                <GridView>
                                    <!-- Modelo -->
                                    <GridViewColumn Header="Modelo" Width="105">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ModeloExibicao}" Foreground="#E3E0F2" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Número de Série -->
                                    <GridViewColumn Header="Número de Série" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Serial}" Foreground="#5EB1FF" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- MAC Wi-Fi -->
                                    <GridViewColumn Header="MAC Wi-Fi" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MACExibicao}" Foreground="#4EDEA3" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#17172A"/>
                                    <Setter Property="Foreground" Value="#9C8BE0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="#25253D"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,4"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#17172A"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1C1C30"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <!-- Automação ao Conectar (oculto enquanto o painel F4 estiver ativo) -->
                        <Border x:Name="CardAutoConectar" Background="#0C0C16" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" BorderBrush="#222236" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚡ Automação ao Conectar" Foreground="#D2BBFF" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkAutoInstall" Content="Ativar:" Foreground="#E3E0F2" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" FontSize="11"/>
                                    <ComboBox x:Name="ComboAutoAction" Grid.Column="1" Height="28" Background="#17172A" Foreground="#FFFFFF" BorderBrush="#2F2F48" SelectedIndex="0" FontSize="11">
                                        <ComboBoxItem Content="[F1] Sincronização + Instalação"/>
                                        <ComboBoxItem Content="[F2] Limpeza e Instalação"/>
                                        <ComboBoxItem Content="[F3] Atualização de Pacote"/>
                                        <ComboBoxItem Content="[F5] Desligamento Remoto"/>
                                        <ComboBoxItem Content="[F6] Sincronização Avançada"/>
                                        <ComboBoxItem Content="[F8] Conexão Ativa (Gnirehtet)"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Automação F4 ao Conectar (visível apenas com o painel de Gestão do Aparelho aberto) -->
                        <Border x:Name="CardAutoF4" Background="#141126" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" BorderBrush="#513BA6" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="⚡" Foreground="#00E5FF" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Automação F4 ao Conectar" Foreground="#D2BBFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkAutoF4" Content="Ativar:" Foreground="#E3E0F2" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" FontSize="11"/>
                                    <ComboBox x:Name="ComboAutoF4" Grid.Column="1" Height="28" Background="#17172A" Foreground="#FFFFFF" BorderBrush="#513BA6" SelectedIndex="0" FontSize="11" ToolTip="Subfunção do F4 executada automaticamente quando um aparelho for conectado.">
                                        <ComboBoxItem Content="Blindar Tudo (perfil 11,1,2,5,10)"/>
                                        <ComboBoxItem Content="Restaurar Tudo (perfil 12,3,4,6)"/>
                                        <ComboBoxItem Content="Bloquear Câmera (1)"/>
                                        <ComboBoxItem Content="Liberar Câmera (3)"/>
                                        <ComboBoxItem Content="Restringir Configurações (2)"/>
                                        <ComboBoxItem Content="Liberar Configurações (4)"/>
                                        <ComboBoxItem Content="Ativar Modo Restrito (5)"/>
                                        <ComboBoxItem Content="Desativar Modo Restrito (6)"/>
                                        <ComboBoxItem Content="Aplicar Papel de Parede (7)"/>
                                        <ComboBoxItem Content="Ligar Internet USB (8)"/>
                                        <ComboBoxItem Content="Desligar Internet USB (9)"/>
                                        <ComboBoxItem Content="Ocultar Barra de Pesquisa (10)"/>
                                        <ComboBoxItem Content="Aplicar Blindagem de Apps (11)"/>
                                        <ComboBoxItem Content="Reativar Apps - Restauração (12)"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="A subfunção escolhida do F4 é executada automaticamente em cada aparelho conectado." Foreground="#85859E" FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Seletor de Município -->
                        <TextBlock Text="🏛️ Município de Operação" Foreground="#D2BBFF" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ComboMunicipios" Height="32" Background="#281B54" Foreground="#FFFFFF" BorderBrush="#513BA6" SelectionChanged="ComboMunicipios_SelectionChanged" FontSize="12" FontWeight="SemiBold"/>
                            <Button x:Name="BtnGerenciarMunicipios" Grid.Column="1" Content="⚙ Gerenciar" Background="#11111E" Foreground="#4EDEA3" BorderBrush="#2D2D45" BorderThickness="1" Margin="8,0,0,0" Padding="12,0" Cursor="Hand" Click="BtnGerenciarMunicipios_Click" FontWeight="Bold" FontSize="11"/>
                        </Grid>

                        <!-- Card Estilizado de Arquivos do Município -->
                        <Border Background="#0C0C16" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" BorderBrush="#222236" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📁 Arquivos do Município" Foreground="#D2BBFF" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="VALIDADOS" Foreground="#4EDEA3" FontSize="10" FontWeight="Bold" Grid.Column="1"/>
                                </Grid>
                                
                                <!-- Linha APK -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="APK: " Foreground="#8570E6" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtApkName" Grid.Column="1" Text="Nenhum APK Encontrado" Foreground="#A1A1AA" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IconApkCheck" Grid.Column="2" Text="✔" Foreground="#4EDEA3" FontWeight="Bold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>

                                <!-- Linha Pacote ZIP -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pacote: " Foreground="#8570E6" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPacoteName" Grid.Column="1" Text="Não definido" Foreground="#A1A1AA" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IconPacoteCheck" Grid.Column="2" Text="✔" Foreground="#4EDEA3" FontWeight="Bold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>

                                <!-- Linha Wallpaper -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Wallpaper: " Foreground="#8570E6" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtWallpaperName" Grid.Column="1" Text="Padrão" Foreground="#A1A1AA" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IconWpCheck" Grid.Column="2" Text="✔" Foreground="#4EDEA3" FontWeight="Bold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Linha de Status Inferior -->
                        <Border Background="#09090F" CornerRadius="6" Padding="8,5" BorderBrush="#1C1C2C" BorderThickness="1">
                            <TextBlock x:Name="LblStatus" Text="Status: Nenhum aparelho conectado." Foreground="#8E8EA0" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- PAINEL DIREITO: Logs e Terminal / Painel Gestão do Aparelho -->
            <Border Grid.Column="1" Background="#121220" CornerRadius="12" Padding="14" BorderBrush="#222236" BorderThickness="1">
                <Grid>
                    <!-- Camada 1: Painel do Histórico de Execução (Logs normais) -->
                    <Grid x:Name="PanelHistoricoLogs" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="14" Foreground="#00E5FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Histórico de Execução" Foreground="#E2DDFE" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="#1C1836" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" BorderBrush="#513BA6" BorderThickness="1">
                                    <TextBlock Text="LOGS EM TEMPO REAL" Foreground="#4EDEA3" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ProgressBar x:Name="ExecutionProgress" Width="140" Height="8" Margin="0,0,10,0" 
                                             Style="{StaticResource RoundedProgressBar}" Value="0" Maximum="100"/>
                                <TextBlock x:Name="LblProgress" Text="0%" Foreground="#4EDEA3" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" Width="38" TextAlignment="Right" FontSize="12"/>
                                <Button Content="Limpar Logs" Style="{StaticResource RoundedGhostButton}" Click="BtnClearLog_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TabControl x:Name="LogTabs" Grid.Row="0" Background="#0A0A12" BorderBrush="#202034" BorderThickness="1">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TabItem">
                                                    <Border x:Name="TabBorder" Background="#121220" Padding="14,7" Margin="0,0,2,0" CornerRadius="6,6,0,0" BorderBrush="#202034" BorderThickness="1,1,1,0">
                                                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="TabBorder" Property="Background" Value="#2D1F5E"/>
                                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#8570E6"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="False">
                                                            <Setter Property="Foreground" Value="#9090A8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </TabControl.Resources>
                                <TabItem Header="Global (Sistema)">
                                    <Grid Background="#080810">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel x:Name="GlobalProgressPanel" Grid.Row="0" Margin="4"/>
                                        <TextBox x:Name="TxtLogGlobal" Grid.Row="1" Background="#080810" Foreground="#4EDEA3" BorderBrush="Transparent" BorderThickness="0" 
                                                 FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                                                 Padding="8" Text="[00:00:00] Bot_RPA - Motor Robótico C/C# inicializado. Aguardando conexão ADB...&#x0a;"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                                     
                            <TextBox x:Name="TxtInput" Grid.Row="1" Background="#17172A" Foreground="#E3E0F2" BorderBrush="#8570E6" BorderThickness="1"
                                     FontFamily="Consolas" FontSize="14" Padding="8" Margin="0,6,0,0" KeyDown="TxtInput_KeyDown"
                                     ToolTip="Digite um comando numérico e pressione ENTER" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>

                    <!-- Camada 2: Painel Visual Interativo de Gestao do Aparelho -->
                    <Grid x:Name="PanelGestaoAparelho" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- CABECALHO: Gestao do Aparelho + Botao Sair -->
                        <Border Grid.Row="0" Background="#161628" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="#2C2C48" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="38" Height="38" CornerRadius="8" Background="#281A54" BorderBrush="#513BA6" BorderThickness="1.5" Margin="0,0,12,0">
                                        <TextBlock Text="📱" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="GESTÃO DO APPARELHO" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="Hardware, aplicativos, rede e personalização do tablet" Foreground="#9C8BE0" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Botao Sair da Gestao do Aparelho -->
                                <Button x:Name="BtnSairGestao" Grid.Column="1" Click="BtnSairGestao_Click" Cursor="Hand" Padding="16,6" Height="36" Background="#28141C" BorderBrush="#FF4D4D" BorderThickness="1.5">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✕" Foreground="#FF4D4D" FontWeight="Black" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Sair da Gestão do Aparelho" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- PERFIS 1-CLIQUE: sequencia automatica, sem decorar numeros -->
                        <Border Grid.Row="1" Background="#141126" CornerRadius="10" Padding="10" Margin="0,0,0,10" BorderBrush="#513BA6" BorderThickness="1.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Tag="11,1,2,5,10" Click="BtnGestaoProfile_Click" Height="42" Margin="0,0,5,0" Background="#281A54" BorderBrush="#00E5FF" BorderThickness="1.5" Cursor="Hand" ToolTip="Blindagem + camera + config + modo restrito + barra, em sequencia">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Blindar Tudo" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="perfil completo em 1 clique" Foreground="#00E5FF" FontSize="9"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Tag="12,3,4,6" Click="BtnGestaoProfile_Click" Height="42" Margin="5,0,0,0" Background="#143024" BorderBrush="#4EDEA3" BorderThickness="1.5" Cursor="Hand" ToolTip="Reativa apps + libera camera, config e modo restrito, em sequencia">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🔄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Restaurar Tudo" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="desfaz tudo em 1 clique" Foreground="#4EDEA3" FontSize="9"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- DUAS COLUNAS: esquerda (controle + apps) e direita (personalizacao + rede) -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ================= COLUNA ESQUERDA ================= -->
                            <Border Grid.Column="0" Background="#101020" CornerRadius="10" Padding="10" BorderBrush="#25253E" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#141126" CornerRadius="8" Padding="10,7" Margin="0,0,0,8" BorderBrush="#513BA6" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔒" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="CONTROLE DE ACESSO" Foreground="#D2BBFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <StackPanel>
                                            <!-- Camera -->
                                            <Border Background="#121222" CornerRadius="8" Padding="10,9" Margin="0,0,0,8" BorderBrush="#25253E" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="📷 Câmera" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Text="Bloqueia os aplicativos de foto e vídeo" Foreground="#85859E" FontSize="9" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Tag="1" Click="BtnGestaoAction_Click" Content="Bloquear" Width="66" Height="28" Background="#241217" Foreground="#FFA3A3" BorderBrush="#FF4D4D" BorderThickness="1" Margin="0,0,4,0" Cursor="Hand" FontWeight="Bold" FontSize="10"/>
                                                        <Button Tag="3" Click="BtnGestaoAction_Click" Content="Liberar" Width="62" Height="28" Background="#10251C" Foreground="#4EDEA3" BorderBrush="#276749" BorderThickness="1" Cursor="Hand" FontWeight="Bold" FontSize="10"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Configuracoes -->
                                            <Border Background="#121222" CornerRadius="8" Padding="10,9" Margin="0,0,0,8" BorderBrush="#25253E" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="⚙️ Configurações" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Text="Restringe o menu de Configurações do sistema" Foreground="#85859E" FontSize="9" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Tag="2" Click="BtnGestaoAction_Click" Content="Restringir" Width="72" Height="28" Background="#2A2412" Foreground="#FFE699" BorderBrush="#FFD666" BorderThickness="1" Margin="0,0,4,0" Cursor="Hand" FontWeight="Bold" FontSize="10"/>
                                                        <Button Tag="4" Click="BtnGestaoAction_Click" Content="Liberar" Width="62" Height="28" Background="#10251C" Foreground="#4EDEA3" BorderBrush="#276749" BorderThickness="1" Cursor="Hand" FontWeight="Bold" FontSize="10"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Modo Restrito -->
                                            <Border Background="#121222" CornerRadius="8" Padding="10,9" Margin="0,0,0,8" BorderBrush="#25253E" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="🛑 Modo Restrito" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Text="Trava conjunta em Câmera + Configurações" Foreground="#85859E" FontSize="9" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Tag="5" Click="BtnGestaoAction_Click" Content="Ativar" Width="62" Height="28" Background="#2D1720" Foreground="#FF8080" BorderBrush="#FF4D4D" BorderThickness="1" Margin="0,0,4,0" Cursor="Hand" FontWeight="Bold" FontSize="10"/>
                                                        <Button Tag="6" Click="BtnGestaoAction_Click" Content="Desativar" Width="70" Height="28" Background="#12241C" Foreground="#55EFC4" BorderBrush="#276749" BorderThickness="1" Cursor="Hand" FontWeight="Bold" FontSize="10"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- SEPARADOR DE GRUPO -->
                                            <Border Background="#141126" CornerRadius="8" Padding="10,7" Margin="0,4,0,8" BorderBrush="#513BA6" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="APLICATIVOS" Foreground="#D2BBFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Blindagem -->
                                            <Border Background="#141126" CornerRadius="8" Padding="10,9" Margin="0,0,0,8" BorderBrush="#513BA6" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="🛡️ Blindagem de Apps" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Text="Desativa e remove bloatwares do sistema" Foreground="#85859E" FontSize="9" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Tag="11" Click="BtnGestaoAction_Click" Content="Aplicar" Width="76" Height="28" Background="#281A54" Foreground="#FFFFFF" BorderBrush="#00E5FF" BorderThickness="1" Cursor="Hand" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Restauracao -->
                                            <Border Background="#0E1E19" CornerRadius="8" Padding="10,9" Margin="0,0,0,4" BorderBrush="#276749" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="🔄 Restauração" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Text="Reativa todos os pacotes do sistema" Foreground="#85859E" FontSize="9" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Tag="12" Click="BtnGestaoAction_Click" Content="Reativar" Width="76" Height="28" Background="#143024" Foreground="#FFFFFF" BorderBrush="#4EDEA3" BorderThickness="1" Cursor="Hand" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- ================= COLUNA DIREITA ================= -->
                            <Border Grid.Column="2" Background="#101020" CornerRadius="10" Padding="10" BorderBrush="#25253E" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#141126" CornerRadius="8" Padding="10,7" Margin="0,0,0,8" BorderBrush="#513BA6" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="PERSONIZAÇÃO E REDE" Foreground="#D2BBFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <StackPanel>
                                            <!-- Papel de Parede -->
                                            <Border Background="#121222" CornerRadius="8" Padding="10,9" Margin="0,0,0,8" BorderBrush="#25253E" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="🖼️ Papel de Parede" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Text="Aplica o wallpaper configurado do município" Foreground="#85859E" FontSize="9" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Tag="7" Click="BtnGestaoAction_Click" Content="Aplicar" Width="76" Height="28" Background="#161830" Foreground="#D2BBFF" BorderBrush="#8570E6" BorderThickness="1" Cursor="Hand" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Internet USB -->
                                            <Border Background="#121222" CornerRadius="8" Padding="10,9" Margin="0,0,0,8" BorderBrush="#25253E" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="🌐 Internet USB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Text="Compartilha a internet do PC via cabo USB" Foreground="#85859E" FontSize="9" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Tag="8" Click="BtnGestaoAction_Click" Content="Ligar" Width="58" Height="28" Background="#0E222A" Foreground="#00E5FF" BorderBrush="#00BCD4" BorderThickness="1" Margin="0,0,4,0" Cursor="Hand" FontWeight="Bold" FontSize="10"/>
                                                        <Button Tag="9" Click="BtnGestaoAction_Click" Content="Desligar" Width="66" Height="28" Background="#241217" Foreground="#FFA3A3" BorderBrush="#FF4D4D" BorderThickness="1" Cursor="Hand" FontWeight="Bold" FontSize="10"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Barra de Pesquisa -->
                                            <Border Background="#121222" CornerRadius="8" Padding="10,9" Margin="0,0,0,4" BorderBrush="#25253E" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="🧹 Barra de Pesquisa" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Text="Remove a barra de busca da tela inicial" Foreground="#85859E" FontSize="9" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Tag="10" Click="BtnGestaoAction_Click" Content="Ocultar" Width="72" Height="28" Background="#1E1C12" Foreground="#FFE699" BorderBrush="#FFC107" BorderThickness="1" Cursor="Hand" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Conta Google -->
                                            <Border Background="#0F172A" CornerRadius="8" Padding="10,9" Margin="0,0,0,4" BorderBrush="#4285F4" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="G" Foreground="#8AB4F8" FontWeight="Black" FontSize="12" Margin="0,0,5,0"/>
                                                            <TextBlock Text="Conta Google" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Usa a conta Google padrao configurada" Foreground="#85859E" FontSize="9" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Click="BtnGestaoGoogleAccount_Click" Content="Adicionar" Width="76" Height="28" Background="#16233A" Foreground="#8AB4F8" BorderBrush="#4285F4" BorderThickness="1" Cursor="Hand" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- RODAPE: Status + Execucao em Lote -->
                        <Border Grid.Row="3" Background="#0C0C16" CornerRadius="8" Padding="12,8" Margin="0,8,0,0" BorderBrush="#222236" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Status:" Foreground="#8570E6" FontWeight="Bold" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtGestaoStatus" Text="Selecione uma opção acima para aplicar aos tablets conectados." Foreground="#E2DDFE" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Lote (ex: 11,5,7):" Foreground="#8570E6" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtGestaoBatchInput" Width="90" Height="24" Background="#17172A" Foreground="#FFFFFF" BorderBrush="#513BA6" BorderThickness="1" Padding="4,2" FontSize="11" VerticalContentAlignment="Center" ToolTip="Ex: 11,5,7" KeyDown="TxtGestaoBatchInput_KeyDown"/>
                                    <Button Content="Executar" Click="BtnGestaoBatchRun_Click" Height="24" Background="#281A54" Foreground="#4EDEA3" BorderBrush="#513BA6" BorderThickness="1" Margin="6,0,0,0" Padding="8,0" Cursor="Hand" FontWeight="Bold" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- PAINEL INFERIOR: Painel de Ações Rápidas por Modelo -->
        <Border Grid.Row="1" Background="#121220" CornerRadius="12" Padding="14,10" Margin="0,12,0,0" BorderBrush="#222236" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Linha 0: Seletor de Modelo e Indicador de Emergência -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Seletor de Categoria de Modelo (Segmented Pill) -->
                    <Border Grid.Column="0" Background="#0C0C16" CornerRadius="8" Padding="3" BorderBrush="#222236" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnCategoryPositivo" Content="📱 Positivo Tab Vision 7" Padding="12,5" Click="BtnCategoryPositivo_Click" FontWeight="Bold" FontSize="11" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#513BA6"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#8570E6"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnCategoryMultilaser" Content="📱 Multilaser Tab-Multi" Padding="12,5" Click="BtnCategoryMultilaser_Click" FontWeight="Bold" FontSize="11" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#A3A3C2"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnCategoryNokia" Content="📱 Nokia T20 (Android 11)" Padding="12,5" Click="BtnCategoryNokia_Click" FontWeight="Bold" FontSize="11" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#A3A3C2"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#241217" BorderBrush="#FF4D4D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="🛑 Parada Geral: Pressione ESC / ESPAÇO a qualquer momento" Foreground="#FFA3A3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Linha 1: Grid de Cards de Ação (4 Colunas x 2 Linhas) -->
                <!-- Ações Positivo (Positivo Tab Vision 7) -->
                <UniformGrid x:Name="GridPositivoActions" Grid.Row="1" Columns="4" Rows="2" Visibility="Visible">
                    <Button Content="[F1] Conf. Geral" Style="{StaticResource F1Style}" Click="BtnF1_Click"/>
                    <Button Content="[F2] Limpeza e Instalação" Style="{StaticResource F2Style}" Click="BtnF2_Click"/>
                    <Button Content="[F3] Atualizar Pacote" Style="{StaticResource F3Style}" Click="BtnF3_Click"/>
                    <Button Content="[F4] Gestão do Aparelho (Hardware &amp; Apps)" Style="{StaticResource F4Style}" Click="BtnF4_Click"/>
                    <Button Content="[F5] Desligar Aparelhos" Style="{StaticResource F5Style}" Click="BtnF5_Click"/>
                    <Button Content="[F6] Sincronização Avançada" Style="{StaticResource F6Style}" Click="BtnF6_Click"/>
                    <Button Content="[F8] Conexão Ativa (Gnirehtet)" Style="{StaticResource F8Style}" Click="BtnF8_Click"/>
                    <Button Content="🛑 Parar [ESC / ESPAÇO]" Style="{StaticResource StopStyle}" Click="BtnStop_Click"/>
                </UniformGrid>

                <!-- Ações Multilaser (Multilaser Tab-Multi) -->
                <UniformGrid x:Name="GridMultilaserActions" Grid.Row="1" Columns="4" Rows="2" Visibility="Collapsed">
                    <Button Content="[F1] Instalação + Prep (Tab-MULTI)" Style="{StaticResource F7Style}" Click="BtnF7_Click"/>
                    <Button Content="[F2] Atualizar Pacote" Style="{StaticResource F3Style}" Click="BtnM7_F2_Click"/>
                    <Button Content="[F3] Terminal (Gestão do Aparelho)" Style="{StaticResource F4Style}" Click="BtnM7_F3_Click"/>
                    <Button Content="[F4] Desligar Aparelhos" Style="{StaticResource F5Style}" Click="BtnM7_F4_Click"/>
                    <Button Content="[F5] Login + Sinc 30s + Shutdown" Style="{StaticResource F6Style}" Click="BtnM7_F5_Click"/>
                    <Button Content="🛑 Parar [ESC / ESPAÇO]" Style="{StaticResource StopStyle}" Click="BtnStop_Click"/>
                </UniformGrid>

                <!-- Ações Nokia (Nokia T20 Android 11) -->
                <UniformGrid x:Name="GridNokiaActions" Grid.Row="1" Columns="4" Rows="1" Visibility="Collapsed">
                    <Button Content="[F1] Sincronização + Instalação" Style="{StaticResource F1Style}" Click="BtnF1_Click"/>
                    <Button Content="[F2] Reinstalação (Preserva Apps)" Style="{StaticResource F2Style}" Click="BtnNokiaF2_Click"/>
                    <Button Content="[F3] Atualizar Pacote" Style="{StaticResource F3Style}" Click="BtnNokiaF3_Click"/>
                    <Button Content="🛑 Parar [ESC / ESPAÇO]" Style="{StaticResource StopStyle}" Click="BtnStop_Click"/>
                </UniformGrid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
