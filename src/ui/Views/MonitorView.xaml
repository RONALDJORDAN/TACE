<UserControl x:Class="InnovPlayUI.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0B13"
             FontFamily="Segoe UI">
    
    <UserControl.Resources>
        <!-- Estilos para os Botões Especiais -->
        <Style x:Key="MonitorActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A0F"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1.5" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A2E"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{Binding BorderBrush.Color, RelativeSource={RelativeSource TemplatedParent}}" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#05050A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="F1Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#4EDEA3"/>
            <Setter Property="BorderBrush" Value="#4EDEA3"/>
        </Style>
        <Style x:Key="F2Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#FFD666"/>
            <Setter Property="BorderBrush" Value="#FFD666"/>
        </Style>
        <Style x:Key="F3Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#D2BBFF"/>
            <Setter Property="BorderBrush" Value="#D2BBFF"/>
        </Style>
        <Style x:Key="F4Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#5EB1FF"/>
            <Setter Property="BorderBrush" Value="#5EB1FF"/>
        </Style>
        <Style x:Key="F5Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#FF4D4D"/>
            <Setter Property="BorderBrush" Value="#FF4D4D"/>
        </Style>
        <Style x:Key="F6Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#FFB3AD"/>
            <Setter Property="BorderBrush" Value="#FFB3AD"/>
        </Style>
        <Style x:Key="F7Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#FFA500"/>
            <Setter Property="BorderBrush" Value="#FFA500"/>
        </Style>
        <Style x:Key="F8Style" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
        </Style>
        <Style x:Key="StopStyle" BasedOn="{StaticResource MonitorActionButton}" TargetType="Button">
            <Setter Property="Foreground" Value="#FFB3AD"/>
            <Setter Property="BorderBrush" Value="#FFB3AD"/>
        </Style>


        <Style x:Key="RoundedProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#4EDEA3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <SolidColorBrush Color="#4EDEA3"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PAINEL ESQUERDO: Controles (Adaptável a diferentes resoluções) -->
            <Border Grid.Column="0" Background="#151525" CornerRadius="12" Padding="15" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="Aparelhos Conectados" Foreground="#D2BBFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <!-- DataGrid Substituído por ListView premium para WPF nativo -->
                        <ListView x:Name="ListDevices" Height="130" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" BorderThickness="1" Margin="0,0,0,12" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Bateria" Width="85">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Width="70" Height="18" Margin="0,2">
                                                    <ProgressBar Value="{Binding BatteryValue}" Minimum="0" Maximum="100" Style="{StaticResource RoundedProgressBar}"/>
                                                    <TextBlock Text="{Binding Battery}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                     <GridViewColumn Header="Serial" Width="110" DisplayMemberBinding="{Binding Serial}" />
                                     <GridViewColumn Header="Modelo" Width="85" DisplayMemberBinding="{Binding Model}" />
                                     <GridViewColumn Header="Android" Width="60" DisplayMemberBinding="{Binding AndroidVersion}" />
                                     <GridViewColumn Header="Status ao Vivo" Width="95">
                                         <GridViewColumn.CellTemplate>
                                             <DataTemplate>
                                                 <Border Background="{Binding StatusColor}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Center">
                                                     <TextBlock Text="{Binding Status}" Foreground="#000000" FontWeight="Bold" FontSize="10"/>
                                                 </Border>
                                             </DataTemplate>
                                         </GridViewColumn.CellTemplate>
                                     </GridViewColumn>
                                 </GridView>
                            </ListView.View>
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#1A1A2E"/>
                                    <Setter Property="Foreground" Value="#8570E6"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#1A1A2E"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A1A2E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <TextBlock Text="Automação ao Conectar" Foreground="#D2BBFF" FontSize="14" FontWeight="Bold" Margin="0,2,0,5"/>
                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkAutoInstall" Content="Ativar:" Foreground="#E3E0F2" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ComboAutoAction" Grid.Column="1" Height="26" Background="#1A1A2E" Foreground="#FFFFFF" BorderBrush="#2A2A40" SelectedIndex="0">
                                <ComboBoxItem Content="[F1] Sincronização + Instalação"/>
                                <ComboBoxItem Content="[F2] Limpeza e Instalação"/>
                                <ComboBoxItem Content="[F3] Atualização de Pacote"/>
                                <ComboBoxItem Content="[F5] Desligamento Remoto"/>
                                <ComboBoxItem Content="[F6] Sincronização Avançada"/>
                                <ComboBoxItem Content="[F8] Conexão Ativa (Gnirehtet)"/>
                            </ComboBox>
                        </Grid>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ComboMunicipios" Height="30" Background="#513BA6" Foreground="#FFFFFF" BorderBrush="#8570E6" SelectionChanged="ComboMunicipios_SelectionChanged">
                            </ComboBox>
                            <Button Grid.Column="1" Content="⚙ Gerenciar" Background="#0A0A0F" Foreground="#4EDEA3" BorderBrush="#2A2A40" BorderThickness="1" Margin="10,0,0,0" Padding="10,0" Cursor="Hand" Click="BtnGerenciarMunicipios_Click"/>
                        </Grid>

                        <!-- Card Estilizado e Responsivo de Arquivos do Município -->
                        <Border Background="#0D0D18" CornerRadius="8" Padding="12,10" Margin="0,2,0,10" BorderBrush="#23233A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Arquivos do Município" Foreground="#D2BBFF" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                
                                <!-- Linha APK -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="APK: " Foreground="#8570E6" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtApkName" Grid.Column="1" Text="Nenhum APK Encontrado" Foreground="#A1A1AA" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IconApkCheck" Grid.Column="2" Text="➜" Foreground="#4EDEA3" FontWeight="Bold" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>

                                <!-- Linha Pacote ZIP -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pacote: " Foreground="#8570E6" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPacoteName" Grid.Column="1" Text="Não definido" Foreground="#A1A1AA" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IconPacoteCheck" Grid.Column="2" Text="➜" Foreground="#4EDEA3" FontWeight="Bold" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>

                                <!-- Linha Wallpaper -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Wallpaper: " Foreground="#8570E6" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtWallpaperName" Grid.Column="1" Text="Padrão" Foreground="#A1A1AA" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IconWpCheck" Grid.Column="2" Text="➜" Foreground="#4EDEA3" FontWeight="Bold" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="LblStatus" Text="Status: Nenhum aparelho conectado." Foreground="#7A7A8A" Margin="0,5,0,0" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- PAINEL DIREITO: Logs -->
            <Border Grid.Column="1" Background="#151525" CornerRadius="12" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Histórico de Execução - Logs por Dispositivo" Foreground="#D2BBFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar x:Name="ExecutionProgress" Width="150" Height="8" Margin="0,0,10,0" 
                                         Style="{StaticResource RoundedProgressBar}" Value="0" Maximum="100"/>
                            <TextBlock x:Name="LblProgress" Text="0%" Foreground="#4EDEA3" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0" Width="40" TextAlignment="Right"/>
                            <Button Content="Limpar Logs" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#8570E6" BorderThickness="1" Padding="10,5" Click="BtnClearLog_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TabControl x:Name="LogTabs" Grid.Row="0" Background="#0A0A0F" BorderBrush="#2A2A40" BorderThickness="1">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="TabBorder" Background="#151525" Padding="15,8" Margin="0,0,2,0" CornerRadius="6,6,0,0">
                                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#513BA6"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="False">
                                                        <Setter Property="Foreground" Value="#A0A0B0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </TabControl.Resources>
                            <TabItem Header="Global (Sistema)">
                                <Grid Background="#0A0A0F">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel x:Name="GlobalProgressPanel" Grid.Row="0" Margin="5"/>
                                    <TextBox x:Name="TxtLogGlobal" Grid.Row="1" Background="#0A0A0F" Foreground="#4EDEA3" BorderBrush="Transparent" BorderThickness="0" 
                                             FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                                             Padding="5" Text="[00:00:00] InnoBot - Robotic Process Automation iniciado. Aguardando dispositivos ADB...&#x0a;"/>
                                </Grid>
                            </TabItem>
                        </TabControl>
                                 
                        <TextBox x:Name="TxtInput" Grid.Row="1" Background="#1A1A2E" Foreground="#E3E0F2" BorderBrush="#8570E6" BorderThickness="1"
                                 FontFamily="Consolas" FontSize="16" Padding="10" Margin="0,5,0,0" KeyDown="TxtInput_KeyDown"
                                 ToolTip="Digite um comando numérico e pressione ENTER" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- PAINEL INFERIOR: Painel de Ações Rápidas por Modelo -->
        <Border Grid.Row="1" Background="#151525" CornerRadius="12" Padding="14,12" Margin="0,15,0,0" BorderBrush="#23233A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Linha 0: Cabeçalho com Seletor de Modelo e Indicador de Atalho -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Seletor de Categoria de Modelo (Segmented Pill) -->
                    <Border Grid.Column="0" Background="#0D0D18" CornerRadius="8" Padding="3" BorderBrush="#23233A" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnCategoryPositivo" Content="📱 Positivo Tab Vision 7" Padding="14,6" Click="BtnCategoryPositivo_Click" FontWeight="Bold" FontSize="12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#513BA6"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#8570E6"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnCategoryMultilaser" Content="📱 Multilaser Tab-Multi" Padding="14,6" Click="BtnCategoryMultilaser_Click" FontWeight="Bold" FontSize="12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#A3A3C2"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnCategoryNokia" Content="📱 Nokia T20 (Android 11)" Padding="14,6" Click="BtnCategoryNokia_Click" FontWeight="Bold" FontSize="12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#A3A3C2"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="💡 Parada de Emergência: Pressione ESC / ESPAÇO a qualquer momento" Foreground="#85859E" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Linha 1: Grid de Cards de Ação (4 Colunas x 2 Linhas) -->
                <!-- Ações Positivo (Positivo Tab Vision 7) -->
                <UniformGrid x:Name="GridPositivoActions" Grid.Row="1" Columns="4" Rows="2" Visibility="Visible">
                    <Button Content="[F1] Sincronização + Instalação" Style="{StaticResource F1Style}" Click="BtnF1_Click"/>
                    <Button Content="[F2] Limpeza e Instalação" Style="{StaticResource F2Style}" Click="BtnF2_Click"/>
                    <Button Content="[F3] Atualizar Pacote" Style="{StaticResource F3Style}" Click="BtnF3_Click"/>
                    <Button Content="[F4] Terminal (Gestão Kiosk)" Style="{StaticResource F4Style}" Click="BtnF4_Click"/>
                    <Button Content="[F5] Desligar Aparelhos" Style="{StaticResource F5Style}" Click="BtnF5_Click"/>
                    <Button Content="[F6] Sincronização Avançada" Style="{StaticResource F6Style}" Click="BtnF6_Click"/>
                    <Button Content="[F8] Conexão Ativa (Gnirehtet)" Style="{StaticResource F8Style}" Click="BtnF8_Click"/>
                    <Button Content="🛑 Parar [ESC / ESPAÇO]" Style="{StaticResource StopStyle}" Click="BtnStop_Click"/>
                </UniformGrid>

                <!-- Ações Multilaser (Multilaser Tab-Multi) -->
                <UniformGrid x:Name="GridMultilaserActions" Grid.Row="1" Columns="4" Rows="2" Visibility="Collapsed">
                    <Button Content="[F1] Instalação + Prep (Tab-MULTI)" Style="{StaticResource F7Style}" Click="BtnF7_Click"/>
                    <Button Content="[F2] Atualizar Pacote" Style="{StaticResource F3Style}" Click="BtnM7_F2_Click"/>
                    <Button Content="[F3] Terminal (Gestão Kiosk)" Style="{StaticResource F4Style}" Click="BtnM7_F3_Click"/>
                    <Button Content="[F4] Desligar Aparelhos" Style="{StaticResource F5Style}" Click="BtnM7_F4_Click"/>
                    <Button Content="[F5] Login + Sinc 30s + Shutdown" Style="{StaticResource F6Style}" Click="BtnM7_F5_Click"/>
                    <Button Content="🛑 Parar [ESC / ESPAÇO]" Style="{StaticResource StopStyle}" Click="BtnStop_Click"/>
                </UniformGrid>

                <!-- Ações Nokia (Nokia T20 Android 11) -->
                <UniformGrid x:Name="GridNokiaActions" Grid.Row="1" Columns="4" Rows="1" Visibility="Collapsed">
                    <Button Content="[F1] Sincronização + Instalação" Style="{StaticResource F1Style}" Click="BtnF1_Click"/>
                    <Button Content="[F2] Reinstalação (Preserva Apps)" Style="{StaticResource F2Style}" Click="BtnNokiaF2_Click"/>
                    <Button Content="[F3] Atualizar Pacote" Style="{StaticResource F3Style}" Click="BtnNokiaF3_Click"/>
                    <Button Content="🛑 Parar [ESC / ESPAÇO]" Style="{StaticResource StopStyle}" Click="BtnStop_Click"/>
                </UniformGrid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
