<UserControl x:Class="BotRpaUI.Views.RelatoriosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1150" Background="#0B0B13"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Estilo dos Botões do Menu Lateral -->
        <Style x:Key="SideMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Margin="{TemplateBinding Margin}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222238"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões de Filtro Rápido (Pill) -->
        <Style x:Key="FilterPillButton" TargetType="Button">
            <Setter Property="Background" Value="#151525"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderBrush" Value="#2A2A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A40"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do DataGrid Dark -->
        <Style x:Key="DarkDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#0A0A0F"/>
            <Setter Property="Foreground" Value="#E3E0F2"/>
            <Setter Property="RowBackground" Value="#0A0A0F"/>
            <Setter Property="AlternatingRowBackground" Value="#121220"/>
            <Setter Property="BorderBrush" Value="#2A2A40"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#202035"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="36"/>
        </Style>

        <Style x:Key="DarkDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#161628"/>
            <Setter Property="Foreground" Value="#8570E6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#2A2A40"/>
        </Style>

        <Style x:Key="DarkDataGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de Progresso Arredondada -->
        <Style x:Key="MetricProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#151525"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Foreground.(SolidColorBrush.Color), RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <!-- Layout Principal com Menu Lateral -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL COM OS 4 SUBMÓDULOS -->
        <Border Grid.Column="0" Background="#151525" CornerRadius="12" Padding="14" BorderBrush="#23233A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho do Menu -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,4,0,10">
                        <TextBlock Text="📊" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Relatórios &amp; Hub" Foreground="#FFFFFF" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Separator Background="#23233A" Margin="0,5,0,5"/>
                    <TextBlock Text="SUBMÓDULOS PRINCIPAIS" Foreground="#8570E6" FontSize="10" FontWeight="Bold" Margin="6,5,0,0"/>
                </StackPanel>

                <!-- 4 Botões de Submódulos -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="BtnSubMetricas" Content="📊  1. Métricas &amp; Dashboard" Style="{StaticResource SideMenuButton}" Click="BtnSubMetricas_Click" Foreground="#4EDEA3" Background="#2A2A40"/>
                    <Button x:Name="BtnSubBancoDados" Content="🗄️  2. Banco de Dados" Style="{StaticResource SideMenuButton}" Click="BtnSubBancoDados_Click"/>
                    <Button x:Name="BtnSubRegistros" Content="📝  3. Registros &amp; Auditoria" Style="{StaticResource SideMenuButton}" Click="BtnSubRegistros_Click"/>
                    <Button x:Name="BtnSubExportacao" Content="📤  4. Exportação de Dados" Style="{StaticResource SideMenuButton}" Click="BtnSubExportacao_Click"/>
                </StackPanel>

                <!-- Rodapé informativo do Menu -->
                <Border Grid.Row="2" Background="#0A0A0F" CornerRadius="8" Padding="10" BorderBrush="#202035" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Banco SQLite Conectado" Foreground="#4EDEA3" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtMiniStatusDb" Text="0 aparelhos registrados" Foreground="#85859E" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ÁREA DE CONTEÚDO DOS 4 SUBMÓDULOS -->
        <Grid Grid.Column="2">

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 1: MÉTRICAS & DASHBOARD -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelMetricas" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Título do Submódulo -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Métricas &amp; Inteligência da Frota" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Visão executiva em tempo real do banco de dados e distribuição dos equipamentos homologados." Foreground="#85859E" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="🔄 Atualizar Métricas" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" BorderThickness="1" Padding="12,6" Cursor="Hand" Click="BtnAtualizarMetricas_Click"/>
                        </Grid>

                        <!-- Grade de 5 Cards KPIs no Topo -->
                        <UniformGrid Columns="5" Margin="0,0,0,20">
                            <!-- Card 1: Total Geral -->
                            <Border Background="#0D0D18" CornerRadius="10" Padding="14,12" Margin="0,0,8,0" BorderBrush="#513BA6" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="TOTAL BASE" Foreground="#8570E6" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="DashTotalDispositivos" Text="0" Foreground="#FFFFFF" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                                    <TextBlock Text="Dispositivos Cadastrados" Foreground="#85859E" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Positivo Vision 7 -->
                            <Border Background="#0D0D18" CornerRadius="10" Padding="14,12" Margin="4,0,4,0" BorderBrush="#00F5D4" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="POSITIVO VISION 7" Foreground="#00F5D4" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="DashTotalVision7" Text="0" Foreground="#00F5D4" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DashPercVision7" Text="0% da frota" Foreground="#85859E" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: TabMulti M7 -->
                            <Border Background="#0D0D18" CornerRadius="10" Padding="14,12" Margin="4,0,4,0" BorderBrush="#FFB703" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="TABMULTI M7" Foreground="#FFB703" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="DashTotalMultiM7" Text="0" Foreground="#FFB703" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DashPercMultiM7" Text="0% da frota" Foreground="#85859E" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Nokia T20 (NOVO!) -->
                            <Border Background="#0D0D18" CornerRadius="10" Padding="14,12" Margin="4,0,4,0" BorderBrush="#D2BBFF" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="NOKIA T20 (A11)" Foreground="#D2BBFF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="DashTotalNokiaT20" Text="0" Foreground="#D2BBFF" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DashPercNokiaT20" Text="0% da frota" Foreground="#85859E" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Auditorias e Logs -->
                            <Border Background="#0D0D18" CornerRadius="10" Padding="14,12" Margin="8,0,0,0" BorderBrush="#00E5FF" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="AUDITORIAS" Foreground="#00E5FF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="DashTotalRegistros" Text="0" Foreground="#00E5FF" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                                    <TextBlock Text="Sessões de Build/Log" Foreground="#85859E" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Seção Analítica de 2 Colunas -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Coluna 1: Distribuição Proporcional por Fabricante -->
                            <Border Grid.Column="0" Background="#0D0D18" CornerRadius="10" Padding="16" BorderBrush="#23233A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📈 Distribuição Proporcional da Frota" Foreground="#E3E0F2" FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>

                                    <!-- Barra Positivo -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="Positivo Tab Vision 7" Foreground="#E3E0F2" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtBarVision7" Text="0 (0%)" Foreground="#00F5D4" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="ProgressVision7" Grid.Row="1" Foreground="#00F5D4" Style="{StaticResource MetricProgressBar}" Value="0" Maximum="100"/>
                                    </Grid>

                                    <!-- Barra Multilaser -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="Multilaser TabMulti M7" Foreground="#E3E0F2" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtBarMultiM7" Text="0 (0%)" Foreground="#FFB703" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="ProgressMultiM7" Grid.Row="1" Foreground="#FFB703" Style="{StaticResource MetricProgressBar}" Value="0" Maximum="100"/>
                                    </Grid>

                                    <!-- Barra Nokia -->
                                    <Grid Margin="0,0,0,5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="Nokia T20 (Android 11)" Foreground="#E3E0F2" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtBarNokiaT20" Text="0 (0%)" Foreground="#D2BBFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="ProgressNokiaT20" Grid.Row="1" Foreground="#D2BBFF" Style="{StaticResource MetricProgressBar}" Value="0" Maximum="100"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Coluna 2: Saúde do Cadastro & Último Registro -->
                            <Border Grid.Column="2" Background="#0D0D18" CornerRadius="10" Padding="16" BorderBrush="#23233A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🔍 Integridade &amp; Telemetria dos Dados" Foreground="#E3E0F2" FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dispositivos com MAC Address válido:" Foreground="#A1A1AA" FontSize="12"/>
                                        <TextBlock x:Name="TxtIntegridadeMac" Grid.Column="1" Text="0/0 (100%)" Foreground="#4EDEA3" FontSize="12" FontWeight="Bold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total de Sessões de Compilação:" Foreground="#A1A1AA" FontSize="12"/>
                                        <TextBlock x:Name="TxtTotalSessoesBuild" Grid.Column="1" Text="0" Foreground="#00E5FF" FontSize="12" FontWeight="Bold"/>
                                    </Grid>

                                    <Separator Background="#23233A" Margin="0,0,0,12"/>

                                    <TextBlock Text="Último Dispositivo Registrado:" Foreground="#8570E6" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtUltimoDispositivo" Text="Nenhum dispositivo cadastrado." Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 2: BANCO DE DADOS DE DISPOSITIVOS -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelBancoDados" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🗄️ Banco de Dados SQLite" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Gerencie todos os tablets cadastrados na base. Clique duplo para editar ou utilize a barra de ações." Foreground="#85859E" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="Registrar Aparelho" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#4EDEA3" Foreground="#0B0B13" FontWeight="Bold" BorderThickness="0"
                                Padding="14,7" Cursor="Hand" Click="BtnAbrirRegistroSerie_Click"/>
                    </Grid>

                    <!-- Barra de Busca + Filtros Rápidos (Pills) -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Campo de Busca -->
                        <Border Grid.Column="0" Background="#0A0A0F" BorderBrush="#2A2A40" BorderThickness="1" CornerRadius="6" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A1A1AA"/>
                                <TextBox x:Name="TxtBuscaBD" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                         Foreground="#E3E0F2" FontSize="12" VerticalAlignment="Center"
                                         ToolTip="Buscar por nº de patrimônio (INV), serial, MAC, marca ou modelo"
                                         TextChanged="TxtBuscaBD_TextChanged"/>
                                <TextBlock x:Name="TxtBuscaBDPlaceholder" Grid.Column="1" Text="Patrimônio (INV), serial, MAC ou marca..."
                                           Foreground="#5A5A72" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Botões de Filtro Rápido por Modelo -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnFiltroTodos" Content="Todos" Style="{StaticResource FilterPillButton}" Click="BtnFiltroTodos_Click" Background="#513BA6" Foreground="#FFFFFF" BorderBrush="#8570E6"/>
                            <Button x:Name="BtnFiltroVision7" Content="📱 Positivo Vision 7" Style="{StaticResource FilterPillButton}" Click="BtnFiltroVision7_Click"/>
                            <Button x:Name="BtnFiltroMultiM7" Content="📱 Multilaser M7" Style="{StaticResource FilterPillButton}" Click="BtnFiltroMultiM7_Click"/>
                            <Button x:Name="BtnFiltroNokiaT20" Content="📱 Nokia T20" Style="{StaticResource FilterPillButton}" Click="BtnFiltroNokiaT20_Click"/>
                        </StackPanel>

                        <!-- Contador de Registros -->
                        <TextBlock x:Name="TxtContadorBD" Grid.Column="3" Foreground="#85859E" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="0 registros"/>
                    </Grid>

                    <!-- Grade DataGrid Fluida -->
                    <DataGrid x:Name="GridBancoDados" Grid.Row="2"
                              Style="{StaticResource DarkDataGrid}"
                              ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}"
                              CellStyle="{StaticResource DarkDataGridCell}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              SelectionMode="Extended"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              CellEditEnding="GridBancoDados_CellEditEnding"
                              SelectionChanged="GridBancoDados_SelectionChanged">
                        <DataGrid.Columns>
                            <!-- ID -->
                            <DataGridTextColumn Header="#" Width="60" Binding="{Binding ID}" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#513BA6"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Nº de Patrimônio (edição manual inline) -->
                            <DataGridTextColumn Header="Nº Patrimônio" Width="140" Binding="{Binding Patrimonio, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFB703"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                        <Setter Property="ToolTip" Value="Clique na celula e digite o numero de patrimonio. Click duplo abre a edicao completa."/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#0A0A0F"/>
                                        <Setter Property="Foreground" Value="#FFB703"/>
                                        <Setter Property="BorderBrush" Value="#513BA6"/>
                                        <Setter Property="CaretBrush" Value="#FFB703"/>
                                        <Setter Property="SelectionBrush" Value="#513BA6"/>
                                        <Setter Property="Padding" Value="6,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Marca e Modelo -->
                            <DataGridTextColumn Header="Fabricante / Modelo" Width="1.2*" Binding="{Binding MarcaModelo}" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E3E0F2"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Serial -->
                            <DataGridTextColumn Header="N/S (Número de Série)" Width="1.2*" Binding="{Binding Serial}" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#5EB1FF"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- MAC Address -->
                            <DataGridTextColumn Header="MAC Address (Wi-Fi)" Width="1.1*" Binding="{Binding MAC}" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#4EDEA3"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#23174A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A1A2E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Barra Inferior de Ações -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Detalhes do item selecionado -->
                        <Border Grid.Column="0" Background="#0A0A0F" BorderBrush="#202035" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtInfoSelecionado" Text="Nenhum registro selecionado" Foreground="#85859E" FontSize="11" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Botões CRUD -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="➕ Novo" Background="#513BA6" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="12,6" Width="85" Cursor="Hand" Click="BtnNovoDispositivo_Click"/>
                            <Button Content="✏️ Editar" Background="#2A2A40" Foreground="#5EB1FF" FontWeight="Bold" BorderThickness="1" BorderBrush="#5EB1FF" Padding="12,6" Width="90" Cursor="Hand" Margin="6,0,0,0" Click="BtnEditarDispositivo_Click"/>
                            <Button Content="🗑️ Excluir" Background="#E63946" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="12,6" Width="90" Cursor="Hand" Margin="6,0,0,0" Click="BtnExcluir_Click"/>
                            <Button Content="📊 Excel" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" BorderThickness="1" Padding="12,6" Width="80" Cursor="Hand" Margin="6,0,0,0" Click="BtnExportarExcel_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 3: REGISTROS & AUDITORIA COM LEITOR DE LOG INTEGRADO -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelRegistros" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📝 Central de Registros &amp; Auditoria de Builds" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Histórico completo de auditoria gravado no sistema (/registros). Selecione um registro para inspecionar o log." Foreground="#85859E" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="🔄 Recarregar" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" BorderThickness="1" Padding="10,5" Cursor="Hand" Click="BtnRecarregarLogs_Click" Margin="0,0,6,0"/>
                            <Button Content="📁 Abrir Pasta no Explorer" Background="#0A0A0F" Foreground="#4EDEA3" BorderBrush="#4EDEA3" BorderThickness="1" Padding="10,5" Cursor="Hand" Click="BtnAbrirPastaRegistros_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Split-View: Lista à Esquerda (40%) | Leitor de Log à Direita (60%) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lado Esquerdo: Lista de Sessões/Pastas de Registros -->
                        <Border Grid.Column="0" Background="#0A0A0F" CornerRadius="8" BorderBrush="#202035" BorderThickness="1" Padding="2">
                            <ListView x:Name="ListRegistros" Background="Transparent" Foreground="#E3E0F2" BorderThickness="0" SelectionChanged="ListRegistros_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Data" Width="90" DisplayMemberBinding="{Binding Data}"/>
                                        <GridViewColumn Header="Nome do Registro" Width="180" DisplayMemberBinding="{Binding Nome}"/>
                                        <GridViewColumn Header="Tipo" Width="90" DisplayMemberBinding="{Binding Tipo}"/>
                                    </GridView>
                                </ListView.View>
                                <ListView.Resources>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#161628"/>
                                        <Setter Property="Foreground" Value="#8570E6"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#2A2A40"/>
                                    </Style>
                                </ListView.Resources>
                            </ListView>
                        </Border>

                        <!-- Lado Direito: Visualizador de Log Integrado -->
                        <Border Grid.Column="2" Background="#0A0A0F" CornerRadius="8" BorderBrush="#202035" BorderThickness="1" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Barra Superior do Log -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtLogHeaderTitle" Text="Selecione um registro ao lado para visualizar" Foreground="#8570E6" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="📋 Copiar Log" Background="#151525" Foreground="#E3E0F2" BorderBrush="#2A2A40" BorderThickness="1" Padding="8,3" FontSize="11" Cursor="Hand" Click="BtnCopiarLog_Click" Margin="0,0,6,0"/>
                                        <Button Content="📄 Bloco de Notas" Background="#151525" Foreground="#E3E0F2" BorderBrush="#2A2A40" BorderThickness="1" Padding="8,3" FontSize="11" Cursor="Hand" Click="BtnAbrirBlocoNotas_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Caixa de Texto do Log -->
                                <TextBox x:Name="TxtLogViewer" Grid.Row="1" Background="#05050A" Foreground="#4EDEA3" BorderBrush="#151525" BorderThickness="1" 
                                         FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                                         Padding="8" Text="[Selecione um registro na lista ao lado para inspecionar os detalhes de compilação ou automação...]"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 4: EXPORTAÇÃO & EMISSÃO DE DADOS -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelExportacao" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho com Segmented Pill (Relatório de Dados vs Tags QR) -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="📤 Central de Exportação &amp; Documentos" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Emissão de relatórios em PDF formatado, planilhas e geração de etiquetas patrimoniais com QR Code." Foreground="#85859E" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Alternador de Abas Internas -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0A0A0F" CornerRadius="6" Padding="3" BorderBrush="#23233A" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnTabRelDados" Content="📄 Relatório de Dados" Padding="12,5" Click="BtnTabRelDados_Click" Background="#513BA6" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Cursor="Hand"/>
                                <Button x:Name="BtnTabRelQRCode" Content="🏷️ Tags QR Code" Padding="12,5" Click="BtnTabRelQRCode_Click" Background="Transparent" Foreground="#85859E" FontWeight="Bold" FontSize="12" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- CONTEÚDO 1: RELATÓRIO DE DADOS (PDF & EXCEL) -->
                    <Grid x:Name="SubPanelRelDados" Grid.Row="1" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lado Esquerdo: Busca e Seleção Múltipla -->
                        <Border Grid.Column="0" Background="#0A0A0F" BorderBrush="#202035" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Buscar &amp; Selecionar Aparelhos:" Foreground="#A1A1AA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtBuscaAparelho" Grid.Row="1" Background="#151525" Foreground="#E3E0F2" BorderBrush="#513BA6" Padding="8,6" TextChanged="TxtBuscaAparelho_TextChanged" Margin="0,0,0,8" FontSize="12"/>

                                <!-- Lista com CheckBoxes -->
                                <ListView x:Name="ListBuscaAparelhos" Grid.Row="2" Background="#151525" BorderBrush="#202035" BorderThickness="1" Foreground="#E3E0F2">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Width="38">
                                                <GridViewColumn.Header>
                                                    <CheckBox x:Name="ChkSelecionarTodos" Click="ChkSelecionarTodos_Click" ToolTip="Selecionar Todos"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="ChkItem_Click"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Modelo" DisplayMemberBinding="{Binding Dispositivo.MarcaModelo}" Width="110"/>
                                            <GridViewColumn Header="Serial" DisplayMemberBinding="{Binding Dispositivo.Serial}" Width="110"/>
                                            <GridViewColumn Header="MAC" DisplayMemberBinding="{Binding Dispositivo.MAC}" Width="120"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <!-- Botões Rápidos de Seleção em Lote -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Selecionar Todos" Background="#151525" Foreground="#E3E0F2" BorderBrush="#2A2A40" BorderThickness="1" Padding="8,4" FontSize="11" Cursor="Hand" Click="BtnSelecionarTodos_Click" Margin="0,0,6,0"/>
                                    <Button Content="Inverter" Background="#151525" Foreground="#E3E0F2" BorderBrush="#2A2A40" BorderThickness="1" Padding="8,4" FontSize="11" Cursor="Hand" Click="BtnInverterSelecao_Click" Margin="0,0,6,0"/>
                                    <Button Content="Limpar" Background="#151525" Foreground="#FF5C5C" BorderBrush="#2A2A40" BorderThickness="1" Padding="8,4" FontSize="11" Cursor="Hand" Click="BtnLimparSelecao_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Lado Direito: Carrinho de Selecionados e Botões de Emissão -->
                        <Border Grid.Column="2" Background="#0A0A0F" BorderBrush="#202035" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LblQtdSelecionados" Text="0 aparelhos selecionados" Foreground="#4EDEA3" FontWeight="Bold" FontSize="13" Margin="0,0,0,2"/>
                                <TextBlock Text="Deixe a seleção vazia para emitir todos os registros da base automaticamente." Foreground="#85859E" FontSize="11" Margin="0,0,0,8" Grid.Row="1"/>

                                <ListView x:Name="ListSelecionados" Grid.Row="2" Background="#151525" BorderBrush="#202035" BorderThickness="1" Foreground="#E3E0F2" Margin="0,0,0,12">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Modelo" DisplayMemberBinding="{Binding Dispositivo.MarcaModelo}" Width="120"/>
                                            <GridViewColumn Header="Serial" DisplayMemberBinding="{Binding Dispositivo.Serial}" Width="120"/>
                                            <GridViewColumn Width="40">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="✕" Background="Transparent" Foreground="#FF5C5C" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnRemoverSelecionado_Click"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <!-- Botões de Emissão -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="🖨️ Emitir PDF A4" Background="#4EDEA3" Foreground="#0B0B13" FontWeight="Bold" BorderThickness="0" Padding="14,8" Cursor="Hand" Click="BtnEmitirRelDadosPDF_Click" Margin="0,0,8,0"/>
                                    <Button Content="📊 Planilha Excel" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#513BA6" BorderThickness="1" Padding="14,8" Cursor="Hand" Click="BtnExportarExcel_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- CONTEÚDO 2: RELATÓRIO DE TAGS QR CODE -->
                    <Grid x:Name="SubPanelRelQRCode" Grid.Row="1" Visibility="Collapsed">
                        <Border Background="#0A0A0F" BorderBrush="#202035" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Geração de Etiquetas Patrimoniais Térmicas (6cm x 3cm)" Foreground="#E3E0F2" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="Formato de impressão em etiqueta contínua: QR Code em alta definição contendo Serial + MAC + Fabricante à esquerda e dados técnicos à direita." Foreground="#85859E" FontSize="12" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                <!-- Card de Preview Visual da Etiqueta -->
                                <Border Background="#151525" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="#23233A" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Prévia da Etiqueta (Dimensões Reais: 60mm x 30mm):" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,8"/>
                                        <Border BorderBrush="#513BA6" BorderThickness="1" CornerRadius="6" Width="260" Height="120" HorizontalAlignment="Left" Background="#0B0B13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- QR Lado Esquerdo -->
                                                <Border Grid.Column="0" Background="#111120" CornerRadius="6,0,0,6">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Border Background="#1E1E30" Width="70" Height="70" CornerRadius="4">
                                                            <TextBlock Text="QR CODE" Foreground="#8570E6" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Bot_RPA" Foreground="#85859E" FontSize="8" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Dados Lado Direito -->
                                                <Border Grid.Column="1" BorderBrush="#202035" BorderThickness="1,0,0,0" Padding="8,4">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="MOD: Tab Vision 7" Foreground="#FFFFFF" FontSize="8.5" FontWeight="Bold"/>
                                                        <TextBlock Text="N/S: T30764..." Foreground="#5EB1FF" FontSize="8" FontFamily="Consolas" Margin="0,2,0,0"/>
                                                        <TextBlock Text="MAC: AA:BB:CC:DD" Foreground="#4EDEA3" FontSize="8" FontFamily="Consolas" Margin="0,2,0,0"/>
                                                        <Border Background="#513BA6" CornerRadius="2" Padding="4,1" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                            <TextBlock Text="Plataforma Bot_RPA" Foreground="#FFFFFF" FontSize="7" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Botões de Ação para Tags QR -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🖨️ Imprimir Tags QR Code" Background="#513BA6" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="18,10" Cursor="Hand" Click="BtnGerarEtiquetas_Click" Margin="0,0,10,0"/>
                                    <Button Content="🏷️ Filtrar por Modelo p/ Tags" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" BorderThickness="1" Padding="16,10" Cursor="Hand" Click="BtnFiltrarParaTags_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- MODAL OVERLAY DE CRIAÇÃO / EDIÇÃO DE DISPOSITIVO -->
        <!-- ========================================================================= -->
        <Grid x:Name="PanelModalRegistroSerie" Grid.ColumnSpan="3" Background="#DD0B0B13" Visibility="Collapsed">
            <Border Background="#151525" BorderBrush="#4EDEA3" BorderThickness="1.5" CornerRadius="12" Width="840" Height="590" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22">
                <Border.Effect>
                    <DropShadowEffect Color="#4EDEA3" BlurRadius="28" Opacity="0.28" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="REGISTRO EM SÉRIE DE APARELHOS" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtStatusRegistroSerie" Text="Monitorando tablets conectados..." Foreground="#85859E" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0A0A0F" BorderBrush="#2A2A40" BorderThickness="1" CornerRadius="6" Padding="10,5">
                            <TextBlock x:Name="TxtContadorRegistroSerie" Text="0 registrados" Foreground="#4EDEA3" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="#0A0A0F" BorderBrush="#202035" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SERIAL DO APARELHO ATUAL" Foreground="#85859E" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtRegistroSerial" Text="-" Foreground="#5EB1FF" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MAC CAPTURADO" Foreground="#85859E" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtRegistroMac" Text="-" Foreground="#4EDEA3" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Nº PATRIMÔNIO" Foreground="#85859E" FontSize="10" FontWeight="Bold"/>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#1A1A2E" BorderBrush="#2A2A40" BorderThickness="1" CornerRadius="6,0,0,6" Padding="8,5">
                                        <TextBlock Text="INV" Foreground="#FFB703" FontFamily="Consolas" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <TextBox x:Name="TxtRegistroPatrimonio" Grid.Column="1" Background="#0A0A0F" Foreground="#FFB703" FontFamily="Consolas" BorderBrush="#2A2A40" Padding="8,5" FontSize="12" IsEnabled="False" KeyDown="TxtRegistroPatrimonio_KeyDown" ToolTip="Digite apenas os numeros. Ex.: 425 -> INV425"/>
                                </Grid>
                            </StackPanel>
                            <Button x:Name="BtnRegistrarPatrimonio" Grid.Column="6" Content="Registrar" Background="#4EDEA3" Foreground="#0B0B13" FontWeight="Bold" BorderThickness="0" Padding="14,7" Cursor="Hand" IsEnabled="False" VerticalAlignment="Bottom" Click="BtnRegistrarPatrimonio_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0A0A0F" BorderBrush="#202035" BorderThickness="1" CornerRadius="8" Padding="8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="TABLETS CAPTURADOS" Foreground="#8570E6" FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                                <DataGrid x:Name="GridRegistroSerie" Style="{StaticResource DarkDataGrid}" ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Serial" Width="1.2*" Binding="{Binding Serial}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#5EB1FF"/>
                                                    <Setter Property="FontFamily" Value="Consolas"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="6,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="MAC" Width="1.2*" Binding="{Binding MAC}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#4EDEA3"/>
                                                    <Setter Property="FontFamily" Value="Consolas"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="6,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Situação" Width="1*" Binding="{Binding Status}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#A1A1AA"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="6,0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Registrado}" Value="True">
                                                            <Setter Property="Foreground" Value="#4EDEA3"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Patrimônio" Width="0.9*" Binding="{Binding Patrimonio}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFB703"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="6,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#0A0A0F" BorderBrush="#202035" BorderThickness="1" CornerRadius="8" Padding="8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="LINHA DE COMANDOS / CAPTURA" Foreground="#8570E6" FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                                <TextBox x:Name="TxtLogRegistroSerie" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" Background="#07070B" Foreground="#4EDEA3" BorderBrush="#202035" BorderThickness="1" Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnPularRegistro" Content="Pular Aparelho" Background="#2A2A40" Foreground="#FFB703" FontWeight="Bold" BorderThickness="1" BorderBrush="#FFB703" Padding="14,7" Cursor="Hand" IsEnabled="False" Click="BtnPularRegistro_Click"/>
                            <Button Content="Reiniciar Captura" Background="#2A2A40" Foreground="#5EB1FF" FontWeight="Bold" BorderThickness="1" BorderBrush="#5EB1FF" Padding="14,7" Cursor="Hand" Margin="8,0,0,0" Click="BtnReiniciarCapturaRegistro_Click"/>
                        </StackPanel>
                        <Button Content="Fechar" HorizontalAlignment="Right" Background="#0A0A0F" Foreground="#E3E0F2" FontWeight="Bold" BorderThickness="1" BorderBrush="#2A2A40" Padding="18,7" Cursor="Hand" Click="BtnFecharRegistroSerie_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="O registro e feito um aparelho por vez. Conecte o tablet, aguarde o MAC e informe o patrimonio para gravar no banco."
                               Foreground="#5A5A72" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="PanelModalEditDevice" Grid.ColumnSpan="3" Background="#DD0B0B13" Visibility="Collapsed">
            <Border Background="#151525" BorderBrush="#513BA6" BorderThickness="1.5" CornerRadius="12" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#513BA6" BlurRadius="25" Opacity="0.35" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtModalTitulo" Text="➕ Adicionar Novo Dispositivo" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <TextBlock Text="Nº de Patrimônio (somente números):" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#1A1A2E" BorderBrush="#2A2A40" BorderThickness="1" CornerRadius="6,0,0,6" Padding="10,6">
                            <TextBlock Text="INV" Foreground="#FFB703" FontFamily="Consolas" FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <TextBox x:Name="TxtModalPatrimonio" Grid.Column="1" Background="#0A0A0F" Foreground="#FFB703" FontFamily="Consolas" BorderBrush="#2A2A40" Padding="8,6" FontSize="12" ToolTip="Digite apenas os números. Ex.: 425 → INV425"/>
                    </Grid>

                    <TextBlock Text="Fabricante:" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtModalFabricante" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" Padding="8,6" Margin="0,0,0,10" FontSize="12"/>

                    <TextBlock Text="Modelo:" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtModalModelo" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" Padding="8,6" Margin="0,0,0,10" FontSize="12"/>

                    <TextBlock Text="N/S (Número de Série):" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtModalSerial" Background="#0A0A0F" Foreground="#5EB1FF" FontFamily="Consolas" BorderBrush="#2A2A40" Padding="8,6" Margin="0,0,0,10" FontSize="12"/>

                    <TextBlock Text="MAC Address:" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtModalMAC" Background="#0A0A0F" Foreground="#4EDEA3" FontFamily="Consolas" BorderBrush="#2A2A40" Padding="8,6" Margin="0,0,0,18" FontSize="12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕ Cancelar" Background="Transparent" Foreground="#A1A1AA" BorderThickness="0" Padding="14,6" Cursor="Hand" Margin="0,0,8,0" Click="BtnModalCancelar_Click"/>
                        <Button Content="💾 Salvar Dispositivo" Background="#4EDEA3" Foreground="#0B0B13" FontWeight="Bold" BorderThickness="0" Padding="16,6" Cursor="Hand" Click="BtnModalSalvar_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
