<UserControl x:Class="InnovPlayUI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Estilo dos Botões de Navegação entre Abas da Central de Ajuda -->
        <Style x:Key="SubTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#151525"/>
            <Setter Property="Foreground" Value="#8A8A9E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10,16,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#2A2A40"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#23233A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSubTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SubTabButtonStyle}">
            <Setter Property="Background" Value="#513BA6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Principal da Documentação da Plataforma -->
        <Border Grid.Row="0" Background="#111120" CornerRadius="12" Padding="25" Margin="0,0,0,15" BorderBrush="#513BA6" BorderThickness="1.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#513BA6" CornerRadius="6" Padding="8,3,8,3" Margin="0,0,10,0">
                            <TextBlock Text="CENTRAL DE AJUDA &amp; DOCUMENTAÇÃO" Foreground="#FFFFFF" FontSize="11" FontWeight="Black"/>
                        </Border>
                        <Border Background="#064E3B" CornerRadius="6" Padding="8,3,8,3" Margin="0,0,10,0">
                            <TextBlock Text="✓ GUIA DE MÓDULOS" Foreground="#00F5D4" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#1E3A8A" CornerRadius="6" Padding="8,3,8,3">
                            <TextBlock Text="❓ FAQ &amp; DÚVIDAS" Foreground="#00E5FF" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Plataforma InnovPlay RPA — Guia do Usuário" Foreground="#FFFFFF" FontSize="24" FontWeight="Black"/>
                    <TextBlock Text="Aprenda o que procurar, onde encontrar cada módulo e como resolver as dúvidas mais comuns do sistema." 
                               Foreground="#A1A1AA" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#191930" CornerRadius="10" Padding="15" VerticalAlignment="Center" BorderBrush="#2A2A40" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="VERSÃO EM EXECUÇÃO" Foreground="#8A8A9E" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtAboutVersion" Text="v18.08.2026.1714" Foreground="#4EDEA3" FontSize="15" FontWeight="Black" Margin="0,4,0,2" HorizontalAlignment="Center" FontFamily="Consolas"/>
                        <TextBlock Text="Plataforma InnovTech" Foreground="#7A7A8A" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Sub-Barra de Navegação em Abas da Central de Ajuda -->
        <Border Grid.Row="1" Background="#151525" CornerRadius="10" Padding="8" Margin="0,0,0,15" BorderBrush="#23233A" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnTabGuide" Content="🗺️  Guia de Módulos (Onde Procurar)" Style="{StaticResource ActiveSubTabButtonStyle}" Click="BtnTabGuide_Click"/>
                <Button x:Name="BtnTabFaq" Content="❓  Central de Dúvidas (FAQ)" Style="{StaticResource SubTabButtonStyle}" Click="BtnTabFaq_Click"/>
                <Button x:Name="BtnTabTech" Content="🛡️  Arquitetura &amp; Licenciamento" Style="{StaticResource SubTabButtonStyle}" Click="BtnTabTech_Click"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo Principal Dinâmico por Abas -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,15,0">

                <!-- ========================================================================================= -->
                <!-- ABA 1: GUIA DE MÓDULOS ("O QUE É & ONDE PROCURAR?") -->
                <!-- ========================================================================================= -->
                <StackPanel x:Name="PanelGuide" Visibility="Visible">
                    
                    <Border Background="#151525" CornerRadius="10" Padding="20" Margin="0,0,0,15" BorderBrush="#513BA6" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🗺️ Mapa de Funcionalidades — O que procurar e onde encontrar no Inno RPA" Foreground="#00E5FF" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="Esta seção serve como seu mapa de navegação rápido. Veja abaixo a finalidade de cada menu e onde localizá-lo." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Módulo 1: Monitor ADB -->
                    <Border Background="#151525" CornerRadius="10" Padding="20" Margin="0,0,0,15" BorderBrush="#2A2A40" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="10" Background="#1E1E35" Margin="0,0,18,0" BorderBrush="#00F5D4" BorderThickness="1">
                                <TextBlock Text="📱" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="1. Monitor ADB (USB)" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                                    <Border Background="#064E3B" CornerRadius="4" Padding="6,2,6,2" Margin="12,0,0,0">
                                        <TextBlock Text="ONDE FICA: Menu Superior ➔ 'Monitor ADB (USB)'" Foreground="#00F5D4" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="• O que é: O centro de comando principal para provisionar tablets conectados via cabo USB." Foreground="#E3E0F2" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                <TextBlock Text="• O que procurar aqui: Botão 'Listar Dispositivos ADB', seleção do município desejado, botões de esteira F1 a F8 (Instalação, Reinstalação, Kiosk, Desligamento) e log de acompanhamento ao vivo." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Módulo 2: InnoLearn IA -->
                    <Border Background="#151525" CornerRadius="10" Padding="20" Margin="0,0,0,15" BorderBrush="#2A2A40" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="10" Background="#1E1E35" Margin="0,0,18,0" BorderBrush="#00E5FF" BorderThickness="1">
                                <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="2. InnoLearn IA (Motor Adaptativo Heurístico)" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                                    <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2,6,2" Margin="12,0,0,0">
                                        <TextBlock Text="ONDE FICA: Menu Superior ➔ '⚡ InnoLearn IA'" Foreground="#00E5FF" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="• O que é: O módulo de inteligência artificial que aprende as posições e centróides da tela do Android." Foreground="#E3E0F2" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                <TextBlock Text="• O que procurar aqui: Tabela de centróides aprendidos (X, Y), taxa de acerto (Hits/Misses), botão para recarregar base neural e o botão '🌌 Visualizar Mapa Neural 2D' para abrir a janela holográfica." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Módulo 3: Relatórios e Registros -->
                    <Border Background="#151525" CornerRadius="10" Padding="20" Margin="0,0,0,15" BorderBrush="#2A2A40" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="10" Background="#1E1E35" Margin="0,0,18,0" BorderBrush="#FFB703" BorderThickness="1">
                                <TextBlock Text="📜" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="3. Relatórios e Registros Auditoria" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                                    <Border Background="#78350F" CornerRadius="4" Padding="6,2,6,2" Margin="12,0,0,0">
                                        <TextBlock Text="ONDE FICA: Menu Superior ➔ 'Relatórios e Registros'" Foreground="#FFB703" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="• O que é: O histórico completo de todas as execuções realizadas em cada tablet." Foreground="#E3E0F2" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                <TextBlock Text="• O que procurar aqui: Tabela detalhada por data/hora, número de série do tablet, município aplicado, status de sucesso/erro e botões para exportar registros em relatório." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Módulo 4: Configurações e OTA -->
                    <Border Background="#151525" CornerRadius="10" Padding="20" Margin="0,0,0,15" BorderBrush="#2A2A40" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="10" Background="#1E1E35" Margin="0,0,18,0" BorderBrush="#513BA6" BorderThickness="1">
                                <TextBlock Text="⚙️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="4. Configurações &amp; Atualização OTA Remote" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                                    <Border Background="#3B0764" CornerRadius="4" Padding="6,2,6,2" Margin="12,0,0,0">
                                        <TextBlock Text="ONDE FICA: Menu Superior ➔ 'Configurações' ➔ '🔄 Atualização OTA'" Foreground="#C084FC" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="• O que é: O painel de opções de rede, modelo de aparelhos cadastrados, backup de dados e sistema de atualizações remotas via nuvem (Firebase)." Foreground="#E3E0F2" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                <TextBlock Text="• O que procurar aqui: Na opção '🔄 Atualização OTA', você consulta se há novas compilações lançadas na nuvem, faz o download automático e instala com 1 clique." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Módulo 5: Script de Atualizações do Desenvolvedor -->
                    <Border Background="#151525" CornerRadius="10" Padding="20" Margin="0,0,0,15" BorderBrush="#2A2A40" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="10" Background="#1E1E35" Margin="0,0,18,0" BorderBrush="#FF4D6D" BorderThickness="1">
                                <TextBlock Text="🛠️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="5. Ferramenta de Geração de Releases (Desenvolvedor)" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                                    <Border Background="#831843" CornerRadius="4" Padding="6,2,6,2" Margin="12,0,0,0">
                                        <TextBlock Text="ONDE FICA: Pasta 'controle/' na raiz do seu projeto" Foreground="#F472B6" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="• O que é: O script de automação para você (administrador) gerar novos pacotes `.ZIP` de atualização para disponibilizar aos clientes via OTA." Foreground="#E3E0F2" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                <TextBlock Text="• O que procurar aqui: Execute o arquivo controle/Atualizacao.bat. Ele gerará a nova versão baseada em Data+Hora e criará o arquivo controle/InnoRPA_v[data.hora].zip pronto para enviar no Painel Web (web/ota_dashboard.html)." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>


                <!-- ========================================================================================= -->
                <!-- ABA 2: CENTRAL DE DÚVIDAS FREQUENTES (FAQ) -->
                <!-- ========================================================================================= -->
                <StackPanel x:Name="PanelFaq" Visibility="Collapsed">
                    
                    <Border Background="#151525" CornerRadius="10" Padding="20" Margin="0,0,0,15" BorderBrush="#00E5FF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="❓ Central de Dúvidas Frequentes (Perguntas &amp; Respostas)" Foreground="#00E5FF" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="Encontre respostas objetivas para as dúvidas e situações mais comuns durante o uso do Inno RPA." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- FAQ 1 -->
                    <Border Background="#151525" CornerRadius="10" Padding="18" Margin="0,0,0,12" BorderBrush="#2A2A40" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="P: O que fazer se um tablet conectado no cabo USB não aparecer na lista do Monitor ADB?" Foreground="#4EDEA3" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="R: Siga estes passos de verificação rápida:" Foreground="#E3E0F2" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="  1. Certifique-se de que a 'Depuração USB' está ATIVADA no Android (Configurações ➔ Opções do Desenvolvedor ➔ Depuração USB)." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock Text="  2. Verifique se o cabo USB transmite DADOS (evite cabos exclusivamente para carregamento)." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock Text="  3. Olhe para a tela do tablet e confirme se apareceu a mensagem de autorização 'Permitir depuração USB neste computador?'. Marque 'Sempre permitir' e clique em OK." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- FAQ 2 -->
                    <Border Background="#151525" CornerRadius="10" Padding="18" Margin="0,0,0,12" BorderBrush="#2A2A40" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="P: Como funciona o sistema de Atualização Remota via OTA?" Foreground="#4EDEA3" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="R: Em Configurações ➔ 🔄 Atualização OTA, clique em 'Verificar Atualizações'. O Inno RPA consultará o servidor Firebase na nuvem. Caso exista uma versão mais recente do que a sua, o botão '⚡ Instalar Atualização Agora' ficará verde. Ao clicar nele, o aplicativo baixa os arquivos, fecha sozinho, substitui os executáveis e reinicia atualizado." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <!-- FAQ 3 -->
                    <Border Background="#151525" CornerRadius="10" Padding="18" Margin="0,0,0,12" BorderBrush="#2A2A40" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="P: Os meus bancos de dados, cadastros ou configurações serão apagados na atualização OTA?" Foreground="#4EDEA3" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="R: NUNCA! O atualizador OTA substitui apenas os arquivos executáveis e motores de código (InnoRPAui.exe e InnoEngine.dll). Todos os seus bancos de dados (inno_database.db), arquivos de configuração (settings.json) e cadastros de municípios permanecem 100% intactos e preservados." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <!-- FAQ 4 -->
                    <Border Background="#151525" CornerRadius="10" Padding="18" Margin="0,0,0,12" BorderBrush="#2A2A40" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="P: Como saber qual a versão exata do meu Inno RPA?" Foreground="#4EDEA3" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="R: O Inno RPA utiliza o sistema de versões baseadas em data + hora da compilação (ex: v18.08.2026.1714). Você pode conferir a sua versão exata em três locais: no título da janela no topo do Windows, na pílula roxa no canto superior direito do menu principal, ou no painel de Configurações ➔ Atualização OTA." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <!-- FAQ 5 -->
                    <Border Background="#151525" CornerRadius="10" Padding="18" Margin="0,0,0,12" BorderBrush="#2A2A40" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="P: Onde adiciono novos pacotes de municípios ou arquivos APK?" Foreground="#4EDEA3" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="R: Basta colocar as pastas dos novos municípios em 'data/input/municipios/' e os arquivos APK em 'data/input/apps/'. O robô irá listar e reconhecer os novos arquivos imediatamente na tela de Monitor USB sem precisar reiniciar a aplicação." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <!-- FAQ 6 -->
                    <Border Background="#151525" CornerRadius="10" Padding="18" Margin="0,0,0,12" BorderBrush="#2A2A40" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="P: O que é o sistema Anti-Crash Guard do Inno RPA?" Foreground="#4EDEA3" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="R: É um guardião triplo de resiliência que previne travamentos. Ele monitora falhas na interface gráfica em C#, captura exceções de memória no motor DLL em C e monitora o tablet via Watchdog. Se um aplicativo fechar por falta de RAM no tablet, o Inno o relança automaticamente sem abortar o lote de trabalho." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                </StackPanel>


                <!-- ========================================================================================= -->
                <!-- ABA 3: ARQUITETURA, ENGENHARIA & LICENCIAMENTO -->
                <!-- ========================================================================================= -->
                <StackPanel x:Name="PanelTech" Visibility="Collapsed">
                    
                    <!-- MÓDULO VISÃO GERAL -->
                    <Border Background="#151525" CornerRadius="10" Padding="22" Margin="0,0,0,18" BorderBrush="#2A2A40" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="⚡" FontSize="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Módulo Tecnológico: Visão Geral da Arquitetura" Foreground="#4EDEA3" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="O InnovPlay RPA (Metatron Engine) é uma plataforma industrial de Automação Robótica de Processos (RPA) desenvolvida para orquestrar, configurar e testar dispositivos Android nativos (Tablets e Totens)." Foreground="#E3E0F2" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,10"/>
                            <TextBlock Text="A ferramenta opera via ADB (Android Debug Bridge) em C nativo Win32, permitindo o provisionamento em massa sem dependência de internet durante as rotinas robóticas." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <!-- DESTAQUE IA INNOLEARN -->
                    <Border Background="#0F1428" CornerRadius="12" Padding="24" Margin="0,0,0,18" BorderBrush="#00E5FF" BorderThickness="1.5">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧠" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Motor Heurístico InnoLearn IA (C Nativo)" Foreground="#00E5FF" FontSize="18" FontWeight="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#0A2235" CornerRadius="6" Padding="8,4,8,4" BorderBrush="#00E5FF" BorderThickness="1">
                                    <TextBlock Text="TECNOLOGIA PATENTEAR" Foreground="#00E5FF" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Border Background="#151D36" CornerRadius="8" Padding="15" Margin="0,0,8,10" BorderBrush="#203058" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🎯 Leitura de Centróides XML" Foreground="#00F5D4" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBlock Text="Extrai a árvore da interface gráfica do tablet em tempo real e calcula centróides (X,Y) via inno_normalize_char." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151D36" CornerRadius="8" Padding="15" Margin="8,0,0,10" BorderBrush="#203058" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📈 Score Heurístico Dinâmico" Foreground="#FFB703" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBlock Text="Cada seletor visual é ranqueado por acertos (Hits) e falhas (Misses), refinando a navegação continuamente." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151D36" CornerRadius="8" Padding="15" Margin="0,0,8,0" BorderBrush="#203058" BorderThickness="1">
                                    <StackPanel>
