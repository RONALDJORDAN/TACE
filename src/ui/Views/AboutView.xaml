                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Motor nativo" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="C puro · BotEngine.dll" Style="{StaticResource DataValue}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="I/O crítico, ADB Fast-Track, túneis, comandos e baixa latência." Style="{StaticResource MutedText}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Persistência" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="SQLite" Style="{StaticResource DataValue}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Microsoft.Data.Sqlite 8.0.0 · banco local data/bot_database.db." Style="{StaticResource MutedText}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Documentos" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="PdfSharpCore · QRCoder" Style="{StaticResource DataValue}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="PdfSharpCore 1.3.67 para PDF executivo; QRCoder 1.8.0 para etiquetas." Style="{StaticResource MutedText}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Comunicação" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="ADB / USB" Style="{StaticResource DataValue}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Comandos, shell, captura de tela, árvore UI XML e transferência de pacotes." Style="{StaticResource MutedText}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Plataforma alvo" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Windows 11+" Style="{StaticResource DataValue}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Requisito mínimo aplicado na inicialização do aplicativo." Style="{StaticResource MutedText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Isolamento por equipamento (Regra de Ouro)" Style="{StaticResource SectionTitle}" Foreground="#4EDEA3"/>
                                <TextBlock Text="Cada modelo homologado possui pipeline próprio, evitando efeitos colaterais entre fabricantes:" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="3">
                                    <Border Background="#121220" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Positivo" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="Tab Vision 7" Foreground="#8570E6" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,4"/>
                                            <TextBlock Text="v7_pipeline.c · rotinas dedicadas" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#121220" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Multilaser" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="TabMulti M7" Foreground="#8570E6" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,4"/>
                                            <TextBlock Text="m7_pipeline.c · rotinas dedicadas" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#121220" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Nokia" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="T20" Foreground="#8570E6" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,4"/>
                                            <TextBlock Text="t20_pipeline.c · rotinas dedicadas" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Segurança, rastreabilidade e integridade" Style="{StaticResource SectionTitle}" Foreground="#5EB1FF"/>
                                <TextBlock Text="• Credenciais sensíveis protegidas com DPAPI no armazenamento local." Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <TextBlock Text="• Auditoria de cadastro, build, execução, OTA e sistema em banco SQLite." Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <TextBlock Text="• Registros técnicos organizados por data e modalidade em docs/registros." Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <TextBlock Text="• Verificação de integridade e reparo automático na inicialização (Preflight)." Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <TextBlock Text="• Isolamento de pipelines por modelo para reduzir risco operacional." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Estrutura de dados e caminhos" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
