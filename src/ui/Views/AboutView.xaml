<UserControl x:Class="InnovPlayUI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1000"
             Background="Transparent">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Principal da Documentação da Plataforma -->
        <Border Grid.Row="0" Background="#111120" CornerRadius="12" Padding="25" Margin="0,0,0,20" BorderBrush="#513BA6" BorderThickness="1.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#513BA6" CornerRadius="6" Padding="8,3,8,3" Margin="0,0,10,0">
                            <TextBlock Text="DOCUMENTAÇÃO TÉCNICA" Foreground="#FFFFFF" FontSize="11" FontWeight="Black"/>
                        </Border>
                        <Border Background="#064E3B" CornerRadius="6" Padding="8,3,8,3" Margin="0,0,10,0">
                            <TextBlock Text="✓ ENGINE C NATIVO" Foreground="#00F5D4" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#1E3A8A" CornerRadius="6" Padding="8,3,8,3">
                            <TextBlock Text="🧠 IA ADAPTATIVA INNOLEARN" Foreground="#00E5FF" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Plataforma InnovPlay RPA — Metatron Engine" Foreground="#FFFFFF" FontSize="26" FontWeight="Black"/>
                    <TextBlock Text="Arquitetura de Automação Robótica em Baixo Nível Win32/Android, Inteligência Neural e Resiliência Anti-Crash" 
                               Foreground="#A1A1AA" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#191930" CornerRadius="10" Padding="15" VerticalAlignment="Center" BorderBrush="#2A2A40" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="VERSÃO DA PLATAFORMA" Foreground="#8A8A9E" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="v7.4.0 High-Octane" Foreground="#4EDEA3" FontSize="16" FontWeight="Black" Margin="0,4,0,2" HorizontalAlignment="Center"/>
                        <TextBlock Text="Build: 2026-08-06 (Release/Test)" Foreground="#7A7A8A" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Conteúdo Scrollável com Módulos Informativos Completos -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,15,0">
                
                <!-- MÓDULO 1: O QUE É E PROPÓSITO -->
                <Border Background="#151525" CornerRadius="10" Padding="22" Margin="0,0,0,18" BorderBrush="#2A2A40" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚡" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Módulo 1: Visão Geral e Propósito do Sistema" Foreground="#4EDEA3" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="O InnovPlay RPA (Metatron Engine) é uma plataforma industrial de Automação Robótica de Processos (RPA) desenvolvida sob medida para orquestrar, configurar, implantar pacotes e realizar testes de estresse automatizados diretamente em dispositivos Android nativos (Tablets e Totens)."
                                   Foreground="#E3E0F2" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,10"/>
                        <TextBlock Text="A ferramenta opera através da ponte física ADB (Android Debug Bridge) via comunicação direta Win32 em C nativo, permitindo o provisionamento completo dos aparelhos em massa sem a necessidade de conexão com a internet externa ou qualquer intervenção humana manual durante a execução das esteiras."
                                   Foreground="#A1A1AA" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>
                </Border>

                <!-- MÓDULO 2: DESTAQUE ESPECIAL DA IA ADAPTATIVA (INNOLEARN ENGINE) -->
                <Border Background="#0F1428" CornerRadius="12" Padding="24" Margin="0,0,0,18" BorderBrush="#00E5FF" BorderThickness="1.5">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧠" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Módulo 2: O Coração Tecnológico — IA Adaptativa (InnoLearn Engine)" Foreground="#00E5FF" FontSize="20" FontWeight="Black" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0A2235" CornerRadius="6" Padding="8,4,8,4" BorderBrush="#00E5FF" BorderThickness="1">
                                <TextBlock Text="RECURSO REVOLUCIONÁRIO" Foreground="#00E5FF" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="O maior diferencial da plataforma é o módulo InnoLearn IA, um motor de aprendizado heurístico escrito em C que capacita o robô a navegar por telas complexas do Android sem depender de coordenadas estáticas ou OCR pesado por pixels."
                                   Foreground="#E3E0F2" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,14"/>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <!-- Card IA 1 -->
                            <Border Background="#151D36" CornerRadius="8" Padding="15" Margin="0,0,8,10" BorderBrush="#203058" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🎯 Leitura de Centróides &amp; UI Automator XML" Foreground="#00F5D4" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Extrai a árvore de componentes da interface gráfica do tablet em tempo de execução, calculando centróides exatos (X,Y) de botões e campos através da biblioteca de acentuação universal (inno_normalize_char)." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <!-- Card IA 2 -->
                            <Border Background="#151D36" CornerRadius="8" Padding="15" Margin="8,0,0,10" BorderBrush="#203058" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📈 Algoritmo de Reinforcement &amp; Score Dinâmico" Foreground="#FFB703" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Cada seletor visual é ranqueado por um score de pontuação baseado no histórico de sucessos (Hits) e falhas (Misses). Estratégias que acertam sobem no ranking e passam a ter prioridade máxima de clique." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <!-- Card IA 3 -->
                            <Border Background="#151D36" CornerRadius="8" Padding="15" Margin="0,0,8,0" BorderBrush="#203058" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="💾 Persistência Dupla (JSON + SQLite)" Foreground="#8570E6" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Os alvos aprendidos pela IA são salvos imediatamente em disco em data/inno_learn.json e data/inno_database.db. O robô se torna mais rápido e inteligente a cada nova execução sem precisar recompilar código C." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <!-- Card IA 4 -->
                            <Border Background="#151D36" CornerRadius="8" Padding="15" Margin="8,0,0,0" BorderBrush="#203058" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🌌 Mapa Neural Sci-Fi (BrainVisualizer)" Foreground="#00E5FF" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Uma janela visualizadora holográfica em 2D que renderiza a topologia sináptica da IA em tempo real. O motor de partículas foi otimizado para rodar a 60 FPS cravados em computadores com recursos limitados." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- MÓDULO 3: ARQUITETURA EM CAMADAS E SISTEMA ANTI-CRASH -->
                <Border Background="#151525" CornerRadius="10" Padding="22" Margin="0,0,0,18" BorderBrush="#2A2A40" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚙" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Módulo 3: Arquitetura do Ecossistema e Sistema Anti-Crash Guard" Foreground="#5EB1FF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="A aplicação segue rigorosamente os padrões de engenharia em camadas:" Foreground="#E3E0F2" FontSize="14" Margin="0,0,0,10"/>
                        
                        <StackPanel Margin="10,0,0,10">
                            <TextBlock Text="• Motor Nativo em C (InnoEngine.dll): Escrito em C puro (Google C Style, Zero-Leak Policy). Toda alocação de memória é gerenciada manualmente com liberação imediata pós-execução de cada passo." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="• Interface Gráfica C# WPF (.NET 8): Desenvolvida com arquitetura MVVM limpa, suporte a múltiplos monitores, sistema de temas escuros e componentes reutilizáveis isolados em src/ui/Views/." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="• Sistema Anti-Crash Guard (C e C#):" Foreground="#4EDEA3" FontSize="13" FontWeight="Bold" Margin="0,4,0,4"/>
                            <TextBlock Text="   - Triplo Handler no C# WPF (AntiCrashGuard.cs): Captura falhas não tratadas na interface, tarefas assíncronas e AppDomain sem permitir que a janela feche sozinha." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" Margin="15,0,0,4"/>
                            <TextBlock Text="   - Filtro SEH Top-Level no C (api.c): Captura exceções brutas de memória na DLL e registra em logs/engine_crash.txt sem encerrar a aplicação pai." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" Margin="15,0,0,4"/>
                            <TextBlock Text="   - Watchdog Keep-Alive Android (adb.c): Detecta se o aplicativo fechou no tablet por falta de memória RAM e o relança automaticamente sem abortar o lote." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" Margin="15,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MÓDULO 4: ESTEIRAS E APARELHOS SUPORTADOS -->
                <Border Background="#151525" CornerRadius="10" Padding="22" Margin="0,0,0,18" BorderBrush="#2A2A40" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📱" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Módulo 4: Especificações das Esteiras por Equipamento Cadastrado" Foreground="#FFB703" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,5">
                            <Border Background="#1A1A30" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="1. Positivo Tab Vision 7 (V7 — f1_vision_tab7 a f8_vision_tab7)" Foreground="#00F5D4" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Suporta 8 pipelines dedicados: F1 (Instalação Completa), F2 (Reinstalação Limpa &amp; Offline), F3 (Atualização Expressa), F4 (Kiosk &amp; Wallpaper), F5 (Desligamento), F6 (Sincronização Direta) e F8 (Conexão Ativa Continuada)." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A1A30" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="2. Multilaser TabMulti M7 (M7 — f1_tabmulti_m7 a f4_tabmulti_m7)" Foreground="#FFB703" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Suporta 4 pipelines otimizados para aparelhos com 2GB de RAM: F1/F7 (Instalação Otimizada M7), F2 (Atualização de Pacote), F3 (Terminal Kiosk) e F4 (Desligamento), munidos dos utilitários de sanitização m7_helpers." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A1A30" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="3. Nokia T20 (T20 — f1_nokia_t20 a f3_nokia_t20)" Foreground="#00E5FF" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Suporta 3 pipelines de alta definição 2K para Android 11/12: F1 (Instalação Completa 2K), F2 (Reinstalação Limpa com Sanitização de Texto) e F3 (Atualização Expressa de Pacote 2K)." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MÓDULO 5: AUTORA E LICENÇA -->
                <Border Background="#151525" CornerRadius="10" Padding="22" Margin="0,0,0,18" BorderBrush="#2A2A40" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Width="90" Height="90" CornerRadius="45" Background="#2A2A40" Margin="0,0,22,0" BorderBrush="#513BA6" BorderThickness="2">
                            <TextBlock Text="👨‍💻" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="DESENVOLVEDOR E ARQUITETO DE SOFTWARE" Foreground="#8A8A9E" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Jordan Araujo" Foreground="#FFFFFF" FontSize="24" FontWeight="Black" Margin="0,2,0,6"/>
                            
                            <WrapPanel Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                    <TextBlock Text="✉ E-mail: " Foreground="#A1A1AA" FontSize="13"/>
                                    <TextBlock Text="contato@jordanaraujo.com" Foreground="#4EDEA3" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                    <TextBlock Text="📸 Instagram: " Foreground="#A1A1AA" FontSize="13"/>
                                    <TextBlock Text="@jordan.araujo" Foreground="#4EDEA3" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TERMOS E LICENÇA -->
                <Border Background="#2B1A20" CornerRadius="10" Padding="20" BorderBrush="#FF4B4B" BorderThickness="1.5">
                    <StackPanel>
                        <TextBlock Text="⚠ Termos de Uso e Licenciamento (Propriedade Intelectual Reservada)" Foreground="#FF4B4B" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Esta é uma ferramenta de engenharia industrial com finalidade ESTRITA de USO PESSOAL e EXCLUSIVO do desenvolvedor (Jordan Araujo)."
                                   Foreground="#E3E0F2" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <TextBlock Text="É EXPRESSAMENTE PROIBIDO o uso, cópia, distribuição, modificação, engenharia reversa, venda ou exploração comercial deste software, seus códigos-fonte ou executáveis gerados por qualquer outra pessoa ou entidade corporativa sem a autorização prévia e por escrito do desenvolvedor autor. Todos os direitos estão reservados."
                                   Foreground="#FCA5A5" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
