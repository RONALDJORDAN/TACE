<UserControl x:Class="BotRpaUI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1240"
             Background="#0B0B13"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="SideMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Margin="{TemplateBinding Margin}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222238"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D0D18"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="CategoryTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CategoryDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#85859E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#85859E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DataLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#85859E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,7,14,7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DataValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E3E0F2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TagBorder" TargetType="Border">
            <Setter Property="Background" Value="#23174A"/>
            <Setter Property="BorderBrush" Value="#513BA6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="#121220"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#85859E"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <Border Grid.Column="0" Background="#151525" CornerRadius="12" Padding="14" BorderBrush="#23233A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4,0,12">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#10101C" BorderBrush="#513BA6" BorderThickness="1" Margin="0,0,10,0">
                            <Image Source="/Assets/Icons/BotRPAui.png" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sobre &amp; Ajuda" Foreground="#FFFFFF" FontSize="16" FontWeight="Black"/>
                            <TextBlock Text="Central de conhecimento" Foreground="#8570E6" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="#23233A" Margin="0,5,0,5"/>
                    <TextBlock Text="DOCUMENTAÇÃO E GUIA" Foreground="#8570E6" FontSize="10" FontWeight="Bold" Margin="6,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="BtnSubGuia" Content="1. Visão Geral &amp; Módulos" Style="{StaticResource SideMenuButton}" Click="BtnSubGuia_Click" Foreground="#4EDEA3" Background="#2A2A40"/>
                    <Button x:Name="BtnSubFaq" Content="2. Dúvidas e FAQ" Style="{StaticResource SideMenuButton}" Click="BtnSubFaq_Click"/>
                    <Button x:Name="BtnSubArquitetura" Content="3. Arquitetura &amp; Licença" Style="{StaticResource SideMenuButton}" Click="BtnSubArquitetura_Click"/>
                </StackPanel>

                <Border Grid.Row="2" Background="#10101C" BorderBrush="#23233A" BorderThickness="1" CornerRadius="8" Padding="11" Margin="2,12,2,0">
                    <StackPanel>
                        <TextBlock Text="SISTEMA" Foreground="#8570E6" FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtSobreVersaoMenu" Text="v0.0.0" Foreground="#00E5FF" FontSize="13" FontWeight="Bold" FontFamily="Consolas" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtSobreAmbienteMenu" Text="Windows · .NET" Foreground="#85859E" FontSize="9.5" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse Width="7" Height="7" Fill="#4EDEA3" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtSobreStatusMenu" Text="Operacional" Foreground="#4EDEA3" FontSize="9.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- CONTEÚDO -->
        <Grid Grid.Column="2">
            <!-- ============================ ABA 1: VISÃO GERAL & MÓDULOS ============================ -->
            <Border x:Name="PanelGuia" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- HERO -->
                        <Border CornerRadius="12" Padding="22" Margin="0,0,0,14" BorderBrush="#3A2A72" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2A174E" Offset="0"/>
                                    <GradientStop Color="#11111C" Offset="0.62"/>
                                    <GradientStop Color="#0D0D18" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="92" Height="92" CornerRadius="18" Background="#0B0B13" BorderBrush="#513BA6" BorderThickness="1" Margin="0,0,20,0">
                                    <Image Source="/Assets/Icons/BotRPAui.png" Width="78" Height="78" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PLATAFORMA BOT_RPA" Foreground="#4EDEA3" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="Central de operações e conhecimento" Foreground="#FFFFFF" FontSize="24" FontWeight="Black" Margin="0,4,0,5"/>
                                    <TextBlock Text="Automação robótica educacional para provisionamento, auditoria e gestão de tablets em escala."
                                               Foreground="#CFC9E6" FontSize="12" TextWrapping="Wrap" MaxWidth="560"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border Style="{StaticResource TagBorder}">
                                            <TextBlock x:Name="TxtSobreVersao" Text="v0.0.0" Foreground="#D2BBFF" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                        </Border>
                                        <Border Style="{StaticResource TagBorder}" Background="#10251C" BorderBrush="#276749">
                                            <TextBlock Text="InnovEdu · Operacional" Foreground="#4EDEA3" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <Border Style="{StaticResource TagBorder}" Background="#102530" BorderBrush="#1E5A6E">
                                            <TextBlock x:Name="TxtSobreAmbiente" Text="Windows 11 · .NET 8" Foreground="#5EB1FF" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <Border Background="#0E2B20" BorderBrush="#276749" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#4EDEA3" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtSobreStatus" Text="Operacional" Foreground="#4EDEA3" FontSize="10" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtSobreAtualizado" Text="Atualizado em --/--/---- --:--" Foreground="#85859E" FontSize="9.5" Margin="0,7,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- KPIs -->
                        <UniformGrid Columns="4" Margin="0,0,-8,14">
                            <Border Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSobreDispositivos" Text="0" Style="{StaticResource KpiValue}"/>
                                    <TextBlock Text="DISPOSITIVOS" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSobrePatrimonios" Text="0" Style="{StaticResource KpiValue}" Foreground="#4EDEA3"/>
                                    <TextBlock Text="COM PATRIMÔNIO" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSobreMacs" Text="0" Style="{StaticResource KpiValue}" Foreground="#5EB1FF"/>
                                    <TextBlock Text="MAC VÁLIDO" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSobreAuditoria" Text="0" Style="{StaticResource KpiValue}" Foreground="#FFB703"/>
                                    <TextBlock Text="EVENTOS DE AUDITORIA" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- VISÃO GERAL -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Visão geral do sistema" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="O Bot_RPA integra um motor nativo de automação ADB a uma interface executiva WPF, mantendo banco local, auditoria e registros técnicos no mesmo ambiente."
                                           Style="{StaticResource MutedText}" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Empresa" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSobreEmpresa" Text="InnovEdu" Style="{StaticResource DataValue}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Setor" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtSobreSetor" Text="Operacional" Style="{StaticResource DataValue}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Versão instalada" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtSobreVersaoInstalada" Text="0.0.0" Style="{StaticResource DataValue}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Cobertura completa" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtSobreCobertura" Text="0%" Style="{StaticResource DataValue}" Foreground="#4EDEA3"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Banco de dados" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtSobreBanco" Text="data/bot_database.db" Style="{StaticResource DataValue}" FontFamily="Consolas" FontSize="10.5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Registros técnicos" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TxtSobreRegistros" Text="docs/registros" Style="{StaticResource DataValue}" FontFamily="Consolas" FontSize="10.5"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Modelos identificados" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtSobreModelos" Text="0" Style="{StaticResource DataValue}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Pendências de cadastro" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" x:Name="TxtSobrePendencias" Text="0" Style="{StaticResource DataValue}" Foreground="#FFB703"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- COBERTURA -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Qualidade da base" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Indicadores calculados em tempo real a partir do banco SQLite local." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Patrimônio" Foreground="#E3E0F2" FontSize="11" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="BarSobrePatrimonio" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#4EDEA3" Background="#1A1A2E" BorderThickness="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSobrePatrimonioPct" Grid.Column="2" Text="0%" Foreground="#85859E" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MAC válido" Foreground="#E3E0F2" FontSize="11" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="BarSobreMac" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#5EB1FF" Background="#1A1A2E" BorderThickness="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSobreMacPct" Grid.Column="2" Text="0%" Foreground="#85859E" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cadastro completo" Foreground="#E3E0F2" FontSize="11" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="BarSobreCompleto" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#FFB703" Background="#1A1A2E" BorderThickness="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSobreCompletoPct" Grid.Column="2" Text="0%" Foreground="#85859E" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- MÓDULOS -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Módulos e atalhos" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Mapa rápido das áreas disponíveis no menu superior." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>

                                <UniformGrid Columns="2" Margin="0,0,-12,0">
                                    <Border Background="#121220" CornerRadius="8" Padding="14" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="Monitor ADB (USB)" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text="Provisionamento simultâneo de tablets, telemetria de bateria, seleção de município e execução das rotinas F1–F8." Foreground="#85859E" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#121220" CornerRadius="8" Padding="14" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="Monitor Pro" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text="Interface alternativa de monitoramento, com foco em produtividade, status em tempo real e operação assistida." Foreground="#85859E" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#121220" CornerRadius="8" Padding="14" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="BotLearn / Estratégias Adaptativas" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text="Ranking heurístico de seletores, scores de confiança e feedback de execução, com mapa 3D de alvos e estratégias." Foreground="#85859E" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#121220" CornerRadius="8" Padding="14" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="Gestão / Relatórios" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text="Métricas da frota, banco de dados, auditoria, registros de build/execução, exportação CSV, PDF executivo e etiquetas QR." Foreground="#85859E" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#121220" CornerRadius="8" Padding="14" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="Configurações" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text="Ativação de modelos, interface de monitor, backups, atualizações, credenciais protegidas e preferências visuais." Foreground="#85859E" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#121220" CornerRadius="8" Padding="14" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="Sobre &amp; Ajuda" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text="Documentação, perguntas frequentes, arquitetura, licenciamento e dados operacionais consolidados." Foreground="#85859E" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- FLUXO -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Fluxo operacional" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Da conexão física à evidência auditável." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                                <UniformGrid Columns="4">
                                    <Border Background="#121220" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="01" Foreground="#8570E6" FontSize="18" FontWeight="Black"/>
                                            <TextBlock Text="Conexão USB" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Margin="0,3,0,2"/>
                                            <TextBlock Text="Autorize a depuração e aguarde o status Pronto." Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#121220" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="02" Foreground="#5EB1FF" FontSize="18" FontWeight="Black"/>
                                            <TextBlock Text="Seleção" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Margin="0,3,0,2"/>
                                            <TextBlock Text="Escolha o município e o modelo homologado." Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#121220" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="03" Foreground="#FFB703" FontSize="18" FontWeight="Black"/>
                                            <TextBlock Text="Execução" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Margin="0,3,0,2"/>
                                            <TextBlock Text="Dispare a rotina F1–F8 e acompanhe o log por dispositivo." Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#121220" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="04" Foreground="#4EDEA3" FontSize="18" FontWeight="Black"/>
                                            <TextBlock Text="Evidência" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Margin="0,3,0,2"/>
                                            <TextBlock Text="Audite a base, gere relatórios e exporte etiquetas." Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- AUDITORIA RECENTE -->
                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Atividade recente" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtSobreUltimoEvento" Text="Nenhum evento registrado." Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#121220" CornerRadius="8" Padding="12" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="REGISTROS TÉCNICOS" Foreground="#85859E" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtSobreLogs" Text="0 arquivo(s)" Foreground="#00E5FF" FontSize="13" FontWeight="Bold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================ ABA 2: FAQ ============================ -->
            <Border x:Name="PanelFaq" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Perguntas frequentes &amp; resolução de problemas" Style="{StaticResource CategoryTitle}"/>
                        <TextBlock Text="Respostas objetivas para as situações mais comuns de bancada, operação e auditoria." Style="{StaticResource CategoryDesc}"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="1. O tablet aparece como “Pendente” ou “Desconhecido”. O que fazer?" Foreground="#FFD666" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="A depuração USB ainda não foi autorizada no tablet. Marque “Sempre permitir a partir deste computador” e toque em Permitir. O status muda para Pronto automaticamente." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="2. Como interromper uma execução imediatamente?" Foreground="#FF6B6B" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="Pressione ESC ou ESPAÇO para acionar a parada de emergência global. Os subprocessos dos dispositivos conectados são cancelados." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="3. Onde ficam APKs, pacotes ZIP e arquivos dos municípios?" Foreground="#00F5D4" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="A base prioriza data/input/apps, data/input/municipios e as pastas de saída em data/output/arquivos. O vínculo também pode ser feito pela tela de gerenciamento do município." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="4. Como alternar para tela cheia?" Foreground="#5EB1FF" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="Use F11 a qualquer momento ou o botão de tela cheia no cabeçalho. O estado anterior da janela é restaurado ao sair." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="5. Onde ficam o banco e os registros?" Foreground="#4EDEA3" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="O banco SQLite fica em data/bot_database.db. Builds, execuções e auditorias ficam em docs/registros, organizados por data e modalidade." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="6. Como exportar os dados da frota?" Foreground="#D2BBFF" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="Em Gestão → Exportação de Dados, escolha base completa ou seleção. É possível gerar CSV, PDF executivo e etiquetas QR patrimoniais." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="7. Por que alguns dispositivos não têm patrimônio ou MAC válido?" Foreground="#FFB703" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="São lacunas de cadastro ou de coleta. A página de Métricas e a Auditoria da Base destacam esses casos para correção e conferência física." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="8. Como restaurar uma configuração ou base anterior?" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="Use o gerenciamento de backups em Configurações. Os arquivos .zip preservam a configuração e podem ser restaurados pela própria interface." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================ ABA 3: ARQUITETURA & LICENÇA ============================ -->
            <Border x:Name="PanelArquitetura" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Arquitetura, tecnologia e licenciamento" Style="{StaticResource CategoryTitle}"/>
                        <TextBlock Text="Detalhes técnicos de engenharia, isolamento por hardware, trilha de auditoria e propriedade intelectual." Style="{StaticResource CategoryDesc}"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Stack tecnológico" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Frontend" Style="{StaticResource DataLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="C# · WPF" Style="{StaticResource DataValue}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Interface executiva, navegação, telemetria e integração com o banco." Style="{StaticResource MutedText}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime" Style="{StaticResource DataLabel}"/>
