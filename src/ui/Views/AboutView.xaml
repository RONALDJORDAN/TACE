<UserControl x:Class="BotRpaUI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1150"
             Background="#0B0B13"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Estilo dos Botões do Menu Lateral -->
        <Style x:Key="SideMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Margin="{TemplateBinding Margin}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222238"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilos para os Cards Base -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D0D18"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Estilos para as Sections de Categoria -->
        <Style x:Key="CategoryTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CategoryDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#85859E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <!-- Layout Principal com Menu Lateral -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL COM OS SUBMÓDULOS DE AJUDA -->
        <Border Grid.Column="0" Background="#151525" CornerRadius="12" Padding="14" BorderBrush="#23233A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho do Menu -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,4,0,10">
                        <TextBlock Text="ℹ️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Sobre &amp; Ajuda" Foreground="#FFFFFF" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Separator Background="#23233A" Margin="0,5,0,5"/>
                    <TextBlock Text="DOCUMENTAÇÃO E GUIA" Foreground="#8570E6" FontSize="10" FontWeight="Bold" Margin="6,5,0,0"/>
                </StackPanel>

                <!-- Botões de Submódulos -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="BtnSubGuia" Content="🗺️  1. Guia de Módulos" Style="{StaticResource SideMenuButton}" Click="BtnSubGuia_Click" Foreground="#4EDEA3" Background="#2A2A40"/>
                    <Button x:Name="BtnSubFaq" Content="❓  2. Dúvidas e FAQ" Style="{StaticResource SideMenuButton}" Click="BtnSubFaq_Click"/>
                    <Button x:Name="BtnSubArquitetura" Content="🛡️  3. Arquitetura &amp; Licença" Style="{StaticResource SideMenuButton}" Click="BtnSubArquitetura_Click"/>
                </StackPanel>

                <!-- Rodapé informativo do Menu -->
                <Border Grid.Row="2" Background="#0A0A0F" CornerRadius="8" Padding="10" BorderBrush="#202035" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Plataforma Bot_RPA" Foreground="#4EDEA3" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtAboutVersion" Text="v18.08.2026.1724" Foreground="#85859E" FontSize="10" FontFamily="Consolas" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ÁREA DE CONTEÚDO DA CENTRAL DE AJUDA -->
        <Grid Grid.Column="2">

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 1: GUIA DE MÓDULOS -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelGuia" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🗺️ Mapa de Módulos — O que procurar e onde encontrar" Style="{StaticResource CategoryTitle}"/>
                        <TextBlock Text="Visão rápida de todas as esteiras e ferramentas disponíveis na Plataforma Bot_RPA." Style="{StaticResource CategoryDesc}"/>

                        <!-- Módulo 1: Monitor ADB USB -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#1A1A2E" CornerRadius="8" Padding="12" Margin="0,0,16,0" BorderBrush="#00F5D4" BorderThickness="1">
                                    <TextBlock Text="📱" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="1. Monitor ADB (USB)" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                        <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="Menu Superior ➔ 'Monitor ADB (USB)'" Foreground="#00F5D4" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="• O que é: O centro de comando principal para provisionamento de múltiplos tablets simultâneos via cabo USB." Foreground="#E3E0F2" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="• Principais recursos: Grade de telemetria ao vivo com medidor de bateria, botões [F1] a [F8] por modelo de tablet, seletor de municípios e log de execução por dispositivo." Foreground="#85859E" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Módulo 2: BotLearn IA -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#1A1A2E" CornerRadius="8" Padding="12" Margin="0,0,16,0" BorderBrush="#00E5FF" BorderThickness="1">
                                    <TextBlock Text="⚡" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="2. BotLearn IA (Mapeamento Visual)" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                        <Border Background="#102530" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="Menu Superior ➔ '⚡ BotLearn IA'" Foreground="#00E5FF" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="• O que é: Módulo inteligente que inspeciona a interface do tablet, capturando a tela e a árvore UI XML." Foreground="#E3E0F2" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="• Principais recursos: Detecção visual com cálculo automático de centroides de clique e exportação de fluxos JSON para a IA." Foreground="#85859E" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Módulo 3: Relatórios e Registros -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#1A1A2E" CornerRadius="8" Padding="12" Margin="0,0,16,0" BorderBrush="#4EDEA3" BorderThickness="1">
                                    <TextBlock Text="📊" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="3. Relatórios &amp; Hub de Auditoria" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                        <Border Background="#0D2E1A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="Menu Superior ➔ 'Relatórios e Registros'" Foreground="#4EDEA3" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="• O que é: Central de dados dividida em 4 submódulos: Métricas/Dashboard, Banco de Dados, Auditoria/Logs e Exportação." Foreground="#E3E0F2" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="• Principais recursos: Leitor de logs integrado, emissão de PDF A4, planilhas Excel e etiquetas térmicas patrimoniais (6cm x 3cm)." Foreground="#85859E" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Módulo 4: Configurações -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#1A1A2E" CornerRadius="8" Padding="12" Margin="0,0,16,0" BorderBrush="#8570E6" BorderThickness="1">
                                    <TextBlock Text="⚙️" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="4. Configurações Globais" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                        <Border Background="#2A174E" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="Menu Superior ➔ 'Configurações'" Foreground="#D2BBFF" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="• O que é: Painel administrativo para ativar/desativar modelos de tablets, gerenciar backups .zip e atualizar o sistema via nuvem OTA." Foreground="#E3E0F2" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 2: CENTRAL DE DÚVIDAS (FAQ) -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelFaq" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="❓ Perguntas Frequentes &amp; Resolução de Problemas (FAQ)" Style="{StaticResource CategoryTitle}"/>
                        <TextBlock Text="Respostas diretas para as situações mais comuns encontradas durante o provisionamento na bancada." Style="{StaticResource CategoryDesc}"/>

                        <!-- FAQ 1 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="🔌 1. Conectei o tablet via cabo USB, mas ele aparece como 'Pendente' ou 'Desconhecido'. O que fazer?" Foreground="#FFD666" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="• Causa: O tablet está aguardando a permissão de Depuração USB na tela." Foreground="#E3E0F2" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="• Solução: Olhe para a tela do tablet, marque a caixinha 'Sempre permitir a partir deste computador' e toque em 'Permitir'. O status no Bot_RPA mudará para 'Pronto' imediatamente." Foreground="#85859E" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 2 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="🛑 2. O processo travou ou o tablet começou a executar algo incorreto. Como interromper na hora?" Foreground="#FF6B6B" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="• Solução: Pressione a tecla ESC ou a tecla ESPAÇO no teclado. O sistema envia uma Parada de Emergência Global para todos os dispositivos conectados, cancelando os subprocessos." Foreground="#85859E" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 3 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="📁 3. Onde coloco os APKs, Pacotes ZIP e papéis de parede dos novos municípios?" Foreground="#00F5D4" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="• Local: Coloque os arquivos dentro da pasta /data/input/apps/ e vincule os nomes no arquivo /config/municipios.csv ou clique no botão '⚙ Gerenciar' na tela do Monitor ADB." Foreground="#85859E" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- FAQ 4 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="🖥️ 4. Como alternar para Tela Cheia no Bot_RPA?" Foreground="#5EB1FF" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="• Atalho: Pressione a tecla F11 a qualquer momento ou clique no botão '⛶ F11' no canto superior direito para expandir para 100% da tela." Foreground="#85859E" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 3: ARQUITETURA & LICENCIAMENTO -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelArquitetura" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🛡️ Arquitetura do Sistema &amp; Licenciamento" Style="{StaticResource CategoryTitle}"/>
                        <TextBlock Text="Detalhes técnicos de governança, isolamento de hardware e propriedade intelectual." Style="{StaticResource CategoryDesc}"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Engenharia Híbrida C + C# WPF" Foreground="#4EDEA3" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="O Bot_RPA opera com arquitetura de alta performance dividida em duas camadas:" Foreground="#E3E0F2" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Text="1. Backend Nativo (C Puro / BotEngine.dll): Responsável pelas operações I/O críticas, comunicação Fast-Track ADB, tunelamento e injeções de comandos nos tablets com latência zero." Foreground="#85859E" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="2. Frontend Executivo (C# .NET 8 WPF): Interface gráfica moderna, reativa, com renderização fluida, cockpit de telemetria e integração com banco SQLite local." Foreground="#85859E" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Isolamento Estrito por Equipamento (Regra de Ouro #1)" Foreground="#00E5FF" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Cada fabricante e modelo homologado possui seu próprio pipeline de código isolado (v7_pipeline.c para Positivo Tab Vision 7, m7_pipeline.c para Multilaser TabMulti M7, e t20_pipeline.c para Nokia T20), garantindo efeito colateral zero em atualizações." Foreground="#85859E" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Licenciamento &amp; Direitos" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Plataforma Bot_RPA © 2026. Todos os direitos reservados. Desenvolvido para automação robótica educacional de alta escala." Foreground="#85859E" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
