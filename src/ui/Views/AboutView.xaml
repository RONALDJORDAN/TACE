                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Licenciamento, autoria e propriedade intelectual" Style="{StaticResource SectionTitle}"/>
