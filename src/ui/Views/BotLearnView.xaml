<UserControl x:Class="TACEUI.Views.BotLearnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TACEUI.Views"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="1200"
             Background="#0B0B13"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <local:GroupScoreStrConverter x:Key="GroupScoreStrConv"/>
        <local:GroupScoreBrushConverter x:Key="GroupScoreBrushConv"/>
        <local:ScoreToBrushConverter x:Key="ScoreToBrushConv"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0D0D18"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B98A7"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#388BFD" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#388BFD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1158C7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A2E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#23233A"/>
                                <Setter Property="Foreground" Value="#6E7681"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#23233A" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23233A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8B98A7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141424"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#3D1418"/>
            <Setter Property="Foreground" Value="#FF7B72"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#F85149" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A1E23"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A0D10"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A2E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#23233A"/>
                                <Setter Property="Foreground" Value="#6E7681"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B98A7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#23233A" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A1A2E"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F6FEB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#388BFD"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StrategyRow" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="0,1">
                            <StackPanel>
                                <GridViewRowPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <Border x:Name="DetailsPanel" Background="#0B0B13" CornerRadius="6" Padding="12,8" Margin="0,8,0,4" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Últimas execuções registradas:" Foreground="#8B98A7" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding HistoryVisual}" Foreground="#58A6FF" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RawTargetId, StringFormat='ID técnico: {0}'}" Foreground="#6E7681" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#10101C"/>
                            </Trigger>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A2E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DetailsPanel" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A2E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1F6FEB"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B98A7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="BotLearn" Foreground="#E6EDF3" FontSize="26" FontWeight="Bold"/>
                            <Border x:Name="BadgeModo" Background="#0F2A1A" BorderBrush="#3FB950" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="12,2,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtModeBadge" Text="DETERMINÍSTICO" Foreground="#3FB950" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Motor de Estratégias Adaptativas" Foreground="#8B98A7" FontSize="13" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TxtModeDescription" Text="Usa somente o seed compilado; scores não são persistidos." Foreground="#6E7681" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnAtualizar" Content="Atualizar" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnAtualizar_Click" ToolTip="Relê o ranking e os indicadores do motor"/>
                        <Button x:Name="BtnMapeamento" Content="Mapa 3D" Style="{StaticResource SecondaryBtn}" Click="BtnMapeamento_Click" ToolTip="Abrir o mapa 3D de alvos, seletores e scores"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Indicadores -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SELETORES" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtKpiStrategies" Text="0" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock Text="estratégias carregadas" Foreground="#6E7681" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ALVOS" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtKpiTargets" Text="0" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock Text="cadastrados no motor" Foreground="#6E7681" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="EXECUÇÕES" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtKpiRuns" Text="0" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock Text="acertos e falhas registrados" Foreground="#6E7681" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="PRECISÃO" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtKpiAccuracy" Text="—" Foreground="#58A6FF" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock Text="acertos sobre execuções" Foreground="#6E7681" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="SCORE MÉDIO" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtKpiScore" Text="—" Foreground="#D29922" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock Text="média dos seletores" Foreground="#6E7681" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Diagnóstico do seletor -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Diagnóstico do Seletor" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Leitura do melhor seletor registrado para o elemento selecionado." Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Elemento:" Foreground="#8B98A7" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ComboSimulador" Width="280" Height="28" Background="#0B0B13" Foreground="#E6EDF3" BorderBrush="#23233A" FontSize="11" SelectionChanged="ComboSimulador_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#0B0B13" CornerRadius="8" Padding="14,12" BorderBrush="#23233A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock x:Name="TxtSimTargetId" Text="ALVO: nenhuma estratégia selecionada" Foreground="#58A6FF" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Rota primária:" Foreground="#8B98A7" FontSize="11" Width="92"/>
                                    <TextBlock x:Name="TxtSimPrimary" Text="Aguardando seleção..." Foreground="#C9D1D9" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Alternativa:" Foreground="#8B98A7" FontSize="11" Width="92"/>
                                    <TextBlock x:Name="TxtSimFallback1" Text="Aguardando seleção..." Foreground="#8B98A7" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#0D0D18" CornerRadius="6" BorderBrush="#23233A" BorderThickness="1" Padding="12,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="SCORE" Foreground="#8B98A7" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtSimScore" Text="—" Foreground="#D29922" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                        <TextBlock Text="PRECISÃO" Foreground="#8B98A7" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtSimPrecision" Text="—" Foreground="#58A6FF" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="REGISTROS" Foreground="#8B98A7" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtSimAttempts" Text="0 registros" Foreground="#C9D1D9" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="STATUS" Foreground="#8B98A7" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtSimStatus" Text="Sem testes" Foreground="#8B98A7" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Ranking -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Ranking Heurístico de Seletores" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Agrupado por etapa e ordenado por score. A precisão considera apenas execuções registradas." Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRankingCount" Text="0 seletores" Foreground="#8B98A7" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="Expandir" Style="{StaticResource SecondaryBtn}" Padding="9,4" FontSize="10" Margin="0,0,6,0" Click="BtnExpandAllGroups_Click" ToolTip="Expande todas as etapas"/>
                            <Button Content="Recolher" Style="{StaticResource SecondaryBtn}" Padding="9,4" FontSize="10" Click="BtnCollapseAllGroups_Click" ToolTip="Recolhe todas as etapas"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="TabAll" Content="TODOS" Style="{StaticResource FilterTab}" IsChecked="True" Click="FilterModel_Click" Tag="ALL"/>
                            <RadioButton x:Name="TabVision7" Content="POSITIVO V7" Style="{StaticResource FilterTab}" Click="FilterModel_Click" Tag="V7"/>
                            <RadioButton x:Name="TabMultiM7" Content="TABMULTI M7" Style="{StaticResource FilterTab}" Click="FilterModel_Click" Tag="M7"/>
                            <RadioButton x:Name="TabNokiaT20" Content="NOKIA T20" Style="{StaticResource FilterTab}" Click="FilterModel_Click" Tag="T20"/>
                            <RadioButton x:Name="TabGeral" Content="GERAL" Style="{StaticResource FilterTab}" Click="FilterModel_Click" Tag="F1"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#0B0B13" CornerRadius="6" BorderBrush="#23233A" BorderThickness="1" Padding="9,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchStrategy" Grid.Column="0" Background="Transparent" Foreground="#E6EDF3" BorderThickness="0"
                                         FontSize="11" VerticalAlignment="Center" TextChanged="TxtSearchStrategy_TextChanged"
                                         ToolTip="Filtrar por elemento, seletor ou categoria..."/>
                                <TextBlock x:Name="TxtSearchWatermark" Grid.Column="0" Text="Filtrar por elemento, seletor ou categoria..." Foreground="#6E7681" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1" Text="BUSCAR" Foreground="#6E7681" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListView x:Name="ListStrategies"
                                  Background="Transparent" BorderThickness="0"
                                  AlternationCount="2"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="ListStrategies_PreviewMouseWheel"
                                  ItemContainerStyle="{StaticResource StrategyRow}">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <Expander Margin="0,0,0,10" IsExpanded="True" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                                            <Expander.Header>
                                                                <Border Background="#10101C" BorderBrush="#23233A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" Foreground="#C9D1D9" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Items.Count, StringFormat=' · {0} seletores'}" Foreground="#6E7681" FontSize="10" VerticalAlignment="Center"/>
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="Score médio:" Foreground="#8B98A7" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                            <TextBlock Text="{Binding Items, Converter={StaticResource GroupScoreStrConv}}" Foreground="{Binding Items, Converter={StaticResource GroupScoreBrushConv}}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </Expander.Header>
                                                            <ItemsPresenter Margin="8,0,8,0"/>
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListView.GroupStyle>

                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ELEMENTO" Width="170" DisplayMemberBinding="{Binding ElementoId}"/>
                                    <GridViewColumn Header="SELETOR (QUERY / XPATH)" Width="270">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Query}" Foreground="#C9D1D9" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="SCORE" Width="65">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Score}" Foreground="{Binding Score, Converter={StaticResource ScoreToBrushConv}}" FontWeight="Bold"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="ACERTOS" Width="70" DisplayMemberBinding="{Binding Hits}"/>
                                    <GridViewColumn Header="FALHAS" Width="65" DisplayMemberBinding="{Binding Misses}"/>
                                    <GridViewColumn Header="PRECISÃO" Width="75" DisplayMemberBinding="{Binding Precisao}"/>
                                    <GridViewColumn Header="HISTÓRICO" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding HistoryVisual}" Foreground="#58A6FF" FontFamily="Consolas" FontSize="11"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="STATUS" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusStr}" Foreground="{Binding Score, Converter={StaticResource ScoreToBrushConv}}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock x:Name="TxtRankingEmpty" Text="Nenhuma estratégia carregada pelo motor." Foreground="#6E7681" FontSize="12" Margin="12,18,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Backups -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Backups do BotLearn" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Cópias diárias do arquivo de dados. O limite de retenção é de 3 arquivos." Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#10101C" BorderBrush="#23233A" BorderThickness="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Top">
                            <TextBlock x:Name="TxtBackupCount" Text="0 cópias" Foreground="#8B98A7" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="TxtBackupPath" Grid.Row="1" Text="Pasta de backups: —" Foreground="#6E7681" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtBackupsEmpty" Grid.Row="2" Text="Nenhum backup disponível. A rotina cria uma cópia quando o motor persiste o arquivo de dados." Foreground="#6E7681" FontSize="11" Margin="0,2,0,0"/>

                    <ItemsControl x:Name="ListBackups" Grid.Row="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0B0B13" CornerRadius="6" Padding="12,8" Margin="0,0,0,6" BorderBrush="#23233A" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Foreground="#C9D1D9" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text="{Binding DataCriacao, StringFormat='{}Criado em: {0:dd/MM/yyyy HH:mm}'}" Foreground="#6E7681" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding TamanhoStr}" Foreground="#8B98A7" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold" FontSize="11"/>
                                        <Button Grid.Column="2" Content="Restaurar" Style="{StaticResource SecondaryBtn}" Padding="10,4" FontSize="10" Tag="{Binding FullPath}" Click="BtnRestaurarBackup_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Reset -->
            <Border Grid.Row="5" Background="#0D0D18" BorderBrush="#3D1418" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Redefinir dados adaptativos" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Apaga scores, acertos, falhas e histórico persistidos. O motor retorna ao seed compilado. Disponível apenas no modo adaptativo."
                                   Foreground="#8B98A7" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Name="BtnResetDB" Grid.Column="1" Content="Redefinir dados adaptativos"
                            Style="{StaticResource DangerBtn}" VerticalAlignment="Center"
                            Margin="16,0,0,0" Click="BtnResetDB_Click"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
