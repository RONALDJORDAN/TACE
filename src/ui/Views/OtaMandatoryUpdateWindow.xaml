<Window x:Class="BotRpaUI.Views.OtaMandatoryUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualização Obrigatória do Sistema — Bot_RPA"
        Height="450" Width="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border Background="#0B0B13" CornerRadius="16" BorderBrush="#513BA6" BorderThickness="2" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#513BA6" BlurRadius="25" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Background="#513BA6" CornerRadius="6" Padding="8,4,8,4" Margin="0,0,10,0">
                        <TextBlock Text="🚀 ATUALIZAÇÃO OBRIGATÓRIA DETECTADA" Foreground="#FFFFFF" FontSize="11" FontWeight="Black"/>
                    </Border>
                    <Border Background="#064E3B" CornerRadius="6" Padding="8,4,8,4">
                        <TextBlock x:Name="TxtNewVersionBadge" Text="v18.08.2026.1724" Foreground="#00F5D4" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="Atualizando o Bot_RPA..." Foreground="#FFFFFF" FontSize="22" FontWeight="Black"/>
                <TextBlock Text="Uma nova versão do sistema foi disponibilizada na nuvem. A atualização será aplicada automaticamente para garantir segurança e estabilidade." 
                           Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Notas da Versão (Changelog) -->
            <Border Grid.Row="1" Background="#151525" CornerRadius="10" Padding="15" Margin="0,0,0,20" BorderBrush="#23233A" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="📜 NOTAS DA VERSÃO (CHANGELOG):" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtChangelog" Text="• Melhorias de desempenho e novas esteiras automáticas." Foreground="#E3E0F2" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Progresso e Ações -->
            <StackPanel Grid.Row="2">
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="TxtProgressStatus" Text="⚡ Baixando pacote de atualização do Firebase Storage..." Foreground="#4EDEA3" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtProgressPercent" Text="0%" Foreground="#00E5FF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                </Grid>

                <ProgressBar x:Name="ProgressBarUpdate" Height="10" Value="0" Maximum="100" Background="#1E1E35" Foreground="#513BA6" BorderThickness="0"/>
                
                <TextBlock Text="O aplicativo será reiniciado automaticamente assim que o download for concluído." Foreground="#8A8A9E" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
