<Window x:Class="TACEUI.Views.MunicipiosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar Municípios — TACE"
        Height="700" Width="940" MinHeight="620" MinWidth="840"
        Background="#0B0B13" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" ResizeMode="CanResize" WindowStyle="ToolWindow">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0B0B13"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#513BA6"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Foreground" Value="#8B98A7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0B0B13"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#513BA6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Background" Value="#151525"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#2A2A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#10101C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#4EDEA3"/>
            <Setter Property="Foreground" Value="#0B0B13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF8080"/>
            <Setter Property="BorderBrush" Value="#5A2630"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B0F16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MunicipioItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="7" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A2E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A40"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#513BA6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Gerenciar Municípios" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Cadastre credenciais e vincule os arquivos usados pelos fluxos de automação."
                           Foreground="#85859E" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#10251C" BorderBrush="#1F6F4A" BorderThickness="1"
                    CornerRadius="12" Padding="11,5" VerticalAlignment="Center">
                <TextBlock Text="ARMAZENAMENTO LOCAL" Foreground="#4EDEA3" FontSize="9" FontWeight="Bold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0D0D18" BorderBrush="#23233A" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Municípios cadastrados" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="#151525" BorderBrush="#23233A" BorderThickness="1"
                                CornerRadius="10" Padding="8,2">
                            <TextBlock x:Name="TxtMunicipiosCount" Text="0" Foreground="#4EDEA3" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="BUSCAR" Foreground="#8570E6" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBuscaMunicipio" Grid.Row="1" Style="{StaticResource FieldTextBox}"
                             TextChanged="TxtBuscaMunicipio_TextChanged" ToolTip="Buscar por nome ou login" Margin="0,16,0,10"/>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="ListMunicipios" Background="Transparent" BorderThickness="0"
                                 Foreground="#E6EDF3" ItemContainerStyle="{StaticResource MunicipioItem}"
                                 SelectionChanged="ListMunicipios_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NomeExibicao}" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LoginExibicao}" Foreground="#85859E" FontSize="10"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="TxtListaVazia" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock Text="Nenhum município encontrado" Foreground="#C9D1D9" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Ajuste a busca ou cadastre um novo." Foreground="#6E7681" FontSize="10"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Button Grid.Row="3" Content="+ Novo Município" Style="{StaticResource SoftButton}" Margin="0,10,0,0"
                            Click="BtnNovo_Click"/>

                    <TextBlock Grid.Row="4" Text="As pastas de arquivos usam o nome do município."
                               Foreground="#5A5A72" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#0D0D18" BorderBrush="#23233A" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="TxtFormTitulo" Text="Novo município" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtFormSubtitulo" Text="Preencha a identificação e anexe os arquivos do RPA."
                                       Foreground="#85859E" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="IDENTIFICAÇÃO" Foreground="#8570E6" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>

                            <TextBlock Text="Nome do município *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtNome" Style="{StaticResource FieldTextBox}" MaxLength="120"/>
                            <TextBlock x:Name="TxtNomeHint" Text="O nome identifica as pastas de APK, pacote e wallpaper."
                                       Foreground="#5A5A72" FontSize="9" Margin="0,4,0,10" TextWrapping="Wrap"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Login do tablet" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtLogin" Style="{StaticResource FieldTextBox}" MaxLength="100"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Senha do tablet" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="PwdSenha" Style="{StaticResource FieldPasswordBox}" MaxLength="200"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="As credenciais são gravadas no cofre local com proteção DPAPI do Windows."
                                       Foreground="#5A5A72" FontSize="9" Margin="0,5,0,12" TextWrapping="Wrap"/>

                            <TextBlock Text="ARQUIVOS VINCULADOS" Foreground="#8570E6" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>

                            <Border Background="#0B0B13" BorderBrush="#23233A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="APK do município" Foreground="#C9D1D9" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtApkStatus" Grid.Column="1" Text="Não anexado" Foreground="#6E7681"
                                               FontSize="9" FontWeight="Bold"/>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtApk" Style="{StaticResource FieldTextBox}" IsReadOnly="True" Height="30"/>
                                        <Button Grid.Column="1" Content="Detalhes" Style="{StaticResource SoftButton}" Margin="6,0,0,0"
                                                Padding="8,4" Click="BtnDetalhesApk_Click"/>
                                        <Button Grid.Column="2" Content="Procurar" Style="{StaticResource SoftButton}" Margin="6,0,0,0"
                                                Padding="8,4" Click="BtnProcurarApk_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="#0B0B13" BorderBrush="#23233A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pacote de dados (ZIP)" Foreground="#C9D1D9" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtPacoteStatus" Grid.Column="1" Text="Não anexado" Foreground="#6E7681"
                                               FontSize="9" FontWeight="Bold"/>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtPacote" Style="{StaticResource FieldTextBox}" IsReadOnly="True" Height="30"/>
                                        <Button Grid.Column="1" Content="Detalhes" Style="{StaticResource SoftButton}" Margin="6,0,0,0"
                                                Padding="8,4" Click="BtnDetalhesPacote_Click"/>
                                        <Button Grid.Column="2" Content="Procurar" Style="{StaticResource SoftButton}" Margin="6,0,0,0"
                                                Padding="8,4" Click="BtnProcurarPacote_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="#0B0B13" BorderBrush="#23233A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Imagem de wallpaper" Foreground="#C9D1D9" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtWallpaperStatus" Grid.Column="1" Text="Não anexado" Foreground="#6E7681"
                                               FontSize="9" FontWeight="Bold"/>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtWallpaper" Style="{StaticResource FieldTextBox}" IsReadOnly="True" Height="30"/>
                                        <Button Grid.Column="1" Content="Detalhes" Style="{StaticResource SoftButton}" Margin="6,0,0,0"
                                                Padding="8,4" Click="BtnDetalhesWallpaper_Click"/>
                                        <Button Grid.Column="2" Content="Procurar" Style="{StaticResource SoftButton}" Margin="6,0,0,0"
                                                Padding="8,4" Click="BtnProcurarWallpaper_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid x:Name="GridCopyProgress" Visibility="Collapsed" Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TxtCopyStatus" Text="Copiando..." Foreground="#A1A1AA" FontSize="10" Margin="0,0,0,5"/>
                                <ProgressBar x:Name="BarCopyProgress" Grid.Row="1" Height="8" Background="#0B0B13"
                                             Foreground="#4EDEA3" BorderBrush="#23233A" Minimum="0" Maximum="100" Value="0"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="TxtStatusRodape" Text="Selecione um município ou crie um novo."
                                   Foreground="#6E7681" FontSize="10" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,240,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnExcluir" Content="Excluir" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                    IsEnabled="False" Click="BtnExcluir_Click"/>
                            <Button x:Name="BtnSalvar" Content="Salvar Alterações" Style="{StaticResource AccentButton}"
                                    Click="BtnSalvar_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
