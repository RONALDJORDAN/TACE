<Window x:Class="InnovPlayUI.Views.MunicipiosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar Municípios" Height="580" Width="700"
        Background="#0B0B13" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" ResizeMode="NoResize" WindowStyle="ToolWindow">
    
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lista de Municípios -->
        <Border Grid.Column="0" Background="#151525" CornerRadius="8" Padding="10" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Municípios Cadastrados" Foreground="#D2BBFF" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox x:Name="ListMunicipios" Grid.Row="1" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" SelectionChanged="ListMunicipios_SelectionChanged"/>
                <Button Grid.Row="2" Content="+ Novo Município" Background="#0A0A0F" Foreground="#4EDEA3" BorderBrush="#4EDEA3" BorderThickness="1" Margin="0,10,0,0" Padding="5" Click="BtnNovo_Click"/>
            </Grid>
        </Border>

        <!-- Formulário -->
        <Border Grid.Column="1" Background="#151525" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock Text="Dados do Município" Foreground="#D2BBFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <TextBlock Text="Nome do Município:" Foreground="#A1A1AA" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtNome" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Login (Tablet):" Foreground="#A1A1AA" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtLogin" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Senha (Tablet):" Foreground="#A1A1AA" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtSenha" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="APK do Município:" Foreground="#A1A1AA" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtApk" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" Padding="5" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Detalhes" Background="#1A1A2E" Foreground="#A3A3C2" BorderBrush="#2A2A40" BorderThickness="1" Margin="5,0,0,0" Padding="10,0" Click="BtnDetalhesApk_Click"/>
                    <Button Grid.Column="2" Content="Procurar..." Background="#1A1A2E" Foreground="#D2BBFF" BorderBrush="#2A2A40" BorderThickness="1" Margin="5,0,0,0" Padding="10,0" Click="BtnProcurarApk_Click"/>
                </Grid>

                <TextBlock Text="Pacote de Dados (ZIP):" Foreground="#A1A1AA" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPacote" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" Padding="5" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Detalhes" Background="#1A1A2E" Foreground="#A3A3C2" BorderBrush="#2A2A40" BorderThickness="1" Margin="5,0,0,0" Padding="10,0" Click="BtnDetalhesPacote_Click"/>
                    <Button Grid.Column="2" Content="Procurar..." Background="#1A1A2E" Foreground="#D2BBFF" BorderBrush="#2A2A40" BorderThickness="1" Margin="5,0,0,0" Padding="10,0" Click="BtnProcurarPacote_Click"/>
                </Grid>

                <TextBlock Text="Imagem de Wallpaper:" Foreground="#A1A1AA" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtWallpaper" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" Padding="5" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Detalhes" Background="#1A1A2E" Foreground="#A3A3C2" BorderBrush="#2A2A40" BorderThickness="1" Margin="5,0,0,0" Padding="10,0" Click="BtnDetalhesWallpaper_Click"/>
                    <Button Grid.Column="2" Content="Procurar..." Background="#1A1A2E" Foreground="#D2BBFF" BorderBrush="#2A2A40" BorderThickness="1" Margin="5,0,0,0" Padding="10,0" Click="BtnProcurarWallpaper_Click"/>
                </Grid>

                <!-- Progresso da Cópia de Arquivos -->
                <Grid x:Name="GridCopyProgress" Visibility="Collapsed" Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtCopyStatus" Text="Copiando..." Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,5"/>
                    <ProgressBar x:Name="BarCopyProgress" Grid.Row="1" Height="10" Background="#0A0A0F" Foreground="#4EDEA3" BorderBrush="#2A2A40" Minimum="0" Maximum="100" Value="0"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🗑 Excluir" Background="#0A0A0F" Foreground="#FFB3AD" BorderBrush="#FFB3AD" BorderThickness="1" Padding="15,5" Margin="0,0,10,0" Click="BtnExcluir_Click"/>
                    <Button Content="💾 Salvar Alterações" Background="#4EDEA3" Foreground="#0B0B13" FontWeight="Bold" BorderThickness="0" Padding="15,5" Click="BtnSalvar_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
