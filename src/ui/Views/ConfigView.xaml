<UserControl x:Class="BotRpaUI.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1150" Background="#0B0B13"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Estilo Moderno para Toggle Switch -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E3E0F2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border x:Name="Track" Width="44" Height="22" CornerRadius="11" Background="#2A2A40" BorderThickness="1" BorderBrush="#404C4F" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#A1A1AA" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#513BA6"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#8570E6"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="24,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Fill" Value="#E3E0F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões do Menu Lateral -->
        <Style x:Key="SideMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Margin="{TemplateBinding Margin}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222238"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Estilos para os Cards Base -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D0D18"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#23233A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Estilos para as Sections de Categoria -->
        <Style x:Key="CategoryTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CategoryDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#85859E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <!-- Layout Principal com Menu Lateral -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL COM OS SUBMÓDULOS DE CONFIGURAÇÃO -->
        <Border Grid.Column="0" Background="#151525" CornerRadius="12" Padding="14" BorderBrush="#23233A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho do Menu -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,4,0,10">
                        <TextBlock Text="⚙️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Configurações" Foreground="#FFFFFF" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Separator Background="#23233A" Margin="0,5,0,5"/>
                    <TextBlock Text="SUBMÓDULOS DO SISTEMA" Foreground="#8570E6" FontSize="10" FontWeight="Bold" Margin="6,5,0,0"/>
                </StackPanel>

                <!-- Botões de Submódulos -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="BtnSubGeral" Content="🎛️  1. Sistema &amp; Controle" Style="{StaticResource SideMenuButton}" Click="BtnSubGeral_Click" Foreground="#4EDEA3" Background="#2A2A40"/>
                    <Button x:Name="BtnSubAparelhos" Content="📱  2. Aparelhos Suportados" Style="{StaticResource SideMenuButton}" Click="BtnSubAparelhos_Click"/>
                    <Button x:Name="BtnSubRede" Content="🌐  3. Rede &amp; Tethering" Style="{StaticResource SideMenuButton}" Click="BtnSubRede_Click"/>
                    <Button x:Name="BtnSubOta" Content="🔄  4. Atualização OTA" Style="{StaticResource SideMenuButton}" Click="BtnSubOta_Click"/>
                    <Button x:Name="BtnSubDados" Content="💾  5. Backup &amp; Gestão" Style="{StaticResource SideMenuButton}" Click="BtnSubDados_Click"/>
                    <Button x:Name="BtnSubBibliotecas" Content="📚  6. Tecnologias &amp; Licença" Style="{StaticResource SideMenuButton}" Click="BtnSubBibliotecas_Click"/>
                </StackPanel>

                <!-- Rodapé informativo do Menu -->
                <Border Grid.Row="2" Background="#0A0A0F" CornerRadius="8" Padding="10" BorderBrush="#202035" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Bot_RPA Engine: Ativo" Foreground="#4EDEA3" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="MinGW64 GCC Nativo C" Foreground="#85859E" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ÁREA DE CONTEÚDO DAS CONFIGURAÇÕES -->
        <Grid Grid.Column="2">

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 1: SISTEMA E CONTROLE GERAL -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelGeral" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Sistema &amp; Controle Geral" Style="{StaticResource CategoryTitle}"/>
                        <TextBlock Text="Ajustes críticos do motor de automação em C Puro e opções de visualização do monitor." Style="{StaticResource CategoryDesc}"/>

                        <!-- Interface Padrão do Monitor USB ADB -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Interface Principal do Monitor USB (ADB)" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Escolha a experiência de interface gráfica usada para operar e monitorar os tablets conectados na bancada." Foreground="#85859E" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1A1A2E" BorderBrush="#513BA6" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtInterfaceActiveIndicator" Text="Modo Atual: Clássico" Foreground="#00E5FF" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <!-- Grid com os Cards Interativos de Escolha -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Card Opção 1: Monitor Clássico -->
                                    <Border x:Name="CardInterfaceClassic" Grid.Column="0" Background="#18182A" BorderBrush="#00E5FF" BorderThickness="2" CornerRadius="10" Padding="14" Cursor="Hand" MouseLeftButtonDown="CardInterfaceClassic_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="📟" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Monitor Clássico (ADB)" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border x:Name="BadgeClassicActive" Margin="10,0,0,0" Background="#0A1E2B" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Visibility="Visible">
                                                    <TextBlock Text="ATIVO" Foreground="#00E5FF" FontSize="9" FontWeight="Black"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="Interface em lista tradicional para visualização sequencial de bancada com atalhos diretos e terminal interativo Kiosk." Foreground="#85859E" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card Opção 2: Monitor Pro -->
                                    <Border x:Name="CardInterfacePro" Grid.Column="2" Background="#0E0E18" BorderBrush="#23233A" BorderThickness="1" CornerRadius="10" Padding="14" Cursor="Hand" MouseLeftButtonDown="CardInterfacePro_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="⚡" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Monitor Pro (Grid)" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border x:Name="BadgeProActive" Margin="10,0,0,0" Background="#2B0A1E" BorderBrush="#FF007F" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <TextBlock Text="ATIVO" Foreground="#FF007F" FontSize="9" FontWeight="Black"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="Visualização Cyber-Industrial em cards/grid dinâmicos com telemetria visual em tempo real e cartões detalhados por aparelho." Foreground="#85859E" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Motor C -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Motor C Nativo (BotEngine.dll)" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Módulo de alta velocidade que controla a comunicação direta com os tablets via protocolo Fast-Track ADB." Foreground="#85859E" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ToggleMotor" Content="Ativo" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ToggleMotor_Checked" Unchecked="ToggleMotor_Unchecked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Motor IA: Estático vs Ativo -->
                        <Border Style="{StaticResource CardStyle}" BorderBrush="#513BA6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Motor IA BotLearn (InnoAI)" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                        <Border x:Name="BadgeAiMode" Background="#12251B" BorderBrush="#4EDEA3" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtAiMode" Text="ESTÁTICO" Foreground="#4EDEA3" FontSize="10" FontWeight="Black"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="ESTÁTICO = seed determinístico fixo, zero drift, sem persistência (recomendado produção). ATIVO = aprende scores/hits em bot_learn.json, cresce via auto-discovery (requer validação)." Foreground="#85859E" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ToggleAiLearn" Content="Ativo" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Checked="ToggleAiLearn_Checked" Unchecked="ToggleAiLearn_Unchecked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Dispositivos Desconectados -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Monitor USB ADB: Exibir Dispositivos Desconectados (Histórico)" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Quando ativado, o monitor exibe também os aparelhos desconectados com badge sutil. Quando desativado, o monitor exibe estritamente os aparelhos conectados via cabo USB no momento." Foreground="#85859E" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ToggleShowDisconnected" Content="Exibir" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" Checked="ToggleShowDisconnected_Checked" Unchecked="ToggleShowDisconnected_Unchecked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Nuvem InnovStock: Download automático -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Nuvem InnovStock: Baixar Aparelhos ao Iniciar" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Quando ativado, o sistema baixa automaticamente os dispositivos registrados na nuvem ao abrir (só adiciona/atualiza, nunca apaga o banco local)." Foreground="#85859E" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Intervalo do sync automático:" Foreground="#85859E" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="CmbCloudInterval" Width="100" SelectionChanged="CmbCloudInterval_SelectionChanged" VerticalAlignment="Center">
                                            <ComboBoxItem Content="5 min" Tag="5"/>
                                            <ComboBoxItem Content="10 min" Tag="10"/>
                                            <ComboBoxItem Content="15 min" Tag="15"/>
                                            <ComboBoxItem Content="30 min" Tag="30"/>
                                            <ComboBoxItem Content="60 min" Tag="60"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ToggleCloudPull" Content="Ativo" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ToggleCloudPull_Checked" Unchecked="ToggleCloudPull_Unchecked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Conta InnovStock: autenticação do sync de nuvem -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Conta InnovStock (sync de nuvem)" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="O banco da nuvem exige login. Informe uma conta do InnovStock com perfil operacional ou superior para enviar e baixar aparelhos. Sem conta, o sync fica desativado." Foreground="#85859E" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="E-mail:" Foreground="#E3E0F2" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtFirebaseEmail" Grid.Column="1" Height="28" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" FontSize="12" Padding="8,4" TextChanged="TxtFirebaseAccount_Changed"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Senha:" Foreground="#E3E0F2" FontSize="12" VerticalAlignment="Center"/>
                                    <PasswordBox x:Name="TxtFirebasePassword" Grid.Column="1" Height="28" Background="#0A0A0F" Foreground="#E3E0F2" BorderBrush="#2A2A40" FontSize="12" Padding="8,4" PasswordChanged="TxtFirebaseAccount_Changed"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnTestarFirebase" Content="🔌 Testar conexão" Padding="14,6" Cursor="Hand" Click="BtnTestarFirebase_Click" Background="#0E7490" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" BorderThickness="0"/>
                                    <TextBlock x:Name="TxtFirebaseStatus" Text="Não configurado." Foreground="#85859E" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 2: APARELHOS SUPORTADOS -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelAparelhos" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Base Oficial de Hardware Suportado" Style="{StaticResource CategoryTitle}"/>
                        <TextBlock Text="Ative ou desative modelos de tablets. Quando a chave estiver desligada, os aparelhos desse modelo não aparecerão no monitor USB ADB e seus menus inferiores ficarão ocultos." Style="{StaticResource CategoryDesc}"/>

                        <!-- Modelo 1: Positivo Tab Vision 7 -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#1A1A2E" CornerRadius="8" Padding="12" Margin="0,0,16,0" BorderBrush="#00F5D4" BorderThickness="1">
                                    <TextBlock Text="📱" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Positivo Tab Vision 7 (T307G)" Foreground="#00F5D4" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Módulos Suportados: [F1], [F2], [F3], [F4], [F5], [F6], [F8]" Foreground="#E3E0F2" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text="Engine: C Nativo (v7_pipeline.c) | Chipset: Allwinner A133" Foreground="#85859E" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" x:Name="ToggleDeviceVision7" Content="Monitorar" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ToggleDevice_Changed" Unchecked="ToggleDevice_Changed" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Modelo 2: Multilaser TabMulti M7 -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#1A1A2E" CornerRadius="8" Padding="12" Margin="0,0,16,0" BorderBrush="#FFB703" BorderThickness="1">
                                    <TextBlock Text="📱" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Multilaser TabMulti M7 (m7_MULTI)" Foreground="#FFB703" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Módulos Suportados: [F1], [F2], [F3], [F4], [F5]" Foreground="#E3E0F2" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text="Engine: C Nativo (m7_pipeline.c) | Suporte Multi-Launcher" Foreground="#85859E" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" x:Name="ToggleDeviceTabMulti" Content="Monitorar" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ToggleDevice_Changed" Unchecked="ToggleDevice_Changed" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Modelo 3: Nokia T20 (Android 11) -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#1A1A2E" CornerRadius="8" Padding="12" Margin="0,0,16,0" BorderBrush="#D2BBFF" BorderThickness="1">
                                    <TextBlock Text="📱" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Nokia T20 (Android 11)" Foreground="#D2BBFF" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Módulos Suportados: [F1], [F2], [F3] (Pipeline Especial Android 11)" Foreground="#E3E0F2" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text="Engine: C Nativo (t20_pipeline.c) | Compatibilidade com Scoped Storage" Foreground="#85859E" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" x:Name="ToggleDeviceNokiaT20" Content="Monitorar" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ToggleDevice_Changed" Unchecked="ToggleDevice_Changed" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 3: REDE & CONECTIVIDADE -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelRede" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Rede &amp; Conectividade (Reverse Tethering)" Style="{StaticResource CategoryTitle}"/>
                        <TextBlock Text="Configurações de roteamento de pacotes TCP/IP via cabo USB com Gnirehtet." Style="{StaticResource CategoryDesc}"/>

                        <!-- Reverse Tethering -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Reverse Tethering Automático (Gnirehtet)" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Injeta a conexão cabeada do computador diretamente no tablet, contornando bloqueios de Wi-Fi nas escolas." Foreground="#85859E" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ToggleTethering" Content="Automático" Style="{StaticResource ToggleSwitchStyle}" Checked="ToggleTethering_Checked" Unchecked="ToggleTethering_Unchecked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Teste de Velocidade -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Diagnóstico de Estabilidade de Conexão" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Executa um ping de diagnóstico e latência avaliando a conexão (Escala de 1 a 10)." Foreground="#85859E" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnTesteVelocidade" Content="🚀 Iniciar Teste" Background="#2A2A40" Foreground="#5EB1FF" BorderThickness="1" BorderBrush="#5EB1FF" Padding="16,8" Cursor="Hand" FontWeight="Bold" FontSize="13" Click="BtnTesteVelocidade_Click" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Indicador de Pontos -->
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Qualidade da Conexão: " Foreground="#85859E" FontSize="12"/>
                                        <TextBlock x:Name="TxtResultadoTeste" Text="Aguardando teste..." Foreground="#4EDEA3" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    <ItemsControl x:Name="SpeedScoreItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="26" Height="8" CornerRadius="4" Margin="0,0,6,0" Background="{Binding Color}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 4: ATUALIZAÇÕES OTA -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelOta" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Atualização do Sistema (OTA Remote)" Style="{StaticResource CategoryTitle}"/>
                        <TextBlock Text="Verifique a disponibilidade de novos patches de compilação ou atualizações na nuvem." Style="{StaticResource CategoryDesc}"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Versão do Sistema em Execução" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock x:Name="TxtCurrentVersion" Text="v1.0.0" Foreground="#4EDEA3" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                                            <TextBlock x:Name="TxtStatusOta" Text=" (Conectado à nuvem)" Foreground="#85859E" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnCheckOta" Content="🔍 Verificar Atualizações" Background="#2A2A40" Foreground="#5EB1FF" BorderThickness="1" BorderBrush="#5EB1FF" Padding="15,8" Cursor="Hand" FontWeight="Bold" FontSize="12" Click="BtnCheckOta_Click" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Card de Atualização Disponível -->
                                <Border x:Name="BorderUpdateAvailable" Visibility="Collapsed" Background="#1A1A2E" BorderBrush="#513BA6" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,10,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="🚀 Nova Versão Disponível: " Foreground="#00E5FF" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtNewVersion" Text="v1.1.0" Foreground="#00E5FF" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                                            <TextBlock x:Name="TxtOtaMandatory" Text="" Foreground="#FFB020" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtChangelog" Text="Melhorias de desempenho e estabilidade..." Foreground="#E3E0F2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <Button x:Name="BtnInstallOta" Content="⚡ Instalar Atualização Agora" Background="#513BA6" Foreground="#FFFFFF" BorderThickness="0" Padding="18,8" Cursor="Hand" FontWeight="Bold" FontSize="13" Click="BtnInstallOta_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Progresso do Download OTA -->
                                <Border x:Name="PanelOtaProgress" Visibility="Collapsed" Background="#0A0A0F" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtOtaProgressStatus" Text="Baixando atualização..." Foreground="#00E5FF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="OtaProgressBar" Height="8" Background="#151525" Foreground="#00E5FF" BorderThickness="0" Value="0" Maximum="100"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Telemetria Automática -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Telemetria Automática de Versão" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Reporta periodicamente ao servidor a versão desta máquina para inventário no painel corporativo." Foreground="#85859E" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ToggleTelemetry" Content="Ativo" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ToggleTelemetry_Checked" Unchecked="ToggleTelemetry_Unchecked" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 5: BACKUP & GESTÃO DE DADOS -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelDados" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Gestão &amp; Backup de Dados" Style="{StaticResource CategoryTitle}"/>
                        <TextBlock Text="Proteja e restaure a base de dados SQLite, configurações e arquivos de pacotes em um arquivo .zip." Style="{StaticResource CategoryDesc}"/>

                        <!-- Exportar Backup -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Exportar Pacote (Backup Completo)" Foreground="#4EDEA3" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Comprime todo o ambiente (bot_database.db, configurações e logs) em um único arquivo .zip." Foreground="#85859E" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnExportar" Content="⬇ Exportar" Background="#2A2A40" Foreground="#4EDEA3" BorderThickness="1" BorderBrush="#4EDEA3" Padding="18,8" Cursor="Hand" FontWeight="Bold" FontSize="13" Click="BtnExportar_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Importar Backup -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Importar Pacote de Backup (.zip)" Foreground="#D2BBFF" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Restaura a base de dados local a partir de um backup anterior." Foreground="#85859E" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnImportar" Content="⬆ Importar" Background="#513BA6" Foreground="#FFFFFF" BorderThickness="0" Padding="18,8" Cursor="Hand" FontWeight="Bold" FontSize="13" Click="BtnImportar_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Progresso -->
                        <Border x:Name="PanelProgresso" Visibility="Collapsed" Background="#0A0A0F" CornerRadius="8" Padding="15" BorderThickness="1" BorderBrush="#513BA6">
                            <StackPanel>
                                <TextBlock x:Name="TxtStatusProgresso" Text="Processando backup..." Foreground="#4EDEA3" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                <ProgressBar x:Name="BarraProgresso" Height="8" Background="#151525" Foreground="#4EDEA3" BorderThickness="0" Value="0" Maximum="100"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================================= -->
            <!-- SUBMÓDULO 6: TECNOLOGIAS & LICENÇAS -->
            <!-- ========================================================================= -->
            <Border x:Name="PanelBibliotecas" Background="#151525" CornerRadius="12" Padding="20" BorderBrush="#23233A" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Tecnologias &amp; Bibliotecas Open-Source" Style="{StaticResource CategoryTitle}"/>
                        <TextBlock Text="Componentes nativos e bibliotecas de alta performance integradas à Plataforma Bot_RPA." Style="{StaticResource CategoryDesc}"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#1A1A2E" CornerRadius="6" Padding="8" Margin="0,0,12,0" BorderBrush="#8570E6" BorderThickness="1">
                                        <TextBlock Text="📦" FontSize="18"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="QRCoder (v1.8.0)" Foreground="#5EB1FF" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Framework Nativo C# (GDI+ / System.Drawing)" Foreground="#85859E" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Utilizado no módulo de Relatórios para geração das Etiquetas Térmicas Patrimoniais (6cm x 3cm) com QR Code em alta definição, processado 100% offline em memória RAM." Foreground="#E3E0F2" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#1A1A2E" CornerRadius="6" Padding="8" Margin="0,0,12,0" BorderBrush="#00F5D4" BorderThickness="1">
                                        <TextBlock Text="⚡" FontSize="18"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="MinGW-w64 GCC Compiler" Foreground="#00F5D4" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Compilação Nativa em C Puro (Win64 Fast-Track)" Foreground="#85859E" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Compilador C embarcado utilizado para compilar a BotEngine.dll com zero dependências externas e execução em tempo real na bancada de automação." Foreground="#E3E0F2" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
