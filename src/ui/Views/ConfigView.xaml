<UserControl x:Class="InnovPlayUI.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100" Background="#0B0B13">

    <UserControl.Resources>
        <!-- Estilo Moderno para Toggle Switch -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E3E0F2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border x:Name="Track" Width="44" Height="22" CornerRadius="11" Background="#2A2A40" BorderThickness="1" BorderBrush="#404C4F" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#A1A1AA" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#513BA6"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#513BA6"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="24,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Fill" Value="#E3E0F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões Laterais Premium -->
        <Style x:Key="SideMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A2E"/>
                                <Setter Property="Foreground" Value="#E3E0F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Estilos para os Cards Base -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#151525"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#2A2A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="4" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilos para as Sections de Categoria -->
        <Style x:Key="CategoryTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E3E0F2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="CategoryDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A9E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#151525" CornerRadius="10" Padding="12" Margin="0,0,15,0" BorderThickness="1" BorderBrush="#2A2A40">
                <TextBlock Text="⚙️" FontSize="26" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Configurações Avançadas" Foreground="#E3E0F2" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Gerencie preferências, rede e backups corporativos do Inno RPA" Foreground="#A1A1AA" FontSize="14" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Layout Duas Colunas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu Lateral (Submódulos) -->
            <Border Grid.Column="0" Background="#151525" CornerRadius="16" Padding="15" BorderThickness="1" BorderBrush="#2A2A40" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="MÓDULOS GLOBAIS" Foreground="#513BA6" FontSize="12" FontWeight="Bold" Margin="10,5,0,15"/>
                    <Button x:Name="BtnSubGeral" Content="🎛️  Sistema e Controle Geral" Style="{StaticResource SideMenuButton}" Click="BtnSubGeral_Click" Foreground="#4EDEA3" Background="#2A2A40"/>
                    <Button x:Name="BtnSubRede" Content="🌐  Rede e Conectividade" Style="{StaticResource SideMenuButton}" Click="BtnSubRede_Click"/>
                    <Button x:Name="BtnSubAparelhos" Content="📱  Aparelhos Suportados" Style="{StaticResource SideMenuButton}" Click="BtnSubAparelhos_Click"/>
                    <Button x:Name="BtnSubLogs" Content="📜  Logs e Auditoria" Style="{StaticResource SideMenuButton}" Click="BtnSubLogs_Click"/>
                    
                    <TextBlock Text="DADOS E SISTEMA" Foreground="#513BA6" FontSize="12" FontWeight="Bold" Margin="10,25,0,15"/>
                    <Button x:Name="BtnSubOta" Content="🔄  Atualização OTA" Style="{StaticResource SideMenuButton}" Click="BtnSubOta_Click"/>
                    <Button x:Name="BtnSubDados" Content="💾  Gestão e Backup" Style="{StaticResource SideMenuButton}" Click="BtnSubDados_Click"/>
                    <Button x:Name="BtnSubBibliotecas" Content="📚  Tecnologias &amp; Bibliotecas" Style="{StaticResource SideMenuButton}" Click="BtnSubBibliotecas_Click"/>
                </StackPanel>
            </Border>

            <!-- Área de Conteúdo -->
            <Grid Grid.Column="2">
                <!-- Painel 1: Sistema e Controle Geral -->
                <StackPanel x:Name="PanelGeral" Visibility="Visible">
                    <TextBlock Text="Sistema e Controle" Style="{StaticResource CategoryTitle}"/>
                    <TextBlock Text="Ajustes críticos do motor de automação C e injeções DllImport." Style="{StaticResource CategoryDesc}"/>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Motor C (InnoEngine)" Foreground="#E3E0F2" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Módulo nativo que controla ADB Fast-Track. Desativar fará o sistema usar fallback em Python." Foreground="#A1A1AA" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleMotor" Content="Ativo" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ToggleMotor_Checked" Unchecked="ToggleMotor_Unchecked" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Painel 2: Rede e Conectividade -->
                <StackPanel x:Name="PanelRede" Visibility="Collapsed">
                    <TextBlock Text="Rede e Conectividade" Style="{StaticResource CategoryTitle}"/>
                    <TextBlock Text="Configurações de roteamento de pacotes e tunelamento TCP/IP via cabo USB." Style="{StaticResource CategoryDesc}"/>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Reverse Tethering Automático" Foreground="#E3E0F2" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Injeta a internet local da sua máquina diretamente no tablet sem depender do Wi-Fi escolar." Foreground="#A1A1AA" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleTethering" Content="Automático" Style="{StaticResource ToggleSwitchStyle}" Checked="ToggleTethering_Checked" Unchecked="ToggleTethering_Unchecked" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Teste de Velocidade de Internet" Foreground="#E3E0F2" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Avalia a estabilidade e latência da sua conexão (Escala de 1 a 10)." Foreground="#A1A1AA" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnTesteVelocidade" Content="🚀 Iniciar Teste" Background="#2A2A40" Foreground="#5EB1FF" BorderThickness="1" BorderBrush="#5EB1FF" Padding="20,8" Cursor="Hand" FontWeight="Bold" FontSize="14" Click="BtnTesteVelocidade_Click" VerticalAlignment="Center">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                            
                            <!-- Indicador de Qualidade (1 a 10) -->
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Qualidade da Conexão: " Foreground="#8A8A9E" FontSize="13"/>
                                    <TextBlock x:Name="TxtResultadoTeste" Text="Aguardando teste..." Foreground="#A1A1AA" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <ItemsControl x:Name="SpeedScoreItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="30" Height="10" CornerRadius="5" Margin="0,0,8,0" Background="{Binding Color}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Painel 3: Aparelhos Suportados -->
                <StackPanel x:Name="PanelAparelhos" Visibility="Collapsed">
                    <TextBlock Text="Base Oficial de Hardware" Style="{StaticResource CategoryTitle}"/>
                    <TextBlock Text="Modelos de tablets homologados com lógicas customizadas mapeadas pelo motor C." Style="{StaticResource CategoryDesc}"/>

                    <Border Style="{StaticResource CardStyle}" Padding="0" Background="Transparent" BorderThickness="0" Effect="{x:Null}">
                        <Border Background="#151525" BorderBrush="#2A2A40" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Background="#1A1A2E" CornerRadius="8" Padding="15" Margin="0,0,20,0">
                                    <TextBlock Text="📱" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Positivo Tab Vision 7" Foreground="#4EDEA3" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Módulos Suportados: F1, F2, F3, F4, F5" Foreground="#A1A1AA" FontSize="13" Margin="0,5,0,0"/>
                                    <TextBlock Text="Engine: C++ Nativo | UI Automator: Completo" Foreground="#8A8A9E" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                                
                                <Border Grid.Column="2" Background="#0A0A0F" BorderBrush="#513BA6" BorderThickness="1" CornerRadius="20" Padding="15,5" VerticalAlignment="Center">
                                    <TextBlock Text="Ativo" Foreground="#513BA6" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Novo Modelo m7_MULTI -->
                    <Border Style="{StaticResource CardStyle}" Padding="0" Background="Transparent" BorderThickness="0" Effect="{x:Null}">
                        <Border Background="#151525" BorderBrush="#2A2A40" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Background="#1A1A2E" CornerRadius="8" Padding="15" Margin="0,0,20,0">
                                    <TextBlock Text="📱" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Multilaser M7 (m7_MULTI)" Foreground="#4EDEA3" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Módulos Suportados: F7, F2, F3, F5" Foreground="#A1A1AA" FontSize="13" Margin="0,5,0,0"/>
                                    <TextBlock Text="Engine: C++ Nativo | UI Automator: Completo" Foreground="#8A8A9E" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                                
                                <Border Grid.Column="2" Background="#0A0A0F" BorderBrush="#513BA6" BorderThickness="1" CornerRadius="20" Padding="15,5" VerticalAlignment="Center">
                                    <TextBlock Text="Ativo" Foreground="#513BA6" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- Painel 4: Logs e Auditoria -->
                <StackPanel x:Name="PanelLogs" Visibility="Collapsed">
                    <TextBlock Text="Auditoria e Logs" Style="{StaticResource CategoryTitle}"/>
                    <TextBlock Text="Rastreabilidade e governança de processos automáticos." Style="{StaticResource CategoryDesc}"/>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Gravação de Logs (C e C#)" Foreground="#E3E0F2" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="O sistema grava logs nativos da DLL (.c) no diretório /logs/ e históricos de compilação ou execução de tarefas pesadas no diretório /registros/ separados por data e hora exata." Foreground="#A1A1AA" FontSize="13" Margin="0,5,0,20" TextWrapping="Wrap"/>
                            
                            <Border Background="#0A0A0F" BorderBrush="#2A2A40" BorderThickness="1" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="📄 logs/app_errors.log" Foreground="#5EB1FF" FontSize="13" FontFamily="Consolas" Margin="0,0,0,5"/>
                                    <TextBlock Text="📄 registros/YYYY-MM-DD/HH-MM_EXECUTION.log" Foreground="#5EB1FF" FontSize="13" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Painel OTA: Atualização Remota e Telemetria -->
                <StackPanel x:Name="PanelOta" Visibility="Collapsed">
                    <TextBlock Text="Atualização do Sistema (OTA Remote)" Style="{StaticResource CategoryTitle}"/>
                    <TextBlock Text="Verifique e aplique atualizações remotas via nuvem (Firebase)." Style="{StaticResource CategoryDesc}"/>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Versão Instalada do Software" Foreground="#E3E0F2" FontSize="16" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock x:Name="TxtCurrentVersion" Text="v1.0.0" Foreground="#4EDEA3" FontSize="15" FontWeight="Bold" FontFamily="Consolas"/>
                                        <TextBlock x:Name="TxtStatusOta" Text=" (Conectado à nuvem)" Foreground="#8A8A9E" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnCheckOta" Content="🔍 Verificar Atualizações" Background="#2A2A40" Foreground="#5EB1FF" BorderThickness="1" BorderBrush="#5EB1FF" Padding="15,8" Cursor="Hand" FontWeight="Bold" FontSize="13" Click="BtnCheckOta_Click" VerticalAlignment="Center">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Card de Atualização Disponível -->
                            <Border x:Name="BorderUpdateAvailable" Visibility="Collapsed" Background="#1A1A2E" BorderBrush="#513BA6" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,10,0,15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="🚀 Nova Versão Disponível: " Foreground="#00E5FF" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtNewVersion" Text="v1.1.0" Foreground="#00E5FF" FontSize="15" FontWeight="Bold" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtChangelog" Text="Melhorias de desempenho e estabilidade..." Foreground="#E3E0F2" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                    
                                    <Button x:Name="BtnInstallOta" Content="⚡ Instalar Atualização Agora" Background="#513BA6" Foreground="#FFFFFF" BorderThickness="0" Padding="20,10" Cursor="Hand" FontWeight="Bold" FontSize="14" Click="BtnInstallOta_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Progresso do Download OTA -->
                            <Border x:Name="PanelOtaProgress" Visibility="Collapsed" Background="#0A0A0F" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOtaProgressStatus" Text="Baixando atualização..." Foreground="#00E5FF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="OtaProgressBar" Height="10" Background="#151525" Foreground="#00E5FF" BorderThickness="0" Value="0" Maximum="100">
                                        <ProgressBar.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </ProgressBar.Resources>
                                    </ProgressBar>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Telemetria Automática Toggle -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Telemetria Remota de Versão" Foreground="#E3E0F2" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Reporta periodicamente ao Firebase a versão e status desta máquina para inventário no Painel Web." Foreground="#A1A1AA" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ToggleTelemetry" Content="Ativo" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="ToggleTelemetry_Checked" Unchecked="ToggleTelemetry_Unchecked" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Painel 5: Gestão de Dados -->
                <StackPanel x:Name="PanelDados" Visibility="Collapsed">
                    <TextBlock Text="Gestão e Backup de Dados" Style="{StaticResource CategoryTitle}"/>
                    <TextBlock Text="Proteja os dados estruturados do sistema, incluindo relatórios, configurações e dicionários." Style="{StaticResource CategoryDesc}"/>

                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Exportar Pacote (Backup Completo)" Foreground="#4EDEA3" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Comprime todo o ambiente (logs, registros, imagens e tabelas XML) em um único arquivo .zip portátil." Foreground="#A1A1AA" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" x:Name="BtnExportar" Content="⬇ Exportar" Background="#2A2A40" Foreground="#4EDEA3" BorderThickness="1" BorderBrush="#4EDEA3" Padding="20,10" Cursor="Hand" FontWeight="Bold" FontSize="14" Click="BtnExportar_Click" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Importar Pacote (.zip)" Foreground="#513BA6" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Sobrescreve a base local de dados com um backup anterior. Recomenda-se cautela." Foreground="#A1A1AA" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" x:Name="BtnImportar" Content="⬆ Importar" Background="#513BA6" Foreground="#FFFFFF" BorderThickness="0" Padding="20,10" Cursor="Hand" FontWeight="Bold" FontSize="14" Click="BtnImportar_Click" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Progresso da Operação -->
                    <Border x:Name="PanelProgresso" Visibility="Collapsed" Background="#1A1A2E" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#513BA6">
                        <StackPanel>
                            <TextBlock x:Name="TxtStatusProgresso" Text="Aguarde, processando..." Foreground="#4EDEA3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <ProgressBar x:Name="BarraProgresso" Height="12" Background="#0A0A0F" Foreground="#4EDEA3" BorderThickness="0" Value="0" Maximum="100">
                                <ProgressBar.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </ProgressBar.Resources>
                            </ProgressBar>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Painel 6: Tecnologias e Bibliotecas -->
                <StackPanel x:Name="PanelBibliotecas" Visibility="Collapsed">
                    <TextBlock Text="Tecnologias Open-Source" Style="{StaticResource CategoryTitle}"/>
                    <TextBlock Text="Bibliotecas injetadas e frameworks parceiros utilizados pela Plataforma." Style="{StaticResource CategoryDesc}"/>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Background="#1A1A2E" CornerRadius="8" Padding="10" Margin="0,0,15,0">
                                    <TextBlock Text="📦" FontSize="20"/>
