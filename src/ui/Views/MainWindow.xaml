<Window x:Class="InnovPlayUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InnoBot - Robotic Process Automation" Height="760" Width="1240"
        Background="#0B0B13" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" WindowStyle="SingleBorderWindow" WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="pack://application:,,,/Assets/Icons/InnoRPAui.ico">
    
    <Window.Resources>
        <!-- Estilo de Botão de Navegação com Efeito Pílula e Hover Suave Escuro -->
        <Style x:Key="NavTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A3A3C2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6,12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#23233A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A2E"/>
                                <Setter Property="Foreground" Value="#4EDEA3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra Superior de Módulos (Menu de Comando Cyber-Industrial) -->
        <Border Grid.Row="0" Background="#141424" CornerRadius="10" Padding="12,8" Margin="0,0,0,12" BorderBrush="#252540" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Identidade Visual InnovTech (Esquerda) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#513BA6" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#513BA6" BlurRadius="12" Opacity="0.65" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="⚡" FontSize="18" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="INNOTECH RPA" Foreground="#FFFFFF" FontWeight="Black" FontSize="13"/>
                        <TextBlock Text="Robotic Process Automation" Foreground="#8570E6" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Rectangle Width="1" Height="24" Fill="#2A2A42" Margin="14,0,4,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 2. Módulos de Navegação Central -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMenuMonitor" Content="📟 Monitor ADB" Style="{StaticResource NavTabButtonStyle}" Click="MenuMonitor_Click"/>
                    <Button x:Name="BtnMenuMonitorPro" Content="⚡ Monitor Pro" Style="{StaticResource NavTabButtonStyle}" Click="MenuMonitorPro_Click"/>
                    <Button x:Name="BtnMenuLearn" Content="🧠 InnoAI 2.0" Style="{StaticResource NavTabButtonStyle}" Click="MenuLearn_Click"/>
                    <Button x:Name="BtnMenuRelatorios" Content="📊 Relatórios" Style="{StaticResource NavTabButtonStyle}" Click="MenuRelatorios_Click"/>
                    <Button x:Name="BtnMenuConfig" Content="⚙ Configurações" Style="{StaticResource NavTabButtonStyle}" Click="MenuConfig_Click"/>
                    <Button x:Name="BtnMenuSobre" Content="ℹ Sobre" Style="{StaticResource NavTabButtonStyle}" Click="MenuSobre_Click"/>
                </StackPanel>

                <!-- 3. Telemetria e Status ao Vivo (Direita) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Badge ADB Online -->
                    <Border Background="#10251C" BorderBrush="#276749" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#4EDEA3" Margin="0,0,6,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#4EDEA3" BlurRadius="6" Opacity="0.8" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="ADB ATIVO" Foreground="#4EDEA3" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Badge Tablets USB Conectados -->
                    <Border Background="#16182E" BorderBrush="#3B4272" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📱" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHeaderDeviceCount" Text="0 Tablets" Foreground="#00E5FF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Pílula Atalho ESC -->
                    <Border Background="#1C1824" BorderBrush="#483D61" BorderThickness="1" CornerRadius="6" Padding="7,4" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Pressione ESC para pausar ou duplo ESC para cancelar automações ativas">
                        <TextBlock Text="[ESC] Pausa" Foreground="#D2BBFF" FontSize="10" FontWeight="Bold"/>
                    </Border>

                    <!-- Botão Tela Cheia -->
                    <Button x:Name="BtnToggleFullScreen" Content="⛶ F11" Style="{StaticResource NavTabButtonStyle}" Padding="9,4" Margin="0,0,8,0" Click="BtnToggleFullScreen_Click" ToolTip="Alternar Tela Cheia (F11)"/>

                    <!-- Versão Oficial -->
                    <Border Background="#1A1A2E" BorderBrush="#513BA6" BorderThickness="1" CornerRadius="6" Padding="9,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="v" Foreground="#8570E6" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtHeaderVersion" Text="18.08.2026.1703" Foreground="#00E5FF" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Container de Conteúdo Dinâmico -->
        <ContentControl x:Name="MainContent" Grid.Row="1" />
    </Grid>
</Window>
