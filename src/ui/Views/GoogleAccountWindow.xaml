<Window x:Class="TACEUI.Views.GoogleAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar Conta Google" Height="510" Width="560"
        Background="#0B0B13" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" ResizeMode="NoResize" WindowStyle="ToolWindow"
        ShowInTaskbar="False" Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#101828" CornerRadius="10" Padding="14,12" BorderBrush="#4285F4" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="8" Background="#16233A" BorderBrush="#4285F4" BorderThickness="1.5" Margin="0,0,12,0">
                    <TextBlock Text="G" Foreground="#8AB4F8" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ADICIONAR CONTA GOOGLE" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="Subfuncao do F4 - Gestao do Aparelho" Foreground="#8AB4F8" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#141126" CornerRadius="8" Padding="12,10" BorderBrush="#2C2C48" BorderThickness="1" Margin="0,0,0,14">
            <TextBlock Foreground="#C9C4E8" FontSize="11" TextWrapping="Wrap"
                       Text="O TACE abre Configuracoes &gt; Adicionar conta, preenche o e-mail e a senha e aguarda a confirmacao do Google. Mantenha o tablet desbloqueado. Se o Google pedir verificacao em duas etapas, conclua no tablet: o processo aguarda ate 3 minutos. A senha nao sera salva."/>
        </Border>

        <TextBlock Grid.Row="2" Text="E-mail da conta Google" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" x:Name="TxtEmail" Height="34" MaxLength="200" Background="#0A0A0F" Foreground="#F4F4FF" BorderBrush="#2A2A40" BorderThickness="1" Padding="9,6" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="4" Text="Senha" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <PasswordBox Grid.Row="5" x:Name="TxtSenha" Height="34" MaxLength="200" Background="#0A0A0F" Foreground="#F4F4FF" BorderBrush="#2A2A40" BorderThickness="1" Padding="9,6" FontSize="13" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="6" x:Name="TxtErro" Visibility="Collapsed" Foreground="#FF8080" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <Border Grid.Row="7" Background="#1A1510" CornerRadius="8" Padding="12,10" BorderBrush="#7A5A20" BorderThickness="1" Margin="0,14,0,14" VerticalAlignment="Bottom">
            <TextBlock Foreground="#FFE699" FontSize="10" TextWrapping="Wrap"
                       Text="Atencao: em lote, o Google pode exigir verificacao extra em cada tablet. Use uma conta institucional autorizada e mantenha a internet ativa."/>
        </Border>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="100" Height="34" Margin="0,0,10,0" IsCancel="True" Click="BtnCancel_Click" Background="#17172A" Foreground="#C9C4E8" BorderBrush="#2A2A40" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Adicionar conta" Width="150" Height="34" IsDefault="True" Click="BtnConfirm_Click" Background="#16233A" Foreground="#8AB4F8" BorderBrush="#4285F4" BorderThickness="1.5" Cursor="Hand" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
