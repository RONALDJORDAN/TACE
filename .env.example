# =============================================================================
# Bot_RPA - Variáveis de Ambiente (copie para .env e preencha)
# NÃO commite o arquivo .env - ele contém segredos
# =============================================================================

# --- Conta Google (usada para automação de contas nos tablets) ---
# Preferencial: usar variáveis de ambiente em vez de settings.json em texto plano
BOTRPA_GOOGLE_EMAIL=seu_email@dominio.com.br
BOTRPA_GOOGLE_PASSWORD=sua_senha_aqui

# --- Assinatura de código (SignTool) ---
# Obrigatório para build de release com assinatura digital
BOTRPA_SIGN_CERT=C:\caminho\para\seu_certificado.pfx
BOTRPA_SIGN_PASSWORD=senha_do_certificado

# --- Atualização automática (OTA) ---
# URL do manifesto de versão remota (JSON)
BOTRPA_AUTO_UPDATE_URL=https://seu-servidor.com/ota/manifest.json

# --- Firebase / InnovStock (opcional, se usar sincronização na nuvem) ---
BOTRPA_FIREBASE_API_KEY=sua_api_key_firebase
BOTRPA_FIREBASE_PROJECT_ID=seu_projeto_id

# --- Caminho customizado do GCC (se não usar o padrão do WinGet) ---
# BOTRPA_GCC_PATH=C:\caminho\para\mingw64\bin
