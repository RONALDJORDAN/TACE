# ==========================================================================
# Bot_RPA — .gitignore
# Configurado para rastrear todos os arquivos do projeto, ferramentas (Gnirehtet,
# ADB, etc.), configurações, bancos, dados e recursos, ignorando apenas arquivos
# temporários de compilação/IDE e binários que excedem o limite de 100MB do GitHub.
# ==========================================================================

# 1. Limite de tamanho de arquivo do GitHub (bloqueia push > 100MB)
data/output/BotRPAui.exe

# 2. Arquivos temporários e intermediários de compilação (.NET)
src/ui/obj/
[Oo]bj/
*.wpftmp.csproj
*.csproj.user

# 3. Cache e arquivos temporários de IDE / Editor
.vs/
.idea/
*.suo
*.user
*.userosscache

# 4. Arquivos temporários do Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
