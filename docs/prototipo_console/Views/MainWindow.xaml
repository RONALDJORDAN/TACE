<Window x:Class="PrototipoConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bot_RPA · Bancada"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid x:Name="RootLayout" Background="{StaticResource Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="4" Background="{StaticResource Brush.Accent}">
                        <TextBlock Text="BR"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#14100B"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Bot_RPA"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="14" Background="{StaticResource Brush.Border}" Margin="12,0"/>
                    <TextBlock Text="Bancada"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Produção" FontSize="10" Foreground="{StaticResource Brush.TextTertiary}"/>
                    <TextBlock Text="/" FontSize="10" Foreground="{StaticResource Brush.TextTertiary}" Margin="7,0"/>
                    <TextBlock Text="Bancada 03" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                        <TextBlock Text="ADB conectado"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Width="1" Height="14" Background="{StaticResource Brush.Border}" Margin="14,0"/>
                    <TextBlock Text="4 dispositivos"
                               FontSize="10"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="14" Background="{StaticResource Brush.Border}" Margin="14,0"/>
                    <TextBlock Text="v21.10.2026"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="10"
                               Foreground="{StaticResource Brush.TextTertiary}"
                               VerticalAlignment="Center"/>
                    <Border Width="24" Height="24" CornerRadius="12"
                            Background="{StaticResource Brush.SurfaceRaised}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            Margin="14,0,0,0">
                        <TextBlock Text="OP"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="0,16,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Operação"
                               Style="{StaticResource Caption}"
                               Margin="20,0,0,6"/>

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavBench"
                                     GroupName="MainNav"
                                     Style="{StaticResource NavItem}"
                                     Tag="Bancada"
                                     IsChecked="True"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                <TextBlock Text="Bancada" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource NavItem}"
                                     Tag="Lote"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA37;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                <TextBlock Text="Lote" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource NavItem}"
                                     Tag="Dispositivos"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE772;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                <TextBlock Text="Dispositivos" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource NavItem}"
                                     Tag="Registros"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                <TextBlock Text="Registros" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                        <TextBlock Text="Sistema"
                                   Style="{StaticResource Caption}"
                                   Margin="20,0,0,6"/>
                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource NavItem}"
                                     Tag="Configurações"
                                     Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                <TextBlock Text="Configurações" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <Border Background="{StaticResource Brush.SurfaceRaised}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10"
                                Margin="12,12,12,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bancada 03" FontSize="11" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ativa" FontSize="9" Foreground="{StaticResource Brush.TextSecondary}" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Operador · admin"
                                           FontSize="10"
                                           Foreground="{StaticResource Brush.TextTertiary}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="PageBench" Margin="20,16,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Bancada" Style="{StaticResource DisplayTitle}"/>
                            <TextBlock Text="Operação dos tablets conectados por USB."
                                       Style="{StaticResource Muted}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Height="32"
                                    Width="240"
                                    Background="{StaticResource Brush.SurfaceRaised}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;"
                                               Style="{StaticResource Icon}"
                                               FontSize="12"
                                               Margin="0,0,7,0"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="TxtSearch"
                                                 Style="{StaticResource SearchBox}"
                                                 Text=""
                                                 TextChanged="TxtSearch_TextChanged"/>
                                        <TextBlock Text="Serial ou patrimônio"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Brush.TextTertiary}"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE72C;"
                                    ToolTip="Atualizar dispositivos"
                                    Margin="8,0,0,0"
                                    Click="BtnRefresh_Click"/>

                            <Button Style="{StaticResource PrimaryButton}"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="8,0,0,0"
                                    Click="BtnNewSession_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;"
                                               FontFamily="{StaticResource Font.Icons}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Nova sessão"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SessionName}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SessionLocation}"
                                           FontSize="10"
                                           Foreground="{StaticResource Brush.TextTertiary}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <Grid Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Progresso do lote"
                                               FontSize="10"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SessionProgressLabel}"
                                               FontFamily="{StaticResource Font.Mono}"
                                               FontSize="10"
                                               Foreground="{StaticResource Brush.TextTertiary}"/>
                                </Grid>
                                <ProgressBar Grid.Row="1"
                                             Style="{StaticResource ThinProgress}"
                                             Value="{Binding SessionProgress, Mode=OneWay}"
                                             Margin="0,6,0,0"/>
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="{Binding ConnectedLabel}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="conectados"
                                               FontSize="9"
                                               Foreground="{StaticResource Brush.TextTertiary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Width="1" Height="22" Background="{StaticResource Brush.Border}" Margin="0,0,18,0"/>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="{Binding RunningLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}"/>
                                    <TextBlock Text="em execução"
                                               FontSize="9"
                                               Foreground="{StaticResource Brush.TextTertiary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Width="1" Height="22" Background="{StaticResource Brush.Border}" Margin="0,0,18,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding QueuedLabel}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="aguardando"
                                               FontSize="9"
                                               Foreground="{StaticResource Brush.TextTertiary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="272"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Dispositivos" Style="{StaticResource PanelTitle}"/>
                                            <Border Style="{StaticResource StatusChip}" Margin="8,0,0,0" Padding="5,1">
                                                <TextBlock Text="4"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource Brush.TextSecondary}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource IconButton}"
                                                Content="&#xE71C;"
                                                Width="26"
                                                Height="26"
                                                ToolTip="Filtrar lista"/>
                                    </Grid>
                                </Border>

                                <ListBox x:Name="DeviceList"
                                         Grid.Row="1"
                                         Style="{StaticResource FlatListBox}"
                                         ItemsSource="{Binding DevicesView}"
                                         SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="66">
                                                <Border x:Name="RowBg"
                                                        Background="Transparent"
                                                        CornerRadius="4"
                                                        Margin="6,2"/>
                                                <Border x:Name="RowRail"
                                                        Width="2"
                                                        Background="Transparent"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,10,0,10"/>
                                                <Grid Margin="14,8,10,8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Model}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource StatusChip}"
                                                                Background="{Binding StatusBackground}"
                                                                BorderBrush="{Binding StatusBorder}"
                                                                Padding="5,2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Status}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{Binding StatusBrush}"
                                                                           Margin="5,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Serial}" Style="{StaticResource MonoSmall}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding StepLabel}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource Brush.TextTertiary}"
                                                                   Margin="8,0,0,0"/>
                                                    </Grid>

                                                    <ProgressBar Grid.Row="2"
                                                                 Height="2"
                                                                 Margin="0,6,0,0"
                                                                 Style="{StaticResource ThinProgress}"
                                                                 Value="{Binding Progress}"
                                                                 Foreground="{Binding ProgressBrush}"
                                                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}"/>
                                                </Grid>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Brush.Selection}"/>
                                                    <Setter TargetName="RowRail" Property="Background" Value="{StaticResource Brush.Accent}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="2"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="0,1,0,0"
                                        Padding="14,10">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Fila da bancada"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="1 · TabMulti M7 · F1"
                                                       FontSize="10"
                                                       Foreground="{StaticResource Brush.TextTertiary}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Content="Ver"
                                                Style="{StaticResource GhostButton}"
                                                FontSize="10"
                                                Padding="8,3"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SelectedDevice.Model}"
                                                           FontFamily="{StaticResource Font.Display}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource StatusChip}"
                                                        Background="{Binding SelectedDevice.StatusBackground}"
                                                        BorderBrush="{Binding SelectedDevice.StatusBorder}"
                                                        Margin="10,0,0,0"
                                                        Padding="6,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="5" Height="5" Fill="{Binding SelectedDevice.StatusBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SelectedDevice.Status}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding SelectedDevice.StatusBrush}"
                                                                   Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding SelectedDevice.Serial}" Style="{StaticResource MonoSmall}"/>
                                                <TextBlock Text="MAC"
                                                           FontSize="9"
                                                           Foreground="{StaticResource Brush.TextTertiary}"
                                                           Margin="14,0,5,0"/>
                                                <TextBlock Text="{Binding SelectedDevice.Mac}" Style="{StaticResource MonoSmall}" Foreground="{StaticResource Brush.TextTertiary}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Padding="10,6"
                                                    Click="BtnPause_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SelectedDevice.PauseGlyph}"
                                                               FontFamily="{StaticResource Font.Icons}"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SelectedDevice.PauseButtonText}"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Content="Cancelar"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="10,6"
                                                    Margin="8,0,0,0"
                                                    Click="BtnCancel_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="{StaticResource Brush.SurfaceRaised}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="0,1,0,1"
                                        Padding="16,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SelectedDevice.Pipeline}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <StackPanel Margin="0,0,18,0">
                                                    <TextBlock Text="Decorrido"
                                                               FontSize="9"
                                                               Foreground="{StaticResource Brush.TextTertiary}"/>
                                                    <TextBlock Text="{Binding SelectedDevice.Elapsed}"
                                                               FontFamily="{StaticResource Font.Mono}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Restante"
                                                               FontSize="9"
                                                               Foreground="{StaticResource Brush.TextTertiary}"/>
                                                    <TextBlock Text="{Binding SelectedDevice.Eta}"
                                                               FontFamily="{StaticResource Font.Mono}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Height="6"
                                                         Style="{StaticResource ThinProgress}"
                                                         Value="{Binding SelectedDevice.Progress}"
                                                         Foreground="{Binding SelectedDevice.ProgressBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SelectedDevice.Progress, StringFormat={}{0:0}%}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource Brush.TextSecondary}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding SelectedDevice.CurrentStep}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Brush.TextTertiary}"
                                                   Margin="0,7,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Margin="16,12,16,4">
                                        <TextBlock Text="Etapas" Style="{StaticResource PanelTitle}"/>
                                        <TextBlock Text="9 etapas"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Brush.TextTertiary}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <ListBox Grid.Row="1"
                                             Style="{StaticResource FlatListBox}"
                                             ItemsSource="{Binding SelectedDevice.Steps}"
                                             Margin="8,0,8,6">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="29">
                                                    <Border x:Name="RowBg" Background="Transparent" CornerRadius="4" Margin="0,1"/>
                                                    <Grid Margin="10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Grid.Column="0">
                                                            <Border x:Name="Connector"
                                                                    Width="1"
                                                                    Background="{StaticResource Brush.Border}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Stretch"
                                                                    Margin="0,13,0,0"/>
                                                            <Ellipse x:Name="Dot"
                                                                     Width="12"
                                                                     Height="12"
                                                                     Stroke="{StaticResource Brush.BorderStrong}"
                                                                     StrokeThickness="1"
                                                                     Fill="{StaticResource Brush.Console}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                                            <Path x:Name="Check"
                                                                  Data="M 1,5 L 4,8 L 10,1"
                                                                  Stroke="{StaticResource Brush.Success}"
                                                                  StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Visibility="Collapsed"/>
                                                            <Path x:Name="Cross"
                                                                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                                                  Stroke="{StaticResource Brush.Danger}"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Visibility="Collapsed"/>
                                                            <Ellipse x:Name="CurrentRing"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Stroke="{StaticResource Brush.Accent}"
                                                                     StrokeThickness="1"
                                                                     Fill="Transparent"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="Collapsed"/>
                                                            <Ellipse x:Name="CurrentDot"
                                                                     Width="5"
                                                                     Height="5"
                                                                     Fill="{StaticResource Brush.Accent}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="Collapsed"/>
                                                        </Grid>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Number}"
                                                                   Style="{StaticResource MonoSmall}"
                                                                   Foreground="{StaticResource Brush.TextTertiary}"/>
                                                        <TextBlock x:Name="StepName"
                                                                   Grid.Column="2"
                                                                   Text="{Binding Name}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="StepDuration"
                                                                   Grid.Column="3"
                                                                   Text="{Binding Duration}"
                                                                   Style="{StaticResource MonoSmall}"
                                                                   Foreground="{StaticResource Brush.TextTertiary}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                        <Setter TargetName="Connector" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                                        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="StepName" Property="Foreground" Value="{StaticResource Brush.Text}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Current">
                                                        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="CurrentRing" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="CurrentDot" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Brush.Selection}"/>
                                                        <Setter TargetName="StepName" Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                        <Setter TargetName="StepName" Property="FontWeight" Value="SemiBold"/>
                                                        <Setter TargetName="StepDuration" Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="Cross" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="StepName" Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                                        <Setter TargetName="StepDuration" Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <Border Grid.Row="3"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="0,1,0,0"
                                        Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Próxima ação" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding SelectedDevice.NextAction}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Brush.TextSecondary}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Repetir etapa"
                                                    Padding="10,5"
                                                    Margin="0,0,8,0"
                                                    Click="BtnRetry_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDevice.Status}" Value="Falha">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Terminal"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="10,5"
                                                    Click="BtnTerminal_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Margin="14,12,14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Atividade" Style="{StaticResource PanelTitle}"/>
                                            <Ellipse Width="5" Height="5" Fill="{StaticResource Brush.Success}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ao vivo"
                                                       FontSize="9"
                                                       Foreground="{StaticResource Brush.TextTertiary}"
                                                       Margin="5,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource IconButton}"
                                                Content="&#xE71C;"
                                                Width="26"
                                                Height="26"
                                                HorizontalAlignment="Right"
                                                ToolTip="Filtrar atividade"/>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6,0,6,4">
                                        <RadioButton GroupName="LogTabs"
                                                     Style="{StaticResource TabButton}"
                                                     Content="Execução"
                                                     Tag="Execução"
                                                     IsChecked="True"
                                                     Checked="LogTab_Checked"/>
                                        <RadioButton GroupName="LogTabs"
                                                     Style="{StaticResource TabButton}"
                                                     Content="Sistema"
                                                     Tag="Sistema"
                                                     Checked="LogTab_Checked"/>
                                    </StackPanel>

                                    <ListBox Grid.Row="2"
                                             Style="{StaticResource FlatListBox}"
                                             Background="{StaticResource Brush.Console}"
                                             ItemsSource="{Binding LogsView}"
                                             Margin="0,0,0,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="1"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Margin="14,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Time}"
                                                                   Style="{StaticResource MonoSmall}"
                                                                   Foreground="{StaticResource Brush.TextTertiary}"
                                                                   VerticalAlignment="Top"/>
                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource StatusChip}"
                                                                Background="{Binding LevelBackground}"
                                                                BorderBrush="{Binding LevelBorder}"
                                                                Padding="4,1"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Level}"
                                                                       FontFamily="{StaticResource Font.Mono}"
                                                                       FontSize="8"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding LevelBrush}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Message}"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="6,0,0,0"/>
                                                    </Grid>
                                                    <Border Grid.Row="1" Background="{StaticResource Brush.Border}" Margin="14,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Grid.Row="3"
                                            BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="0,1,0,0"
                                            Padding="10,6">
                                        <Grid>
                                            <Button Content="Exportar"
                                                    Style="{StaticResource GhostButton}"
                                                    FontSize="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"/>
                                            <Button Content="Limpar"
                                                    Style="{StaticResource GhostButton}"
                                                    FontSize="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Recursos" Style="{StaticResource PanelTitle}"/>
                                        <TextBlock Text="São Paulo"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Brush.TextTertiary}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Rectangle Style="{StaticResource Divider}" Margin="0,9,0,8"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="APK" FontSize="9" Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="innovava-4.8.2.apk" Style="{StaticResource MonoSmall}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="OK" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pacote" FontSize="9" Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="SP-2026-10.zip" Style="{StaticResource MonoSmall}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="OK" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Wallpaper" FontSize="9" Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="sp-centro.jpg" Style="{StaticResource MonoSmall}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="OK" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Border x:Name="PagePlaceholder"
                        Background="{StaticResource Brush.Background}"
                        Visibility="Collapsed">
                    <Grid Margin="20,16">
                        <Border Width="420"
                                Style="{StaticResource Card}"
                                Padding="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="TxtPlaceholderIcon"
                                           Text="&#xEA37;"
                                           Style="{StaticResource Icon}"
                                           FontSize="28"
                                           Foreground="{StaticResource Brush.Accent}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPlaceholderTitle"
                                           Text="Lote"
                                           Style="{StaticResource DisplayTitle}"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,6"/>
                                <TextBlock x:Name="TxtPlaceholderBody"
                                           Text="Este módulo ainda não faz parte do protótipo de bancada."
                                           Style="{StaticResource Muted}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <Button Content="Voltar para Bancada"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Center"
                                        Margin="0,20,0,0"
                                        Click="BtnBackToBench_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                    <TextBlock Text="ADB conectado"
                               FontSize="10"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               Margin="6,0,0,0"/>
                    <Border Width="1" Height="12" Background="{StaticResource Brush.Border}" Margin="12,0"/>
                    <TextBlock Text="4 dispositivos"
                               FontSize="10"
                               Foreground="{StaticResource Brush.TextTertiary}"/>
                    <Border Width="1" Height="12" Background="{StaticResource Brush.Border}" Margin="12,0"/>
                    <TextBlock Text="Última varredura 10:39:12"
                               FontSize="10"
                               Foreground="{StaticResource Brush.TextTertiary}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Fila: 1 pendente · TabMulti M7"
                           FontSize="10"
                           Foreground="{StaticResource Brush.TextTertiary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ESC pausa"
                               FontSize="10"
                               Foreground="{StaticResource Brush.TextTertiary}"/>
                    <TextBlock Text="Shift+ESC cancela"
                               FontSize="10"
                               Foreground="{StaticResource Brush.TextTertiary}"
                               Margin="12,0,0,0"/>
                    <Border Width="1" Height="12" Background="{StaticResource Brush.Border}" Margin="12,0"/>
                    <TextBlock Text="Protótipo"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="9"
                               Foreground="{StaticResource Brush.TextTertiary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
